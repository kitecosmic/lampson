{
  "name": "lampson",
  "version": "0.5.0",
  "description": "A coding agent written in Synsema: terminal + web, tools confined to the mounted project, plugins (your own tools, any language), LSP, MCP, sub-agents. Also an SDK: import { Lampson } from \"lampson\" (server or local mode).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitecosmic/lampson.git"
  },
  "homepage": "https://github.com/kitecosmic/lampson#readme",
  "bugs": "https://github.com/kitecosmic/lampson/issues",
  "keywords": [
    "agent",
    "coding-agent",
    "synsema",
    "llm",
    "cli",
    "lsp",
    "mcp"
  ],
  "bin": {
    "lampson": "bin/lampson.js"
  },
  "files": [
    "bin/",
    "sdk/index.js",
    "sdk/index.mjs",
    "sdk/index.d.ts",
    "lib/",
    "public/",
    "skills/",
    "plugins/",
    "chat.syn",
    "run.syn",
    "web.syn",
    "hub.tpl.syn",
    "edge.syn",
    "cli.syn",
    "lampson.ps1",
    "lampson.sh",
    "lampson.cmd",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "synsema": "^0.6.42"
  },
  "scripts": {
    "test": "pwsh -NoProfile -File tests/run.ps1"
  },
  "main": "sdk/index.js",
  "types": "sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./sdk/index.d.ts",
      "import": "./sdk/index.mjs",
      "require": "./sdk/index.js"
    },
    "./package.json": "./package.json"
  }
}
