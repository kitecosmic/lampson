-- run.syn — Lampson sin interfaz: un mensaje entra, el agente trabaja, la respuesta sale (spec/engine.md, fase 1)
--
--   lampson run "resumí los cambios de hoy"                     -- texto final por stdout
--   echo "hola" | lampson run --agent soporte --thread whatsapp:+54911… --json
--
-- Corre como chat.syn: cwd = .lampson/ws/<slug> con la junction `workspace` (los launchers lo preparan).
-- Entrada por entorno (los launchers la arman desde los flags):
--   LAMPSON_MESSAGE          el mensaje; vacío → se lee stdin hasta EOF
--   LAMPSON_AGENT            el agente (integrado o workspace/.lampson/agents/<id>.agent.json); default build
--   LAMPSON_THREAD           identidad externa de la conversación (cliente, canal, tarea): misma → misma sesión
--   LAMPSON_SESSION          o el id de una sesión ya existente
--   LAMPSON_RUN_JSON=1       eventos JSONL por stdout (uno por línea) y al final {"kind":"done",…}
--   LAMPSON_RUN_PERMISSION   ask|strict|yolo; vacío → el del agente, y si no dice → strict
-- Sin humano delante: lo que pida aprobación se DENIEGA (no hay ask_fn); el modelo lo ve y lo informa.
-- Código de salida: 0 ok · 1 el turno terminó en error · 2 uso inválido (agente inexistente, mensaje vacío).

intent: "Headless Lampson: deliver one message to an agent and print its answer (or the event stream as JSONL)"

require net
require time
require stdin
require exec
require random
require env("LAMPSON_*")
require env("OS")
require secret("LAMPSON_*")
require judge
require file("workspace")
require file("workspace/*")
require file.read("skills")
require file.read("skills/*")
require file.read("plugins")
require file.read("plugins/*")
require file("memory")
require file("memory/*")
require file(".lampson")
require file(".lampson/*")

use "./lib/runtime.syn" as runtime
use "./lib/agents.syn" as agents
use "./lib/mcp.syn" as mcp
use "./lib/apikeys.syn" as apikeys
use "./lib/mcp_server.syn" as mcp_server
use "./lib/approvals.syn" as approvals
use "./lib/plugins.syn" as plugins
use "./lib/channels.syn" as channels

-- `lampson key add|list|remove`: API keys de la API /v1 de este workspace (lib/apikeys.syn, lib/api.syn)
--   LAMPSON_KEY_CMD=add [LAMPSON_KEY_NAME] [LAMPSON_KEY_AGENTS=tienda,soporte]   · list · remove LAMPSON_KEY_ID
let key_cmd be env("LAMPSON_KEY_CMD", "")
when key_cmd != ""
    let ws_path be "/w/" + env("LAMPSON_WS", "<slug>") + "/v1"
    -- la URL pública de este lampson (--domain, túnel o LAMPSON_PUBLIC_URL), si hay: la que se pega en otra app o agente
    let pub be approvals.public_url()
    let api_base be when pub != "" then pub + ws_path otherwise "http://127.0.0.1:8080" + ws_path
    when key_cmd == "add"
        let ag be where(apply((x) => lower(trim(x)), split(env("LAMPSON_KEY_AGENTS", ""), ",")), (x) => x != "")
        each a in ag
            when a != "*" and not contains(runtime.names(), a)
                print("lampson key: no agent named '" + a + "' · available: " + join(runtime.names(), ", "))
                exit(2)
        let k be apikeys.create(env("LAMPSON_KEY_NAME", ""), ag)
        print("API key creada (" + k["id"] + ") para " + (when contains(k["agents"], "*") then "todos los agentes" otherwise join(k["agents"], ", ")) + ". Guardala ahora: no se vuelve a mostrar.")
        print("")
        print("  " + k["key"])
        print("")
        print("  API (apps, bots):     " + api_base + "/messages")
        print("  MCP (otros agentes):  " + api_base + "/mcp      con el header Authorization: Bearer <la key>")
        when pub == ""
            print("  (solo desde esta PC: para usarla desde afuera, `lampson --domain …` o un túnel; ver lampson.org/docs/phone)")
        print("")
        print("  curl -X POST " + api_base + "/messages -H \"Authorization: Bearer " + k["key"] + "\" -H \"Content-Type: application/json\" -d '{\"to\": \"" + (when contains(k["agents"], "*") then runtime.default_agent() otherwise k["agents"][0]) + "\", \"thread\": \"cliente-1\", \"text\": \"hola\"}'")
    otherwise when key_cmd == "list"
        let ks be apikeys.list()
        when length(ks) == 0
            print("sin API keys en este workspace (lampson key add [--agent ID] [--name NOMBRE])")
        each k in ks
            print("  " + k["id"] + "  " + (when k["name"] == "" then "(sin nombre)" otherwise k["name"]) + "  agentes: " + join(k["agents"], ", ") + "  creada " + k["created"] + "  último uso " + (when k["last_used"] == nothing then "nunca" otherwise text(k["last_used"])))
        print("  API: " + api_base + "/messages · MCP: " + api_base + "/mcp")
    otherwise when key_cmd == "remove"
        let kid be env("LAMPSON_KEY_ID", "")
        when apikeys.remove(kid)
            print("API key " + kid + " revocada")
        otherwise
            print("lampson key: no existe la key '" + kid + "' (lampson key list)")
            exit(2)
    otherwise
        print("uso: lampson key add [--agent ID[,ID]] [--name NOMBRE] · lampson key list · lampson key remove <id>")
        exit(2)
    exit(0)

-- `lampson channel list|on|off|setup [canal]`: los canales (plugins con "channel", lib/channels.syn)
let ch_cmd be env("LAMPSON_CHANNEL_CMD", "")
when ch_cmd != ""
    let ch_name be lower(env("LAMPSON_CHANNEL_NAME", ""))
    let pub_ch be approvals.public_url()
    let slug be env("LAMPSON_WS", "")
    task hook_url(n)
        give (when pub_ch != "" then pub_ch otherwise "http://127.0.0.1:8080") + "/w/" + (when slug == "" then "local" otherwise slug) + "/ch/" + n
    let chs be where(plugins.all(), (l) => l["channel"] != nothing)
    when ch_cmd == "list"
        when length(chs) == 0
            print("no hay canales instalados (un canal es un plugin con \"channel\" en su plugin.json)")
        each l in chs
            let ag be when l["error"] == nothing then channels.agent_for(l["name"], l, {}) otherwise "?"
            print("  " + (when l["enabled"] then "● " otherwise "○ ") + l["name"] + "  " + (when l["error"] != nothing then "roto: " + text(l["error"]) otherwise "agente: " + ag + "  webhook: " + hook_url(l["name"])))
        when pub_ch == ""
            print("  (sin URL pública: las plataformas no llegan a esta PC. `lampson --domain …` o un túnel; ver lampson.org/docs/phone)")
        exit(0)
    let found be where(chs, (l) => l["name"] == ch_name)
    when length(found) == 0
        print("lampson channel: no hay un canal '" + ch_name + "' · instalados: " + join(apply((l) => l["name"], chs), ", "))
        exit(2)
    let l be found[0]
    when ch_cmd == "on" or ch_cmd == "off"
        plugins.set_enabled(ch_name, ch_cmd == "on")
        print("canal " + ch_name + (when ch_cmd == "on" then " encendido · webhook: " + hook_url(ch_name) otherwise " apagado"))
        exit(0)
    when ch_cmd == "setup"
        when not l["enabled"]
            print("lampson channel: el canal " + ch_name + " está apagado — `lampson channel on " + ch_name + "` primero")
            exit(2)
        when pub_ch == ""
            print("lampson channel: hace falta una URL pública (https) para que " + ch_name + " llegue a este Lampson: `lampson --domain …`, un túnel, o LAMPSON_PUBLIC_URL en .env")
            exit(2)
        let out be text(plugins.invoke(l, "setup", {"webhook_url": hook_url(ch_name)}))
        when contains(out, "unknown action 'setup'")
            print("el canal " + ch_name + " se configura desde la plataforma: pegá esta URL como webhook → " + hook_url(ch_name))
            exit(0)
        print(trim(out))
        exit(when starts_with(trim(out), "ERROR") then 1 otherwise 0)
    print("uso: lampson channel list · channel on|off <canal> · channel setup <canal>")
    exit(2)

-- `lampson mcp serve`: Lampson como servidor MCP por stdio (lib/mcp_server.syn); stdout queda SOLO para JSON-RPC
when env("LAMPSON_MCP_SERVE", "") == "1"
    let offered be mcp_server.offered()
    when length(offered) == 0
        print(json_encode({"jsonrpc": "2.0", "id": nothing, "error": {"code": -32603, "message": "no agents match LAMPSON_MCP_AGENTS"}}))
        exit(2)
    share {"id": text(now())} as "lampson:run"
    share {"kind": "mcp"} as "lampson:ui"
    -- servers MCP propios de Lampson solo si algún agente ofrecido puede usarlos
    let uses_mcp be false
    each n in offered
        let ts be runtime.get(n)["tools"]
        when contains(ts, "mcp") or length(where(ts, (t) => starts_with(t, "mcp_"))) > 0
            set uses_mcp to true
    when uses_mcp
        mcp.start_all(8)
    mcp_server.serve()
    exit(0)

-- Subagente en background: `agent Child` (lib/agents.syn) solo llama tasks TOP-LEVEL del programa de entrada
task lampson_subagent(spec_json)
    give agents.run_child_json(spec_json)

-- `lampson run --stdio`: MODO LOCAL (lo usa el SDK). Un proceso abierto, un pedido JSON por línea en stdin:
--   {"id": "r1", "op": "ask", "to"?, "thread"?, "session"?, "text", "images"?, "meta"?, "mode"?: "strict"|"yolo"}
--   {"id": "r2", "op": "agents"}  ·  {"id": "r3", "op": "ping"}
-- y por stdout, una línea JSON por evento con ese id: los mismos que `--json` (session, assistant, tool_call…) y
-- {"id", "kind": "done", "data": {agent, thread, session, text, steps, usage, stopped}} al terminar cada ask. Al
-- arrancar, {"kind": "ready", "data": {"agents": […], "protocol": 1}}. Los pedidos se atienden en orden, de a uno.
-- Sin humano: lo que pida aprobación se deniega; "mode" lo puede fijar quien llama (es su programa, en su máquina).
let cur_id be ""
let cur_agent be ""
let cur_thread be ""
task stdio_out(m)
    print(json_encode(m))
    flush()
task stdio_event(kind, data, tag)
    when kind != "busy" and kind != "idle"
        stdio_out({"id": cur_id, "kind": kind, "data": data, "tag": tag, "agent": cur_agent, "thread": cur_thread})
task stdio_start(info)
    set cur_thread to info["thread"]
    stdio_out({"id": cur_id, "kind": "session", "data": info, "tag": "", "agent": info["agent"], "thread": info["thread"]})
task stdio_fail(msg)
    stdio_out({"id": cur_id, "kind": "done", "data": {"agent": cur_agent, "thread": cur_thread, "session": "", "text": "", "steps": 0, "usage": {"input": 0, "output": 0, "cached": 0}, "stopped": "error: " + msg}, "tag": "", "agent": cur_agent, "thread": cur_thread})

when env("LAMPSON_RUN_STDIO", "") == "1"
    share {"id": text(now())} as "lampson:run"
    share {"kind": "sdk"} as "lampson:ui"
    let all_names be runtime.names()
    let any_mcp be false
    each n in all_names
        let ts be runtime.get(n)["tools"]
        when contains(ts, "mcp") or length(where(ts, (t) => starts_with(t, "mcp_"))) > 0
            set any_mcp to true
    when any_mcp
        mcp.start_all(8)
    stdio_out({"kind": "ready", "data": {"agents": all_names, "protocol": 1}})
    let line be read_line("")
    while line != nothing
        when trim(line) != ""
            let req be nothing
            try
                set req to json_decode(line)
            recover err
                set req to nothing
            when req == nothing or type_of(req) != "map"
                set cur_id to ""
                stdio_out({"id": "", "kind": "error", "data": "each line must be a JSON object"})
            otherwise
                set cur_id to when contains(req, "id") and req["id"] != nothing then text(req["id"]) otherwise ""
                let op be when contains(req, "op") and req["op"] != nothing then lower(text(req["op"])) otherwise "ask"
                when op == "ping"
                    stdio_out({"id": cur_id, "kind": "pong"})
                otherwise when op == "agents"
                    stdio_out({"id": cur_id, "kind": "agents", "data": apply((n) => {"id": n, "description": runtime.get(n)["description"]}, runtime.names())})
                otherwise when op == "ask"
                    set cur_agent to lower(text(when contains(req, "to") and req["to"] != nothing and text(req["to"]) != "" then req["to"] otherwise runtime.default_agent()))
                    set cur_thread to when contains(req, "thread") and req["thread"] != nothing then text(req["thread"]) otherwise ""
                    let msg be when contains(req, "text") and req["text"] != nothing then text(req["text"]) otherwise ""
                    let spec be runtime.get(cur_agent)
                    when spec == nothing
                        stdio_fail("no agent named '" + cur_agent + "' · available: " + join(runtime.names(), ", "))
                    otherwise when trim(msg) == ""
                        stdio_fail("text is required")
                    otherwise
                        let want be when contains(req, "mode") and req["mode"] != nothing then lower(text(req["mode"])) otherwise ""
                        let mode be when want == "strict" or want == "yolo" then want otherwise (when spec["permission"] == "" then "strict" otherwise "")
                        let sobre be {"to": cur_agent, "thread": cur_thread, "session": when contains(req, "session") and req["session"] != nothing then text(req["session"]) otherwise "", "from": {"id": "", "name": "", "kind": "human"}, "text": msg, "images": when contains(req, "images") and type_of(req["images"]) == "list" then req["images"] otherwise [], "channel": "sdk", "meta": when contains(req, "meta") and type_of(req["meta"]) == "map" then req["meta"] otherwise {}}
                        try
                            let r be runtime.deliver(sobre, {"mode": mode, "ask_fn": nothing, "on_event": stdio_event, "on_start": stdio_start})
                            stdio_out({"id": cur_id, "kind": "done", "data": r, "tag": "", "agent": r["agent"], "thread": r["thread"]})
                        recover err
                            stdio_fail(text(err))
                otherwise
                    stdio_out({"id": cur_id, "kind": "error", "data": "unknown op '" + op + "' (ask, agents, ping)"})
        set line to read_line("")
    exit(0)

let json_out be env("LAMPSON_RUN_JSON", "") == "1"
let agent_id be runtime.default_agent()
let thread be env("LAMPSON_THREAD", "")

task fail_usage(msg)
    when json_out
        print(json_encode({"kind": "error", "data": msg, "tag": "", "agent": agent_id, "thread": thread}))
    otherwise
        print("lampson run: " + msg)
    exit(2)

let spec be runtime.get(agent_id)
when spec == nothing
    fail_usage("no agent named '" + agent_id + "' · available: " + join(runtime.names(), ", "))

let message be env("LAMPSON_MESSAGE", "")
when message == ""
    let lines be []
    let l be read_line("")
    while l != nothing
        set lines to append(lines, l)
        set l to read_line("")
    set message to join(lines, "\n")
when trim(message) == ""
    fail_usage("empty message (pass it as an argument or on stdin)")

let mode be lower(env("LAMPSON_RUN_PERMISSION", ""))
when mode == "" and spec["permission"] == ""
    set mode to "strict"

-- servers MCP solo si el agente puede usarlos (arrancarlos cuesta hasta unos segundos)
when contains(spec["tools"], "mcp") or length(where(spec["tools"], (t) => starts_with(t, "mcp_"))) > 0
    mcp.start_all(8)

share {"id": text(now())} as "lampson:run"
share {"kind": "cli"} as "lampson:ui"

task emit_json(kind, data, tag)
    when kind != "busy" and kind != "idle"
        print(json_encode({"kind": kind, "data": data, "tag": tag, "agent": agent_id, "thread": thread}))
        flush()

task on_start(info)
    set thread to info["thread"]
    when json_out
        print(json_encode({"kind": "session", "data": info, "tag": "", "agent": info["agent"], "thread": info["thread"]}))
        flush()

let sobre be {"to": agent_id, "thread": thread, "session": env("LAMPSON_SESSION", ""), "from": {"id": "", "name": "", "kind": "human"}, "text": message, "channel": "cli", "meta": {}}
let hooks be {"mode": mode, "ask_fn": nothing, "on_start": on_start, "on_event": when json_out then emit_json otherwise nothing}
let result be nothing
try
    set result to runtime.deliver(sobre, hooks)
recover err
    set result to {"agent": agent_id, "thread": thread, "session": "", "text": "", "steps": 0, "usage": {"input": 0, "output": 0, "cached": 0}, "stopped": "error: " + text(err)}

when json_out
    print(json_encode({"kind": "done", "data": result, "tag": "", "agent": result["agent"], "thread": result["thread"]}))
otherwise
    when starts_with(result["stopped"], "error")
        print("lampson run: " + result["stopped"])
    otherwise
        print(result["text"])
flush()
when starts_with(result["stopped"], "error")
    exit(1)
