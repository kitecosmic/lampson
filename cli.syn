-- cli.syn — lo que los launchers (lampson.ps1 / lampson.sh) le piden a Synsema. Corre con cwd = instalación.
--
--   LAMPSON_CMD=ensure  LAMPSON_WORKSPACE=<ruta>  synsema run cli.syn
--       registra/prepara el workspace, asegura el hub y su proceso → imprime UNA línea JSON {slug, port, dir, url, alive}
--   LAMPSON_CMD=hub-status  → {alive}
--   LAMPSON_CMD=hub-start | hub-stop | hub-reboot (stop + start: hub y workspaces; lo lanza ⚙ → Apagar o reiniciar)
--   LAMPSON_CMD=list
--   LAMPSON_CMD=pair  [LAMPSON_PAIR_URL=https://…]   código para emparejar un celular (lampson --pair dibuja el QR)
--   LAMPSON_CMD=domain  LAMPSON_DOMAIN=<dominio>|off|""  [LAMPSON_EMAIL=<email>]   dominio propio con HTTPS (opcional)
-- La salida útil va en la ÚLTIMA línea (JSON) para que el launcher la parsee.

require exec
require time
require net("127.0.0.1")
-- lampson --pair comprueba que la dirección pública (túnel o dominio) responda antes de dibujar un QR inútil
require net
require env("LAMPSON_*")
require env("OS")
require env("HOME")
require env("USERPROFILE")
require file(".lampson")
require file(".lampson/*")
require file.read("web.syn")
require file.read(".env")
require file.read("chat.syn")
require file.read("hub.tpl.syn")
require file("hub.syn")

use "./lib/workspaces.syn" as ws
use "./lib/settings.syn" as settings

let cmd be env("LAMPSON_CMD", "ensure")

when cmd == "ensure"
    let path be env("LAMPSON_WORKSPACE", "")
    when path == ""
        raise("LAMPSON_WORKSPACE required")
    let w be ws.ensure(path)
    when not ws.hub_alive()
        ws.start_hub()
    let hc be ws.health(w)
    when hc == nothing
        ws.start_ws(w)
        ws.wait_ready(w, 10)
        set hc to ws.health(w)
    ws.touch(w["slug"])
    -- judge_*: el juez de computer use para la terminal (lampson.ps1|sh lo exportan antes de chat.syn; ver settings.judge_env)
    let je be settings.judge_env()
    print(json_encode({"slug": w["slug"], "port": w["port"], "dir": ws.dir_of(w["slug"]), "url": "http://127.0.0.1:" + text(ws.HUB_PORT) + "/w/" + w["slug"], "alive": hc != nothing, "hub": ws.hub_alive(), "judge_provider": when contains(je, "SYNSEMA_JUDGE_PROVIDER") then je["SYNSEMA_JUDGE_PROVIDER"] otherwise "", "judge_model": when contains(je, "SYNSEMA_JUDGE_MODEL") then je["SYNSEMA_JUDGE_MODEL"] otherwise "", "judge_key": when contains(je, "TYPESAFE_API_KEY") then je["TYPESAFE_API_KEY"] otherwise ""}))
otherwise when cmd == "hub-status"
    print(json_encode({"alive": ws.hub_alive(), "workspaces": ws.summary()}))
otherwise when cmd == "hub-start"
    when not ws.hub_alive()
        ws.start_hub()
    when ws.domain_cfg() != nothing and not ws.edge_alive()
        ws.start_edge()
    print(json_encode({"alive": true}))
otherwise when cmd == "hub-stop" or cmd == "hub-reboot"
    -- desde ⚙ llega desacoplado (workspaces.cli_later): darle al hub tiempo de contestar antes de pararlo
    when env("LAMPSON_DETACHED", "") != ""
        sleep(1.5)
    ws.stop_all()
    when cmd == "hub-reboot"
        sleep(2)
        ws.start_hub()
        when ws.domain_cfg() != nothing
            ws.start_edge()
    print(json_encode({"alive": cmd == "hub-reboot"}))
otherwise when cmd == "domain"
    let arg be trim(env("LAMPSON_DOMAIN", ""))
    when arg == ""
        -- estado
        let cfg be ws.domain_cfg()
        when cfg == nothing
            print("sin dominio propio: lampson se usa en http://127.0.0.1:" + text(ws.HUB_PORT) + " (o por túnel).")
            print("para usar el tuyo:  lampson --domain lampson.midominio.com --email vos@midominio.com")
        otherwise
            print("dominio: https://" + cfg["domain"] + "   (" + (when ws.edge_alive() then "● HTTPS activo" otherwise "○ el edge no está escuchando — mirá .lampson/edge.log") + ")")
            print("certificado de Let's Encrypt a nombre de " + cfg["email"] + " · quitar: lampson --domain off")
        print(json_encode({"domain": when cfg == nothing then nothing otherwise cfg["domain"], "edge": ws.edge_alive()}))
    otherwise when lower(arg) == "off"
        let had be ws.clear_domain()
        ws.stop_edge()
        ws.regen_hub()
        when ws.hub_alive()
            ws.stop_hub()
            sleep(2)
            ws.start_hub()
        print(when had then "dominio quitado: el hub vuelve a escuchar en :" + text(ws.HUB_PORT) + " como antes." otherwise "no había dominio configurado.")
        print(json_encode({"domain": nothing}))
    otherwise
        let cfg be nothing
        try
            set cfg to ws.set_domain(arg, env("LAMPSON_EMAIL", ""))
        recover err
            print("✗ " + regex_replace(text(err), "^.*?:\d+:\d+: ", ""))
            print(json_encode({"error": text(err)}))
        when cfg != nothing
            -- el hub pasa a 127.0.0.1 (regen) y el edge arranca con el dominio nuevo
            ws.regen_hub()
            ws.stop_edge()
            when ws.hub_alive()
                ws.stop_hub()
                sleep(2)
            ws.start_hub()
            ws.start_edge()
            print("dominio: https://" + cfg["domain"] + " — pidiendo el certificado a Let's Encrypt…")
            -- esperar a que el edge escuche (el certificado se pide al arrancar; tarda unos segundos)
            let deadline be now() + 45
            while now() < deadline and not ws.edge_alive()
                sleep(1)
            let up be ws.edge_alive()
            let tail be ws.edge_log(12)
            when up
                print("● HTTPS activo en https://" + cfg["domain"] + " — emparejá el celular desde «dispositivos» (el QR ya usa esta URL).")
            otherwise
                print("○ el edge no quedó escuchando. Últimas líneas de .lampson/edge.log:")
                each l in tail
                    print("    " + l)
                print("revisá: 1) el DNS de " + cfg["domain"] + " apunta a la IP de este servidor (registro A/AAAA);")
                print("        2) los puertos 80 y 443 están abiertos en el firewall;")
                print("        3) en Linux sin root, el binario puede usar puertos bajos: sudo setcap cap_net_bind_service=+ep $(command -v synsema)")
                print("el hub reintenta solo cada 10 min; `lampson --domain off` vuelve a como estaba.")
            print(json_encode({"domain": cfg["domain"], "edge": up}))
otherwise when cmd == "hub-restart"
    -- lanzado desacoplado por workspaces.restart_hub_later: espera a que el hub termine lo que estaba haciendo,
    -- lo para y lo vuelve a arrancar con el hub.syn regenerado (bajo systemd, Restart=always ya lo levanta solo)
    sleep(1.5)
    ws.stop_hub()
    sleep(2)
    when not ws.hub_alive()
        ws.start_hub()
    print(json_encode({"restarted": true}))
otherwise when cmd == "ws-restart"
    -- lanzado desacoplado por workspaces.restart_ws_later desde el propio workspace: espera a que conteste el
    -- request que lo pidió, lo para y lo arranca de nuevo (con el entorno del juez al día)
    let w be ws.get(env("LAMPSON_WS", ""))
    when w == nothing
        raise("unknown workspace " + env("LAMPSON_WS", ""))
    sleep(1.5)
    ws.stop_ws(w)
    let deadline be now() + 8
    while now() < deadline and ws.health(w) != nothing
        sleep(0.4)
    ws.start_ws(w)
    ws.wait_ready(w, 15)
    print(json_encode({"restarted": w["slug"], "alive": ws.health(w) != nothing}))
otherwise when cmd == "pair"
    -- lampson --pair [URL]: emparejar un celular desde la terminal — en un VPS por SSH no hay navegador en «esta
    -- PC». Se le pide el código al hub por 127.0.0.1 (el emparejamiento solo se inicia desde local); el lanzador
    -- dibuja el QR con lib/tools/qr.js. Con URL, primero la guarda como pública (la del túnel o el dominio).
    when not ws.hub_alive()
        ws.start_hub()
        let deadline be now() + 15
        while now() < deadline and not ws.hub_alive()
            sleep(0.5)
    let base be "http://127.0.0.1:" + text(ws.HUB_PORT)
    let hdr be {"Content-Type": "application/json"}
    let bad be nothing
    let want be trim(env("LAMPSON_PAIR_URL", ""))
    when want != ""
        let ru be http_post(base + "/api/auth/public-url", json_encode({"url": want}), hdr, 15)
        when contains(ru, "error")
            set bad to "el hub no responde en " + base
        otherwise when status of ru != 200
            set bad to "no pude guardar la URL: " + slice(body of ru, 0, 300)
    -- ¿la dirección pública responde? Un túnel rápido de cloudflare (*.trycloudflare.com) muere al cerrar
    -- cloudflared y la dirección guardada queda vieja: el QR llevaría a «sin conexión» (2026-09-28, en el celular)
    when bad == nothing
        let cur be http_get(base + "/api/auth/public-url", {"timeout": 10})
        let pub0 be ""
        when not contains(cur, "error")
            when status of cur == 200
                set pub0 to text(json_decode(body of cur)["public_url"])
        when pub0 != "" and pub0 != "nothing"
            let probe be http_get(pub0 + "/api/auth/me", {"timeout": 8})
            let alive be false
            when not contains(probe, "error")
                set alive to status of probe == 200 and contains(body of probe, "authenticated")
            when not alive
                let tunnel be contains(pub0, "trycloudflare.com")
                set bad to "la dirección pública " + pub0 + " no responde" + (when tunnel then ": ese túnel de cloudflare ya no existe (mueren al cerrar cloudflared y cada uno trae una dirección nueva). Levantá uno con «cloudflared tunnel --url http://localhost:8080» y corré lampson --pair <la https nueva que imprime>" otherwise " — ¿está el dominio apuntando a este servidor y el edge HTTPS arriba? (lampson --domain muestra el estado)")
    when bad == nothing
        let r be http_post(base + "/api/auth/pair", "{}", hdr, 15)
        when contains(r, "error")
            set bad to "el hub no responde en " + base + " — lampson --hub start"
        otherwise when status of r != 200
            set bad to "el hub rechazó el pedido (" + text(status of r) + "): " + slice(body of r, 0, 300)
        otherwise
            let j be json_decode(body of r)
            let pub be text(j["public_url"])
            when pub == "" or pub == "nothing"
                set bad to "falta la dirección pública por la que entra el celular: lampson --pair https://tu-dominio (o configurá el dominio con lampson --domain)"
            otherwise
                print(json_encode({"link": pub + "/pair#" + text(j["code"]), "expires_in": j["expires_in"], "public_url": pub}))
    when bad != nothing
        print("✗ " + bad)
        print(json_encode({"error": bad}))
otherwise when cmd == "list"
    each w in ws.summary()
        print((when w["alive"] then "● " otherwise "○ ") + w["slug"] + "  " + w["path"] + "  :" + text(w["port"]) + "  " + w["policy"])
    print(json_encode({"count": length(ws.all())}))
otherwise
    raise("unknown LAMPSON_CMD " + cmd)
