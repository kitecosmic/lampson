-- cli.syn — lo que los launchers (lampson.ps1 / lampson.sh) le piden a Synsema. Corre con cwd = instalación.
--
--   LAMPSON_CMD=ensure  LAMPSON_WORKSPACE=<ruta>  synsema run cli.syn
--       registra/prepara el workspace, asegura el hub y su proceso → imprime UNA línea JSON {slug, port, dir, url, alive}
--   LAMPSON_CMD=hub-status  → {alive}
--   LAMPSON_CMD=hub-start | hub-stop
--   LAMPSON_CMD=list
--   LAMPSON_CMD=domain  LAMPSON_DOMAIN=<dominio>|off|""  [LAMPSON_EMAIL=<email>]   dominio propio con HTTPS (opcional)
-- La salida útil va en la ÚLTIMA línea (JSON) para que el launcher la parsee.

require exec
require time
require net("127.0.0.1")
require env("LAMPSON_*")
require env("OS")
require env("HOME")
require env("USERPROFILE")
require file(".lampson")
require file(".lampson/*")
require file.read("web.syn")
require file.read(".env")
require file.read("chat.syn")
require file.read("hub.tpl.syn")
require file("hub.syn")

use "./lib/workspaces.syn" as ws

let cmd be env("LAMPSON_CMD", "ensure")

when cmd == "ensure"
    let path be env("LAMPSON_WORKSPACE", "")
    when path == ""
        raise("LAMPSON_WORKSPACE required")
    let w be ws.ensure(path)
    when not ws.hub_alive()
        ws.start_hub()
    let hc be ws.health(w)
    when hc == nothing
        ws.start_ws(w)
        ws.wait_ready(w, 10)
        set hc to ws.health(w)
    ws.touch(w["slug"])
    print(json_encode({"slug": w["slug"], "port": w["port"], "dir": ws.dir_of(w["slug"]), "url": "http://127.0.0.1:" + text(ws.HUB_PORT) + "/w/" + w["slug"], "alive": hc != nothing, "hub": ws.hub_alive()}))
otherwise when cmd == "hub-status"
    print(json_encode({"alive": ws.hub_alive(), "workspaces": ws.summary()}))
otherwise when cmd == "hub-start"
    when not ws.hub_alive()
        ws.start_hub()
    when ws.domain_cfg() != nothing and not ws.edge_alive()
        ws.start_edge()
    print(json_encode({"alive": true}))
otherwise when cmd == "hub-stop"
    each w in ws.all()
        ws.stop_ws(w)
    ws.stop_edge()
    ws.stop_hub()
    print(json_encode({"alive": false}))
otherwise when cmd == "domain"
    let arg be trim(env("LAMPSON_DOMAIN", ""))
    when arg == ""
        -- estado
        let cfg be ws.domain_cfg()
        when cfg == nothing
            print("sin dominio propio: lampson se usa en http://127.0.0.1:" + text(ws.HUB_PORT) + " (o por túnel).")
            print("para usar el tuyo:  lampson --domain lampson.midominio.com --email vos@midominio.com")
        otherwise
            print("dominio: https://" + cfg["domain"] + "   (" + (when ws.edge_alive() then "● HTTPS activo" otherwise "○ el edge no está escuchando — mirá .lampson/edge.log") + ")")
            print("certificado de Let's Encrypt a nombre de " + cfg["email"] + " · quitar: lampson --domain off")
        print(json_encode({"domain": when cfg == nothing then nothing otherwise cfg["domain"], "edge": ws.edge_alive()}))
    otherwise when lower(arg) == "off"
        let had be ws.clear_domain()
        ws.stop_edge()
        ws.regen_hub()
        when ws.hub_alive()
            ws.stop_hub()
            sleep(2)
            ws.start_hub()
        print(when had then "dominio quitado: el hub vuelve a escuchar en :" + text(ws.HUB_PORT) + " como antes." otherwise "no había dominio configurado.")
        print(json_encode({"domain": nothing}))
    otherwise
        let cfg be nothing
        try
            set cfg to ws.set_domain(arg, env("LAMPSON_EMAIL", ""))
        recover err
            print("✗ " + regex_replace(text(err), "^.*?:\d+:\d+: ", ""))
            print(json_encode({"error": text(err)}))
        when cfg != nothing
            -- el hub pasa a 127.0.0.1 (regen) y el edge arranca con el dominio nuevo
            ws.regen_hub()
            ws.stop_edge()
            when ws.hub_alive()
                ws.stop_hub()
                sleep(2)
            ws.start_hub()
            ws.start_edge()
            print("dominio: https://" + cfg["domain"] + " — pidiendo el certificado a Let's Encrypt…")
            -- esperar a que el edge escuche (el certificado se pide al arrancar; tarda unos segundos)
            let deadline be now() + 45
            while now() < deadline and not ws.edge_alive()
                sleep(1)
            let up be ws.edge_alive()
            let tail be ws.edge_log(12)
            when up
                print("● HTTPS activo en https://" + cfg["domain"] + " — emparejá el celular desde «dispositivos» (el QR ya usa esta URL).")
            otherwise
                print("○ el edge no quedó escuchando. Últimas líneas de .lampson/edge.log:")
                each l in tail
                    print("    " + l)
                print("revisá: 1) el DNS de " + cfg["domain"] + " apunta a la IP de este servidor (registro A/AAAA);")
                print("        2) los puertos 80 y 443 están abiertos en el firewall;")
                print("        3) en Linux sin root, el binario puede usar puertos bajos: sudo setcap cap_net_bind_service=+ep $(command -v synsema)")
                print("el hub reintenta solo cada 10 min; `lampson --domain off` vuelve a como estaba.")
            print(json_encode({"domain": cfg["domain"], "edge": up}))
otherwise when cmd == "hub-restart"
    -- lanzado desacoplado por workspaces.restart_hub_later: espera a que el hub termine lo que estaba haciendo,
    -- lo para y lo vuelve a arrancar con el hub.syn regenerado (bajo systemd, Restart=always ya lo levanta solo)
    sleep(1.5)
    ws.stop_hub()
    sleep(2)
    when not ws.hub_alive()
        ws.start_hub()
    print(json_encode({"restarted": true}))
otherwise when cmd == "list"
    each w in ws.summary()
        print((when w["alive"] then "● " otherwise "○ ") + w["slug"] + "  " + w["path"] + "  :" + text(w["port"]) + "  " + w["policy"])
    print(json_encode({"count": length(ws.all())}))
otherwise
    raise("unknown LAMPSON_CMD " + cmd)
