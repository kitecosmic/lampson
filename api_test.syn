-- api_test.syn — la API /v1 (lib/api.syn, lib/apikeys.syn) contra web.syn DE VERDAD: levanta el mock LLM (:8765),
-- un receptor de callbacks (tests/mock_callback.syn, :8767) y `synsema serve web.syn` en :47990, y le habla por HTTP.
-- Lo lanza tests/run.ps1 / run.sh con el provider apuntando al mock (igual que agents_test / run_test).
-- Vive en la raíz porque un módulo no puede importar ../. Sale con error si algo falla.
require net
require time
require exec
require random
require env("LAMPSON_*")
require env("OS")
require file("workspace")
require file("workspace/*")
require file(".lampson")
require file(".lampson/*")
require file.read("plugins")
require file.read("plugins/*")
use "./lib/apikeys.syn" as apikeys
use "./lib/plugins.syn" as plugins
use "./lib/runtime.syn" as runtime
use "./lib/session.syn" as session

let failures be []
task check(cond, msg)
    when not cond
        set failures to append(failures, msg)
        print("  ✗ " + msg)
    otherwise
        print("  ✓ " + msg)

task rm_file(path)
    when env("OS", "") == "Windows_NT"
        run("cmd", ["/c", "del", "/q", replace(path, "/", "\\")], 10)
    otherwise
        run("rm", ["-f", path], 10)

task wait_up(url)
    let tries be 0
    while tries < 60
        sleep(0.25)
        set tries to tries + 1
        try
            let r be http_get(url, {}, nothing, 2)
            when r["status"] > 0
                give true
        recover err
            set tries to tries
    give false

let BASE be "http://127.0.0.1:47990/w/test/v1"

-- todos los threads que toca este test: se limpian AL EMPEZAR (una corrida abortada no contamina la siguiente) y al terminar
let TEST_THREADS be [["rt-api", "api:cliente-1"], ["rt-api", "api:cliente-2"], ["rt-api", "api:cliente-3"], ["rt-api", "api:par-1"], ["rt-api", "api:par-2"], ["rt-buf", "api:rafaga"], ["rt-mid", "api:mitad"], ["rt-buf", "api:cb-rafaga"], ["rt-buf", "chatwoot:1:77"], ["rt-api", "mcp:http-1"], ["rt-api", "a2a-1"]]
task purge_threads()
    each t in TEST_THREADS
        let ts be runtime.thread_session(t[0], t[1])
        when ts != ""
            session.delete(ts)
        rm_file(runtime.THREADS_DIR + "/" + runtime.thread_key(t[0], t[1]) + ".json")
purge_threads()
let ADIR be runtime.PROJECT_DIR
write_file(ADIR + "/rt-api.agent.json", json_encode({"id": "rt-api", "description": "agente de la API", "system": "Bot de prueba.", "tools": ["ls"], "permission": "strict", "buffer": false}))
write_file(ADIR + "/rt-buf.agent.json", json_encode({"id": "rt-buf", "system": "Bot con espera.", "tools": [], "buffer": {"quiet_s": 1, "max_s": 6}}))
write_file(ADIR + "/rt-mid.agent.json", json_encode({"id": "rt-mid", "system": "Bot lento.", "tools": ["ls"], "buffer": {"quiet_s": 0.3, "max_s": 2}}))
write_file(ADIR + "/rt-api2.agent.json", json_encode({"id": "rt-api2", "system": "Otro bot."}))

let mock be proc_spawn("synsema", ["serve", "tests/mock_llm.syn"], {"stderr": "merge"})
let cbs be proc_spawn("synsema", ["serve", "tests/mock_callback.syn"], {"stderr": "merge"})
let web be proc_spawn("synsema", ["serve", "web.syn", "--port", "47990", "--bind", "127.0.0.1"], {"stderr": "merge", "env": {"LAMPSON_WEBHOOK_SECRET": "s3cret", "LAMPSON_CHATWOOT_URL": "http://127.0.0.1:8767/", "LAMPSON_CHATWOOT_TOKEN": "tok-test", "LAMPSON_CHATWOOT_WEBHOOK_SECRET": "cwsecret", "LAMPSON_CHANNEL_CHATWOOT_AGENT": "rt-buf"}})
check(wait_up("http://127.0.0.1:8765/v1/models"), "mock LLM arriba")
check(wait_up("http://127.0.0.1:8767/last"), "receptor de callbacks arriba")
check(wait_up("http://127.0.0.1:47990/w/test/api/health"), "web.syn arriba en :47990")

let ka be apikeys.create("test-a", ["rt-api"])
let kb be apikeys.create("test-b", ["*"])
task auth(k)
    give {"Authorization": "Bearer " + k["key"], "Content-Type": "application/json"}
task post(path, body, k)
    let r be http_post(BASE + path, json_encode(body), auth(k), 60)
    let d be nothing
    try
        set d to json_decode(text(r["body"]))
    recover err
        set d to nothing
    give {"status": r["status"], "json": d, "raw": text(r["body"])}

print("auth")
check(http_get(BASE + "/agents", {}, nothing, 10)["status"] == 401, "sin key → 401")
check(http_get(BASE + "/agents", {"Authorization": "Bearer lk_nope"}, nothing, 10)["status"] == 401, "key inventada → 401")
check(http_get(BASE + "/agents", {"Authorization": "Bearer " + ka["key"]}, nothing, 10)["status"] == 200, "key válida → 200")
let ag be json_decode(text(http_get(BASE + "/agents", {"Authorization": "Bearer " + ka["key"]}, nothing, 10)["body"]))
check(apply((a) => a["id"], ag["agents"]) == ["rt-api"], "la key A solo ve su agente: " + json_encode(ag))
let agb be json_decode(text(http_get(BASE + "/agents", {"Authorization": "Bearer " + kb["key"]}, nothing, 10)["body"]))
check(contains(apply((a) => a["id"], agb["agents"]), "build") and contains(apply((a) => a["id"], agb["agents"]), "rt-api"), "la key * ve todos")
check(not contains(apply((a) => a["id"], agb["agents"]), "worker"), "worker no se ofrece")

print("POST /v1/messages (JSON)")
let created be []
let m1 be post("/messages", {"to": "rt-api", "thread": "api:cliente-1", "text": "ls"}, ka)
check(m1["status"] == 200 and starts_with(m1["json"]["text"], "final ls"), "respuesta del agente: " + slice(m1["raw"], 0, 100))
check(m1["json"]["agent"] == "rt-api" and m1["json"]["thread"] == "api:cliente-1", "con agente y thread")
when m1["json"] != nothing
    set created to append(created, m1["json"]["session"])
let m2 be post("/messages", {"to": "rt-api", "thread": "api:cliente-1", "text": "hola"}, ka)
check(m2["status"] == 200 and m2["json"]["session"] == m1["json"]["session"] and contains(m2["json"]["text"], "msgs=6"), "mismo thread → misma sesión, el historial sigue")
check(post("/messages", {"to": "build", "text": "hola"}, ka)["status"] == 403, "agente fuera de la key → 403")
check(post("/messages", {"to": "nadie", "text": "hola"}, kb)["status"] == 404, "agente inexistente → 404")
check(post("/messages", {"to": "rt-api", "text": ""}, ka)["status"] == 400, "text vacío → 400")
check(post("/messages", {"to": "rt-api", "text": "x", "callback": "ftp://x"}, ka)["status"] == 400, "callback que no es http(s) → 400")

print("POST /v1/messages/stream (SSE)")
let sr be http_post(BASE + "/messages/stream", json_encode({"to": "rt-api", "thread": "api:cliente-2", "text": "ls"}), auth(kb), 60)
let evs be []
each l in split(replace(text(sr["body"]), "\r", ""), "\n")
    when starts_with(l, "data: ")
        try
            set evs to append(evs, json_decode(slice(l, 6, length(l))))
        recover err
            set evs to evs
check(sr["status"] == 200 and length(evs) > 2, "SSE con eventos (" + text(length(evs)) + ")")
check(length(evs) > 0 and evs[0]["kind"] == "session", "primero session")
let lastev be when length(evs) > 0 then evs[length(evs) - 1] otherwise {"kind": ""}
check(lastev["kind"] == "done" and starts_with(lastev["data"]["text"], "final ls"), "último done con la respuesta")
check(length(where(evs, (e) => e["kind"] == "tool_call" and e["agent"] == "rt-api" and e["thread"] == "api:cliente-2")) == 1, "eventos con agente y thread")
when lastev["kind"] == "done"
    set created to append(created, lastev["data"]["session"])

print("callback (canal http)")
let cr be post("/messages", {"to": "rt-api", "thread": "api:cliente-3", "text": "hola", "meta": {"wa_id": "123"}, "callback": "http://127.0.0.1:8767/cb"}, ka)
check(cr["status"] == 202 and cr["json"]["status"] == "queued", "202 queued enseguida: " + cr["raw"])
let jid be when cr["json"] != nothing then text(cr["json"]["job"]) otherwise ""
let jdone be nothing
let tries be 0
while jdone == nothing and tries < 60
    sleep(0.5)
    set tries to tries + 1
    let jr be http_get(BASE + "/jobs/" + jid, {"Authorization": "Bearer " + ka["key"]}, nothing, 10)
    when jr["status"] == 200
        let jj be json_decode(text(jr["body"]))
        when jj["status"] == "done" or jj["status"] == "error"
            set jdone to jj
check(jdone != nothing and jdone["status"] == "done", "GET /v1/jobs/<id> → done")
let last be json_decode(text(http_get("http://127.0.0.1:8767/last", {}, nothing, 10)["body"]))
check(last["count"] == 1 and last["body"]["job"] == jid and contains(last["body"]["text"], "final directo"), "el callback llegó con el resultado: " + json_encode(last["body"]))
check(last["body"]["meta"]["wa_id"] == "123" and last["body"]["thread"] == "api:cliente-3", "y con el meta y el thread del sobre")
check(starts_with(last["signature"], "sha256=") and length(last["signature"]) == 71, "firmado con LAMPSON_WEBHOOK_SECRET (X-Lampson-Signature: sha256=<hex>)")
check(http_get(BASE + "/jobs/" + jid, {"Authorization": "Bearer " + kb["key"]}, nothing, 10)["status"] == 404, "el job de otra key → 404")
when jdone != nothing
    set created to append(created, jdone["result"]["session"])

print("buzón: una ráfaga del mismo cliente es UN turno (orden por sent_at)")
-- parallel_map: los tres llegan casi a la vez y en cualquier orden; sent_at dice el orden real
task fire(job)
    sleep(job["delay"])
    let r be http_post(BASE + "/messages", json_encode(job["body"]), {"Authorization": "Bearer " + job["key"], "Content-Type": "application/json"}, 120)
    let d be {"session": "", "batch": [], "text": "", "steps": 0}
    try
        set d to json_decode(text(r["body"]))
    recover err
        set d to {"session": "", "batch": [], "text": "(not JSON: " + slice(text(r["body"]), 0, 80) + ")", "steps": 0}
    give {"status": r["status"], "json": d}
let burst be parallel_map(fire, [
    {"delay": 0, "key": kb["key"], "body": {"to": "rt-buf", "thread": "api:rafaga", "text": "tres", "sent_at": 300}},
    {"delay": 0.1, "key": kb["key"], "body": {"to": "rt-buf", "thread": "api:rafaga", "text": "uno", "sent_at": 100}},
    {"delay": 0.2, "key": kb["key"], "body": {"to": "rt-buf", "thread": "api:rafaga", "text": "dos", "sent_at": 200}}
])
check(length(where(burst, (b) => b["status"] == 200)) == 3, "los tres requests responden 200")
let sess be apply((b) => b["json"]["session"], burst)
check(sess[0] == sess[1] and sess[1] == sess[2], "misma sesión para los tres")
check(length(burst[0]["json"]["batch"]) == 3 and burst[0]["json"]["text"] == burst[2]["json"]["text"], "un solo lote de 3, la misma respuesta para todos: " + burst[0]["json"]["text"])
check(contains(burst[0]["json"]["text"], "msgs=4"), "UN turno con los 3 mensajes (system + 3): " + burst[0]["json"]["text"])
let bdoc be session.load(sess[0])
let users be apply((m) => m["content"], where(bdoc["messages"], (m) => m["role"] == "user"))
check(users == ["uno", "dos", "tres"], "ordenados por sent_at, no por llegada: " + json_encode(users))
set created to append(created, sess[0])

print("buzón: lo que llega a mitad de turno entra al turno en curso")
let midr be parallel_map(fire, [
    {"delay": 0, "key": kb["key"], "body": {"to": "rt-mid", "thread": "api:mitad", "text": "espera"}},
    {"delay": 1.5, "key": kb["key"], "body": {"to": "rt-mid", "thread": "api:mitad", "text": "y hay stock?"}}
])
check(midr[0]["json"]["session"] == midr[1]["json"]["session"] and length(midr[0]["json"]["batch"]) == 2, "los dos en el mismo lote: " + json_encode(midr[0]["json"]["batch"]))
check(midr[0]["json"]["steps"] == 2 and contains(midr[0]["json"]["text"], "msgs=5"), "el modelo vio el segundo mensaje antes de responder (un solo turno de 2 pasos): " + midr[0]["json"]["text"])
check(midr[0]["json"]["text"] == midr[1]["json"]["text"], "y los dos reciben la misma respuesta")
set created to append(created, midr[0]["json"]["session"])

print("buzón: clientes distintos no se esperan entre sí")
let par be parallel_map(fire, [
    {"delay": 0, "key": kb["key"], "body": {"to": "rt-api", "thread": "api:par-1", "text": "hola"}},
    {"delay": 0, "key": kb["key"], "body": {"to": "rt-api", "thread": "api:par-2", "text": "hola"}}
])
check(par[0]["json"]["session"] != par[1]["json"]["session"] and length(par[0]["json"]["batch"]) == 1 and length(par[1]["json"]["batch"]) == 1, "dos sesiones, un lote cada una")
set created to append(created, par[0]["json"]["session"])
set created to append(created, par[1]["json"]["session"])

print("buzón: una ráfaga con callback → UN callback")
let before be json_decode(text(http_get("http://127.0.0.1:8767/last", {}, nothing, 10)["body"]))["count"]
let c1 be post("/messages", {"to": "rt-buf", "thread": "api:cb-rafaga", "text": "hola", "callback": "http://127.0.0.1:8767/cb"}, kb)
let c2 be post("/messages", {"to": "rt-buf", "thread": "api:cb-rafaga", "text": "quiero pan", "callback": "http://127.0.0.1:8767/cb"}, kb)
check(c1["status"] == 202 and c2["status"] == 202, "los dos 202 enseguida")
let j2 be nothing
let tries2 be 0
while (j2 == nothing or j2["status"] == "queued") and tries2 < 60
    sleep(0.5)
    set tries2 to tries2 + 1
    set j2 to json_decode(text(http_get(BASE + "/jobs/" + c2["json"]["job"], {"Authorization": "Bearer " + kb["key"]}, nothing, 10)["body"]))
let lastcb be json_decode(text(http_get("http://127.0.0.1:8767/last", {}, nothing, 10)["body"]))
check(lastcb["count"] == before + 1, "un solo callback para la ráfaga (" + text(lastcb["count"] - before) + ")")
check(length(lastcb["body"]["jobs"]) == 2 and lastcb["body"]["job"] == c1["json"]["job"], "con los dos jobs, encabezado por el primero")
check(j2["status"] == "merged" and j2["merged_into"] == c1["json"]["job"], "el segundo job queda merged en el primero")
set created to append(created, lastcb["body"]["session"])

print("canales: el plugin chatwoot de punta a punta (webhook firmado → buzón → agente → API de Chatwoot)")
let CH be "http://127.0.0.1:47990/w/test/ch"
let cw_was_on be length(where(plugins.all(), (l) => l["name"] == "chatwoot" and l["enabled"])) > 0
plugins.set_enabled("chatwoot", true)
task cw_post(payload, secret)
    let body be json_encode(payload)
    let ts be text(floor(now()))
    let hs be {"Content-Type": "application/json"}
    when secret != ""
        set hs["X-Chatwoot-Timestamp"] to ts
        set hs["X-Chatwoot-Signature"] to "sha256=" + decode(hmac(ts + "." + body, secret), "hex")
    let r be http_post(CH + "/chatwoot", body, hs, 30)
    let d be {}
    try
        set d to json_decode(text(r["body"]))
    recover err
        set d to {"raw": text(r["body"])}
    give {"status": r["status"], "json": d}
task cw_msg(text_, ts, mtype)
    give {"event": "message_created", "id": 5000 + ts, "content": text_, "created_at": ts, "message_type": mtype, "private": false, "sender": {"id": 9, "name": "Ana"}, "conversation": {"id": 4242, "display_id": 77}, "account": {"id": 1}, "inbox": {"id": 3}}
check(http_post(CH + "/nope", "{}", {"Content-Type": "application/json"}, 10)["status"] == 404, "canal que no existe o está apagado → 404")
let cw_before be json_decode(text(http_get("http://127.0.0.1:8767/chatwoot/last", {}, nothing, 10)["body"]))["count"]
let w1 be cw_post(cw_msg("hola", 100, "incoming"), "cwsecret")
let w2 be cw_post(cw_msg("tienen pan integral?", 200, "incoming"), "cwsecret")
check(w1["status"] == 200 and w1["json"]["accepted"] == 1 and w2["json"]["accepted"] == 1, "los dos webhooks aceptados enseguida (sin esperar al agente)")
check(cw_post(cw_msg("hola", 300, "incoming"), "otro-secreto")["status"] == 401, "firma inválida → 401")
check(cw_post(cw_msg("hola", 300, "incoming"), "")["status"] == 401, "sin firma (con secreto configurado) → 401")
let wo be cw_post(cw_msg("respuesta del bot", 300, "outgoing"), "cwsecret")
check(wo["status"] == 200 and wo["json"]["accepted"] == 0, "un mensaje SALIENTE se ignora (el agente no se contesta a sí mismo)")
let cw be nothing
let tries3 be 0
while tries3 < 60
    sleep(0.5)
    set tries3 to tries3 + 1
    set cw to json_decode(text(http_get("http://127.0.0.1:8767/chatwoot/last", {}, nothing, 10)["body"]))
    when cw["count"] > cw_before
        set tries3 to 999
check(cw["count"] == cw_before + 1, "UNA respuesta a Chatwoot para la ráfaga de 2 (" + text(cw["count"] - cw_before) + ")")
check(cw["last"]["account"] == "1" and cw["last"]["conversation"] == "77" and cw["last"]["token"] == "tok-test", "a la conversación correcta, con el token de config")
check(cw["last"]["body"]["message_type"] == "outgoing" and contains(cw["last"]["body"]["content"], "msgs=3"), "un turno con los dos mensajes: " + text(cw["last"]["body"]["content"]))
let chlog be ""
try
    set chlog to read_file(".lampson/channels/chatwoot.log")
recover err
    set chlog to ""
check(contains(chlog, "RECV 1:77") and contains(chlog, "SENT 1:77"), "el log del canal registra lo que entró y lo que salió")
plugins.set_enabled("chatwoot", cw_was_on)
rm_file(".lampson/channels/chatwoot.log")

print("MCP por HTTP (POST /v1/mcp): otro agente usa los de este workspace con la API key")
task mcp_rpc(k, payload)
    let hs be {"Content-Type": "application/json", "Accept": "application/json, text/event-stream"}
    when k != nothing
        set hs["Authorization"] to "Bearer " + k["key"]
    let r be http_post(BASE + "/mcp", json_encode(payload), hs, 60)
    let d be nothing
    try
        set d to json_decode(text(r["body"]))
    recover err
        set d to nothing
    give {"status": r["status"], "json": d}
check(mcp_rpc(nothing, {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {}})["status"] == 401, "sin key → 401")
let mi be mcp_rpc(ka, {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-03-26", "capabilities": {}, "clientInfo": {"name": "otro-agente", "version": "1"}}})
check(mi["status"] == 200 and mi["json"]["result"]["serverInfo"]["name"] == "lampson" and mi["json"]["result"]["protocolVersion"] == "2025-03-26", "initialize negocia la versión que pide el cliente")
check(mcp_rpc(ka, {"jsonrpc": "2.0", "method": "notifications/initialized"})["status"] == 202, "una notificación → 202")
let mt be mcp_rpc(ka, {"jsonrpc": "2.0", "id": 2, "method": "tools/list"})
check(apply((t) => t["name"], mt["json"]["result"]["tools"]) == ["ask", "agents"] and not contains(mt["json"]["result"]["tools"][0]["inputSchema"]["properties"], "agent"), "la key A tiene un solo agente: ask sin parámetro agent")
let mtb be mcp_rpc(kb, {"jsonrpc": "2.0", "id": 2, "method": "tools/list"})
check(contains(mtb["json"]["result"]["tools"][0]["inputSchema"]["properties"]["agent"]["enum"], "rt-api") and contains(mtb["json"]["result"]["tools"][0]["inputSchema"]["properties"]["agent"]["enum"], "build"), "la key * ofrece varios agentes")
let ma be mcp_rpc(ka, {"jsonrpc": "2.0", "id": 3, "method": "tools/call", "params": {"name": "ask", "arguments": {"message": "ls", "thread": "mcp:http-1"}}})
check(ma["status"] == 200 and not ma["json"]["result"]["isError"] and starts_with(ma["json"]["result"]["content"][0]["text"], "final ls"), "ask → respuesta del agente")
let ma2 be mcp_rpc(ka, {"jsonrpc": "2.0", "id": 4, "method": "tools/call", "params": {"name": "ask", "arguments": {"message": "hola", "thread": "mcp:http-1"}}})
check(ma2["json"]["result"]["structuredContent"]["session"] == ma["json"]["result"]["structuredContent"]["session"] and contains(ma2["json"]["result"]["content"][0]["text"], "msgs=6"), "mismo thread → la conversación sigue")
check(mcp_rpc(ka, {"jsonrpc": "2.0", "id": 5, "method": "tools/call", "params": {"name": "ask", "arguments": {"message": "x", "agent": "build"}}})["json"]["result"]["isError"], "un agente fuera de la key → isError")
check(http_get(BASE + "/mcp", {"Authorization": "Bearer " + ka["key"]}, nothing, 10)["status"] == 405, "GET → 405 (sin stream servidor→cliente)")

print("agente ↔ agente: un Lampson usa al agente de otro Lampson por MCP HTTP (mcp.json con url + key)")
-- Lampson A = `lampson run` con un mcp.json que apunta a este web.syn (Lampson B); la key va por ${LAMPSON_PROVEEDOR_KEY}
write_file(".lampson/tmp/a2a_mcp.json", json_encode({"mcpServers": {"proveedor": {"url": BASE + "/mcp", "headers": {"Authorization": "Bearer ${LAMPSON_PROVEEDOR_KEY}"}}}}))
write_file(ADIR + "/rt-a2a.agent.json", json_encode({"id": "rt-a2a", "system": "Agente de compras.", "tools": ["mcp_proveedor_*"], "permission": "yolo"}))
let ap be proc_spawn("synsema", ["run", "run.syn"], {"env": {"LAMPSON_AGENT": "rt-a2a", "LAMPSON_MESSAGE": "pregunta-proveedor", "LAMPSON_RUN_JSON": "1", "LAMPSON_MCP_CONFIG": ".lampson/tmp/a2a_mcp.json", "LAMPSON_PROVEEDOR_KEY": ka["key"]}, "stderr": "merge", "line_mode": true, "on_full": "drop_oldest"})
proc_close_stdin(ap)
let a2a_lines be []
let a2a_code be nothing
let a2a_deadline be now() + 90
while a2a_code == nothing and now() < a2a_deadline
    let ev be proc_recv(ap, 1)
    when ev != nothing
        when ev["type"] == "exit"
            set a2a_code to ev["data"]["exit_code"]
        otherwise
            set a2a_lines to append(a2a_lines, ev["data"])
proc_close(ap)
let a2a_done be nothing
let a2a_calls be []
each l in a2a_lines
    when starts_with(trim(l), "{")
        try
            let e be json_decode(trim(l))
            when e["kind"] == "done"
                set a2a_done to e["data"]
            when e["kind"] == "tool_call"
                set a2a_calls to append(a2a_calls, e["data"]["name"])
        recover err
            set a2a_calls to a2a_calls
check(a2a_code == 0 and contains(a2a_calls, "mcp_proveedor_ask"), "el agente A llamó a la tool del agente B (mcp_proveedor_ask)")
check(a2a_done != nothing and contains(a2a_done["text"], "el proveedor dijo: final ls"), "y respondió con lo que contestó el agente B: " + (when a2a_done == nothing then join(a2a_lines, " | ") otherwise a2a_done["text"]))
when a2a_done != nothing
    set created to append(created, a2a_done["session"])
rm_file(".lampson/tmp/a2a_mcp.json")
rm_file(ADIR + "/rt-a2a.agent.json")

print("revocar")
apikeys.remove(ka["id"])
check(http_get(BASE + "/agents", {"Authorization": "Bearer " + ka["key"]}, nothing, 10)["status"] == 401, "key revocada → 401")
check(apikeys.list() != nothing and length(where(apikeys.list(), (k) => k["id"] == ka["id"])) == 0, "ya no está en la lista")

-- limpieza
apikeys.remove(kb["id"])
purge_threads()
each id in created
    when id != nothing and id != ""
        when session.exists(id)
            session.delete(id)
when jid != ""
    rm_file(".lampson/api/jobs/" + jid + ".json")
rm_file(ADIR + "/rt-api.agent.json")
rm_file(ADIR + "/rt-api2.agent.json")
rm_file(ADIR + "/rt-buf.agent.json")
rm_file(ADIR + "/rt-mid.agent.json")

proc_close(web)
proc_close(cbs)
proc_close(mock)

when length(failures) > 0
    print("api_test: " + text(length(failures)) + " fallas")
    raise("api_test failed")
print("api_test: todo OK")
