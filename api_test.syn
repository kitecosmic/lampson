-- api_test.syn — la API /v1 (lib/api.syn, lib/apikeys.syn) contra web.syn DE VERDAD: levanta el mock LLM (:8765),
-- un receptor de callbacks (tests/mock_callback.syn, :8767) y `synsema serve web.syn` en :47990, y le habla por HTTP.
-- Lo lanza tests/run.ps1 / run.sh con el provider apuntando al mock (igual que agents_test / run_test).
-- Vive en la raíz porque un módulo no puede importar ../. Sale con error si algo falla.
require net
require time
require exec
require random
require env("LAMPSON_*")
require env("OS")
require file("workspace")
require file("workspace/*")
require file(".lampson")
require file(".lampson/*")
require file.read("plugins")
require file.read("plugins/*")
require file("agents")
require file("agents/*")
require db(".lampson/teams.db")
use "./lib/apikeys.syn" as apikeys
use "./lib/teams.syn" as teams
use "./lib/plugins.syn" as plugins
use "./lib/runtime.syn" as runtime
use "./lib/session.syn" as session

let failures be []
task check(cond, msg)
    when not cond
        set failures to append(failures, msg)
        print("  ✗ " + msg)
    otherwise
        print("  ✓ " + msg)

task rm_file(path)
    when env("OS", "") == "Windows_NT"
        run("cmd", ["/c", "del", "/q", replace(path, "/", "\\")], 10)
    otherwise
        run("rm", ["-f", path], 10)

task wait_up(url)
    let tries be 0
    while tries < 60
        sleep(0.25)
        set tries to tries + 1
        try
            let r be http_get(url, {}, nothing, 2)
            when r["status"] > 0
                give true
        recover err
            set tries to tries
    give false

let BASE be "http://127.0.0.1:47990/w/test/v1"

-- todos los threads que toca este test: se limpian AL EMPEZAR (una corrida abortada no contamina la siguiente) y al terminar
let TEST_THREADS be [["rt-api", "api:cliente-1"], ["rt-api", "api:cliente-2"], ["rt-api", "api:cliente-3"], ["rt-api", "api:par-1"], ["rt-api", "api:par-2"], ["rt-buf", "api:rafaga"], ["rt-mid", "api:mitad"], ["rt-mid", "api:tarde"], ["rt-buf", "api:cb-rafaga"], ["rt-buf", "chatwoot:1:77"], ["rt-api", "mcp:http-1"], ["rt-api", "a2a-1"], ["rt-api", "mcp:http-2"], ["rt-buf", "telegram:555"], ["rt-buf", "telegram:557"], ["rt-buf", "api:cb-allowed"], ["rt-buf", "telegram:600"], ["rt-ask", "api:aprob-1"], ["rt-ask", "api:aprob-2"], ["rt-team-a", "api:equipo"], ["rt-team-b", "team:rt-team"]]
task purge_threads()
    each t in TEST_THREADS
        let ts be runtime.thread_session(t[0], t[1])
        when ts != ""
            session.delete(ts)
        rm_file(runtime.THREADS_DIR + "/" + runtime.thread_key(t[0], t[1]) + ".json")
purge_threads()
let ADIR be runtime.PROJECT_DIR
write_file(ADIR + "/rt-api.agent.json", json_encode({"id": "rt-api", "description": "agente de la API", "system": "Bot de prueba.", "tools": ["ls"], "permission": "strict", "buffer": false}))
write_file(ADIR + "/rt-buf.agent.json", json_encode({"id": "rt-buf", "system": "Bot con espera.", "tools": [], "buffer": {"quiet_s": 1, "max_s": 6}}))
write_file(ADIR + "/rt-ask.agent.json", json_encode({"id": "rt-ask", "system": "Pide permiso.", "tools": ["bash"], "permission": "ask", "buffer": false}))
write_file(ADIR + "/rt-mid.agent.json", json_encode({"id": "rt-mid", "system": "Bot lento.", "tools": ["ls"], "buffer": {"quiet_s": 0.3, "max_s": 2}}))
write_file(ADIR + "/rt-api2.agent.json", json_encode({"id": "rt-api2", "system": "Otro bot."}))

let mock be proc_spawn("synsema", ["serve", "tests/mock_llm.syn"], {"stderr": "merge"})
let cbs be proc_spawn("synsema", ["serve", "tests/mock_callback.syn"], {"stderr": "merge"})
let web be proc_spawn("synsema", ["serve", "web.syn", "--port", "47990", "--bind", "127.0.0.1"], {"stderr": "merge", "env": {"LAMPSON_WEBHOOK_SECRET": "s3cret", "LAMPSON_CHATWOOT_URL": "http://127.0.0.1:8767/", "LAMPSON_CHATWOOT_TOKEN": "tok-test", "LAMPSON_CHATWOOT_WEBHOOK_SECRET": "cwsecret", "LAMPSON_CHANNEL_CHATWOOT_AGENT": "rt-buf", "LAMPSON_TELEGRAM_TOKEN": "T1", "LAMPSON_TELEGRAM_WEBHOOK_SECRET": "tgsecret", "LAMPSON_TELEGRAM_API": "http://127.0.0.1:8767", "LAMPSON_CHANNEL_TELEGRAM_AGENT": "rt-buf"}})
check(wait_up("http://127.0.0.1:8765/v1/models"), "mock LLM arriba")
check(wait_up("http://127.0.0.1:8767/last"), "receptor de callbacks arriba")
check(wait_up("http://127.0.0.1:47990/w/test/api/health"), "web.syn arriba en :47990")

let ka be apikeys.create("test-a", ["rt-api"])
let kb be apikeys.create("test-b", ["*"])
task auth(k)
    give {"Authorization": "Bearer " + k["key"], "Content-Type": "application/json"}
task post(path, body, k)
    let r be http_post(BASE + path, json_encode(body), auth(k), 60)
    let d be nothing
    try
        set d to json_decode(text(r["body"]))
    recover err
        set d to nothing
    give {"status": r["status"], "json": d, "raw": text(r["body"])}

print("OpenAPI: publica SOLO la API /v1 (la UI, la terminal, los webhooks y el hub llevan private)")
let oa be json_decode(text(http_get(BASE + "/openapi.json", {}, nothing, 10)["body"]))
let oa_paths be sort(keys(oa["paths"]))
check(oa_paths == ["/w/{slug}/v1/agents", "/w/{slug}/v1/jobs/{id}", "/w/{slug}/v1/mcp", "/w/{slug}/v1/mcp/stream", "/w/{slug}/v1/messages", "/w/{slug}/v1/messages/stream"], "por /w/<slug>/v1/openapi.json (la ruta que el hub reenvía): solo /v1 → " + json_encode(oa_paths))
check(contains(oa["paths"]["/w/{slug}/v1/messages"]["post"], "security") and contains(oa["paths"]["/w/{slug}/v1/messages"]["post"], "requestBody"), "con auth Bearer y el body declarado")
let oa_root be json_decode(text(http_get("http://127.0.0.1:47990/openapi.json", {}, nothing, 10)["body"]))
check(sort(keys(oa_root["paths"])) == oa_paths, "el /openapi.json de la raíz publica lo mismo")
let llms be text(http_get("http://127.0.0.1:47990/llms.txt", {}, nothing, 10)["body"])
check(contains(llms, "/v1/messages") and not contains(llms, "/api/term") and not contains(llms, "/api/chat") and not contains(llms, "/ch/"), "/llms.txt tampoco lista la UI, la terminal ni los webhooks")

print("auth")
check(http_get(BASE + "/agents", {}, nothing, 10)["status"] == 401, "sin key → 401")
check(http_get(BASE + "/agents", {"Authorization": "Bearer lk_nope"}, nothing, 10)["status"] == 401, "key inventada → 401")
check(http_get(BASE + "/agents", {"Authorization": "Bearer " + ka["key"]}, nothing, 10)["status"] == 200, "key válida → 200")
let ag be json_decode(text(http_get(BASE + "/agents", {"Authorization": "Bearer " + ka["key"]}, nothing, 10)["body"]))
check(apply((a) => a["id"], ag["agents"]) == ["rt-api"], "la key A solo ve su agente: " + json_encode(ag))
let agb be json_decode(text(http_get(BASE + "/agents", {"Authorization": "Bearer " + kb["key"]}, nothing, 10)["body"]))
check(contains(apply((a) => a["id"], agb["agents"]), "build") and contains(apply((a) => a["id"], agb["agents"]), "rt-api"), "la key * ve todos")
check(not contains(apply((a) => a["id"], agb["agents"]), "worker"), "worker no se ofrece")

print("POST /v1/messages (JSON)")
let created be []
let m1 be post("/messages", {"to": "rt-api", "thread": "api:cliente-1", "text": "ls"}, ka)
check(m1["status"] == 200 and starts_with(m1["json"]["text"], "final ls"), "respuesta del agente: " + slice(m1["raw"], 0, 100))
check(m1["json"]["agent"] == "rt-api" and m1["json"]["thread"] == "api:cliente-1", "con agente y thread")
when m1["json"] != nothing
    set created to append(created, m1["json"]["session"])
let m2 be post("/messages", {"to": "rt-api", "thread": "api:cliente-1", "text": "hola"}, ka)
check(m2["status"] == 200 and m2["json"]["session"] == m1["json"]["session"] and contains(m2["json"]["text"], "msgs=6"), "mismo thread → misma sesión, el historial sigue")
check(post("/messages", {"to": "build", "text": "hola"}, ka)["status"] == 403, "agente fuera de la key → 403")
check(post("/messages", {"to": "nadie", "text": "hola"}, kb)["status"] == 404, "agente inexistente → 404")
check(post("/messages", {"to": "rt-api", "text": ""}, ka)["status"] == 400, "text vacío → 400")
check(post("/messages", {"to": "rt-api", "text": "x", "callback": "ftp://x"}, ka)["status"] == 400, "callback que no es http(s) → 400")

print("POST /v1/messages/stream (SSE)")
let sr be http_post(BASE + "/messages/stream", json_encode({"to": "rt-api", "thread": "api:cliente-2", "text": "ls"}), auth(kb), 60)
let evs be []
each l in split(replace(text(sr["body"]), "\r", ""), "\n")
    when starts_with(l, "data: ")
        try
            set evs to append(evs, json_decode(slice(l, 6, length(l))))
        recover err
            set evs to evs
check(sr["status"] == 200 and length(evs) > 2, "SSE con eventos (" + text(length(evs)) + ")")
check(length(evs) > 0 and evs[0]["kind"] == "session", "primero session")
let lastev be when length(evs) > 0 then evs[length(evs) - 1] otherwise {"kind": ""}
check(lastev["kind"] == "done" and starts_with(lastev["data"]["text"], "final ls"), "último done con la respuesta")
check(length(where(evs, (e) => e["kind"] == "tool_call" and e["agent"] == "rt-api" and e["thread"] == "api:cliente-2")) == 1, "eventos con agente y thread")
when lastev["kind"] == "done"
    set created to append(created, lastev["data"]["session"])

print("callback (canal http)")
let cr be post("/messages", {"to": "rt-api", "thread": "api:cliente-3", "text": "hola", "meta": {"wa_id": "123"}, "callback": "http://127.0.0.1:8767/cb"}, ka)
check(cr["status"] == 202 and cr["json"]["status"] == "queued", "202 queued enseguida: " + cr["raw"])
let jid be when cr["json"] != nothing then text(cr["json"]["job"]) otherwise ""
let jdone be nothing
let tries be 0
while jdone == nothing and tries < 60
    sleep(0.5)
    set tries to tries + 1
    let jr be http_get(BASE + "/jobs/" + jid, {"Authorization": "Bearer " + ka["key"]}, nothing, 10)
    when jr["status"] == 200
        let jj be json_decode(text(jr["body"]))
        when jj["status"] == "done" or jj["status"] == "error"
            set jdone to jj
check(jdone != nothing and jdone["status"] == "done", "GET /v1/jobs/<id> → done")
let last be json_decode(text(http_get("http://127.0.0.1:8767/last", {}, nothing, 10)["body"]))
check(last["count"] == 1 and last["body"]["job"] == jid and contains(last["body"]["text"], "final directo"), "el callback llegó con el resultado: " + json_encode(last["body"]))
check(last["body"]["meta"]["wa_id"] == "123" and last["body"]["thread"] == "api:cliente-3", "y con el meta y el thread del sobre")
check(starts_with(last["signature"], "sha256=") and length(last["signature"]) == 71, "firmado con LAMPSON_WEBHOOK_SECRET (X-Lampson-Signature: sha256=<hex>)")
check(http_get(BASE + "/jobs/" + jid, {"Authorization": "Bearer " + kb["key"]}, nothing, 10)["status"] == 404, "el job de otra key → 404")
when jdone != nothing
    set created to append(created, jdone["result"]["session"])

print("buzón: una ráfaga del mismo cliente es UN turno (orden por sent_at)")
-- parallel_map: los tres llegan casi a la vez y en cualquier orden; sent_at dice el orden real
task fire(job)
    sleep(job["delay"])
    let r be http_post(BASE + "/messages", json_encode(job["body"]), {"Authorization": "Bearer " + job["key"], "Content-Type": "application/json"}, 120)
    let d be {"session": "", "batch": [], "text": "", "steps": 0}
    try
        set d to json_decode(text(r["body"]))
    recover err
        set d to {"session": "", "batch": [], "text": "(not JSON: " + slice(text(r["body"]), 0, 80) + ")", "steps": 0}
    give {"status": r["status"], "json": d}
let burst be parallel_map(fire, [
    {"delay": 0, "key": kb["key"], "body": {"to": "rt-buf", "thread": "api:rafaga", "text": "tres", "sent_at": 300}},
    {"delay": 0.1, "key": kb["key"], "body": {"to": "rt-buf", "thread": "api:rafaga", "text": "uno", "sent_at": 100}},
    {"delay": 0.2, "key": kb["key"], "body": {"to": "rt-buf", "thread": "api:rafaga", "text": "dos", "sent_at": 200}}
])
check(length(where(burst, (b) => b["status"] == 200)) == 3, "los tres requests responden 200")
let sess be apply((b) => b["json"]["session"], burst)
check(sess[0] == sess[1] and sess[1] == sess[2], "misma sesión para los tres")
check(length(burst[0]["json"]["batch"]) == 3 and burst[0]["json"]["text"] == burst[2]["json"]["text"], "un solo lote de 3, la misma respuesta para todos: " + burst[0]["json"]["text"])
check(contains(burst[0]["json"]["text"], "msgs=4"), "UN turno con los 3 mensajes (system + 3): " + burst[0]["json"]["text"])
let bdoc be session.load(sess[0])
let users be apply((m) => m["content"], where(bdoc["messages"], (m) => m["role"] == "user"))
check(users == ["uno", "dos", "tres"], "ordenados por sent_at, no por llegada: " + json_encode(users))
set created to append(created, sess[0])

print("buzón: lo que llega a mitad de turno entra al turno en curso")
let midr be parallel_map(fire, [
    {"delay": 0, "key": kb["key"], "body": {"to": "rt-mid", "thread": "api:mitad", "text": "espera"}},
    {"delay": 1.5, "key": kb["key"], "body": {"to": "rt-mid", "thread": "api:mitad", "text": "y hay stock?"}}
])
check(midr[0]["json"]["session"] == midr[1]["json"]["session"] and length(midr[0]["json"]["batch"]) == 2, "los dos en el mismo lote: " + json_encode(midr[0]["json"]["batch"]))
check(midr[0]["json"]["steps"] == 2 and contains(midr[0]["json"]["text"], "msgs=5"), "el modelo vio el segundo mensaje antes de responder (un solo turno de 2 pasos): " + midr[0]["json"]["text"])
check(midr[0]["json"]["text"] == midr[1]["json"]["text"], "y los dos reciben la misma respuesta")
set created to append(created, midr[0]["json"]["session"])

print("buzón: lo que llega mientras el modelo escribe la respuesta (sin tools) la rehace — no sale una respuesta vieja")
let late be parallel_map(fire, [
    {"delay": 0, "key": kb["key"], "body": {"to": "rt-mid", "thread": "api:tarde", "text": "piensa: hola"}},
    {"delay": 1.5, "key": kb["key"], "body": {"to": "rt-mid", "thread": "api:tarde", "text": "piensa: soy lucía"}}
])
check(length(late[0]["json"]["batch"]) == 2 and late[0]["json"]["text"] == late[1]["json"]["text"], "un lote, una respuesta: " + json_encode(late[0]["json"]["batch"]))
check(late[0]["json"]["steps"] == 2 and contains(late[0]["json"]["text"], "msgs=3 · último: piensa: soy lucía"), "el borrador se descartó y la respuesta vio el segundo mensaje: " + late[0]["json"]["text"])
let ldoc be session.load(late[0]["json"]["session"])
check(length(where(ldoc["messages"], (m) => m["role"] == "assistant")) == 1, "en la sesión queda solo la respuesta final, no el borrador")
set created to append(created, late[0]["json"]["session"])

print("buzón: clientes distintos no se esperan entre sí")
let par be parallel_map(fire, [
    {"delay": 0, "key": kb["key"], "body": {"to": "rt-api", "thread": "api:par-1", "text": "hola"}},
    {"delay": 0, "key": kb["key"], "body": {"to": "rt-api", "thread": "api:par-2", "text": "hola"}}
])
check(par[0]["json"]["session"] != par[1]["json"]["session"] and length(par[0]["json"]["batch"]) == 1 and length(par[1]["json"]["batch"]) == 1, "dos sesiones, un lote cada una")
set created to append(created, par[0]["json"]["session"])
set created to append(created, par[1]["json"]["session"])

print("buzón: una ráfaga con callback → UN callback")
let before be json_decode(text(http_get("http://127.0.0.1:8767/last", {}, nothing, 10)["body"]))["count"]
let c1 be post("/messages", {"to": "rt-buf", "thread": "api:cb-rafaga", "text": "hola", "callback": "http://127.0.0.1:8767/cb"}, kb)
let c2 be post("/messages", {"to": "rt-buf", "thread": "api:cb-rafaga", "text": "quiero pan", "callback": "http://127.0.0.1:8767/cb"}, kb)
check(c1["status"] == 202 and c2["status"] == 202, "los dos 202 enseguida")
let j2 be nothing
let tries2 be 0
while (j2 == nothing or j2["status"] == "queued") and tries2 < 60
    sleep(0.5)
    set tries2 to tries2 + 1
    set j2 to json_decode(text(http_get(BASE + "/jobs/" + c2["json"]["job"], {"Authorization": "Bearer " + kb["key"]}, nothing, 10)["body"]))
let lastcb be json_decode(text(http_get("http://127.0.0.1:8767/last", {}, nothing, 10)["body"]))
check(lastcb["count"] == before + 1, "un solo callback para la ráfaga (" + text(lastcb["count"] - before) + ")")
check(length(lastcb["body"]["jobs"]) == 2 and lastcb["body"]["job"] == c1["json"]["job"], "con los dos jobs, encabezado por el primero")
check(j2["status"] == "merged" and j2["merged_into"] == c1["json"]["job"], "el segundo job queda merged en el primero")
set created to append(created, lastcb["body"]["session"])

print("canales: el plugin chatwoot de punta a punta (webhook firmado → buzón → agente → API de Chatwoot)")
let CH be "http://127.0.0.1:47990/w/test/ch"
let threads_extra_600 be false
let cw_was_on be length(where(plugins.all(), (l) => l["name"] == "chatwoot" and l["enabled"])) > 0
plugins.set_enabled("chatwoot", true)
task cw_post(payload, secret)
    let body be json_encode(payload)
    let ts be text(floor(now()))
    let hs be {"Content-Type": "application/json"}
    when secret != ""
        set hs["X-Chatwoot-Timestamp"] to ts
        set hs["X-Chatwoot-Signature"] to "sha256=" + decode(hmac(ts + "." + body, secret), "hex")
    let r be http_post(CH + "/chatwoot", body, hs, 30)
    let d be {}
    try
        set d to json_decode(text(r["body"]))
    recover err
        set d to {"raw": text(r["body"])}
    give {"status": r["status"], "json": d}
task cw_msg(text_, ts, mtype)
    give {"event": "message_created", "id": 5000 + ts, "content": text_, "created_at": ts, "message_type": mtype, "private": false, "sender": {"id": 9, "name": "Ana"}, "conversation": {"id": 4242, "display_id": 77}, "account": {"id": 1}, "inbox": {"id": 3}}
check(http_post(CH + "/nope", "{}", {"Content-Type": "application/json"}, 10)["status"] == 404, "canal que no existe o está apagado → 404")
let cw_before be json_decode(text(http_get("http://127.0.0.1:8767/chatwoot/last", {}, nothing, 10)["body"]))["count"]
let w1 be cw_post(cw_msg("hola", 100, "incoming"), "cwsecret")
let w2 be cw_post(cw_msg("tienen pan integral?", 200, "incoming"), "cwsecret")
check(w1["status"] == 200 and w1["json"]["accepted"] == 1 and w2["json"]["accepted"] == 1, "los dos webhooks aceptados enseguida (sin esperar al agente)")
check(cw_post(cw_msg("hola", 300, "incoming"), "otro-secreto")["status"] == 401, "firma inválida → 401")
check(cw_post(cw_msg("hola", 300, "incoming"), "")["status"] == 401, "sin firma (con secreto configurado) → 401")
let wo be cw_post(cw_msg("respuesta del bot", 300, "outgoing"), "cwsecret")
check(wo["status"] == 200 and wo["json"]["accepted"] == 0, "un mensaje SALIENTE se ignora (el agente no se contesta a sí mismo)")
let cw be nothing
let tries3 be 0
while tries3 < 60
    sleep(0.5)
    set tries3 to tries3 + 1
    set cw to json_decode(text(http_get("http://127.0.0.1:8767/chatwoot/last", {}, nothing, 10)["body"]))
    when cw["count"] > cw_before
        set tries3 to 999
check(cw["count"] == cw_before + 1, "UNA respuesta a Chatwoot para la ráfaga de 2 (" + text(cw["count"] - cw_before) + ")")
check(cw["last"]["account"] == "1" and cw["last"]["conversation"] == "77" and cw["last"]["token"] == "tok-test", "a la conversación correcta, con el token de config")
check(cw["last"]["body"]["message_type"] == "outgoing" and contains(cw["last"]["body"]["content"], "msgs=3"), "un turno con los dos mensajes: " + text(cw["last"]["body"]["content"]))
-- el worker escribe SENT apenas vuelve el send: puede llegar un instante después de que Chatwoot recibió el mensaje
let chlog be ""
let tries4 be 0
while not contains(chlog, "SENT 1:77") and tries4 < 40
    set tries4 to tries4 + 1
    try
        set chlog to read_file(".lampson/channels/chatwoot.log")
    recover err
        set chlog to ""
    when not contains(chlog, "SENT 1:77")
        sleep(0.25)
check(contains(chlog, "RECV 1:77") and contains(chlog, "SENT 1:77"), "el log del canal registra lo que entró y lo que salió")
plugins.set_enabled("chatwoot", cw_was_on)
rm_file(".lampson/channels/chatwoot.log")

print("canales: el plugin telegram de punta a punta (setup, webhook con secreto, escribiendo…, sendMessage)")
let tg_was_on be length(where(plugins.all(), (l) => l["name"] == "telegram" and l["enabled"])) > 0
plugins.set_enabled("telegram", true)
task tg_calls(method)
    let all_calls be json_decode(text(http_get("http://127.0.0.1:8767/telegram/calls", {}, nothing, 10)["body"]))["calls"]
    give where(all_calls, (c) => c["method"] == method)
task tg_post(update, secret)
    let hs be {"Content-Type": "application/json"}
    when secret != ""
        set hs["X-Telegram-Bot-Api-Secret-Token"] to secret
    let r be http_post(CH + "/telegram", json_encode(update), hs, 30)
    let d be {}
    try
        set d to json_decode(text(r["body"]))
    recover err
        set d to {"raw": text(r["body"])}
    give {"status": r["status"], "json": d}
task tg_msg(chat, text_, date, extra)
    let m be {"message_id": date, "from": {"id": 9001, "is_bot": false, "first_name": "Ana", "username": "ana_p"}, "chat": {"id": chat, "type": "private"}, "date": date, "text": text_}
    each k in keys(extra)
        set m[k] to extra[k]
    give {"update_id": date, "message": m}
-- run.syn como lo llama `lampson channel …` (con la URL pública y el slug que pone el launcher)
task channel_cli(cmd, name)
    give channel_cli_pub(cmd, name, "https://example.test")
task channel_cli_pub(cmd, name, pub)
    let p be proc_spawn("synsema", ["run", "run.syn"], {"env": {"LAMPSON_CHANNEL_CMD": cmd, "LAMPSON_CHANNEL_NAME": name, "LAMPSON_PUBLIC_URL": pub, "LAMPSON_WS": "test", "LAMPSON_TELEGRAM_TOKEN": "T1", "LAMPSON_TELEGRAM_WEBHOOK_SECRET": "tgsecret", "LAMPSON_TELEGRAM_API": "http://127.0.0.1:8767", "LAMPSON_CHANNEL_TELEGRAM_AGENT": "rt-buf"}, "stderr": "merge", "line_mode": true, "on_full": "drop_oldest"})
    proc_close_stdin(p)
    let lines be []
    let code be nothing
    let deadline be now() + 60
    while code == nothing and now() < deadline
        let ev be proc_recv(p, 1)
        when ev != nothing
            when ev["type"] == "exit"
                set code to ev["data"]["exit_code"]
            otherwise
                set lines to append(lines, ev["data"])
    proc_close(p)
    give {"code": code, "out": join(lines, "\n")}
let cl be channel_cli("list", "")
check(cl["code"] == 0 and contains(cl["out"], "● telegram") and contains(cl["out"], "agente: rt-buf") and contains(cl["out"], "https://example.test/w/test/ch/telegram"), "lampson channel list: encendido, agente y URL del webhook")
let cs be channel_cli("setup", "telegram")
let hooks_set be tg_calls("setWebhook")
check(cs["code"] == 0 and contains(cs["out"], "@lampson_test_bot") and length(hooks_set) > 0, "lampson channel setup telegram registra el webhook: " + trim(cs["out"]))
check(length(hooks_set) > 0 and hooks_set[length(hooks_set) - 1]["body"]["url"] == "https://example.test/w/test/ch/telegram" and hooks_set[length(hooks_set) - 1]["body"]["secret_token"] == "tgsecret" and hooks_set[length(hooks_set) - 1]["bot"] == "botT1", "con la URL pública, el secreto y el token del .env")
check(contains(channel_cli("setup", "chatwoot")["out"], "apagado") or contains(channel_cli("setup", "chatwoot")["out"], "pegá esta URL"), "un canal sin setup (o apagado) lo dice en vez de fallar")
let sends_before be length(tg_calls("sendMessage"))
let typing_before be length(tg_calls("sendChatAction"))
let t1 be tg_post(tg_msg(555, "hola", 100, {}), "tgsecret")
let t2 be tg_post(tg_msg(555, "tienen pan integral?", 200, {}), "tgsecret")
check(t1["status"] == 200 and t1["json"]["accepted"] == 1 and t2["json"]["accepted"] == 1, "los dos updates aceptados enseguida")
check(length(tg_calls("sendChatAction")) >= typing_before + 2, "avisa escribiendo… apenas llega cada mensaje")
check(tg_post(tg_msg(555, "hola", 300, {}), "otro")["status"] == 401, "secreto inválido → 401")
check(tg_post({"update_id": 1, "edited_message": {"message_id": 1, "chat": {"id": 555}, "from": {"id": 9001, "is_bot": false}, "text": "editado", "date": 1}}, "tgsecret")["json"]["accepted"] == 0, "una edición se ignora (no hay respuesta duplicada)")
check(tg_post(tg_msg(555, "soy un bot", 301, {"from": {"id": 7, "is_bot": true, "first_name": "Otro"}}), "tgsecret")["json"]["accepted"] == 0, "un mensaje de otro bot se ignora")
let tp be tg_post(tg_msg(557, nothing, 400, {"caption": "mirá esto", "photo": [{"file_id": "chica", "file_size": 900}, {"file_id": "x", "file_size": 50000}, {"file_id": "enorme", "file_size": 5000000}]}), "tgsecret")
check(tp["json"]["accepted"] == 1, "una foto con caption entra")
let sends be []
let tries5 be 0
while length(sends) < sends_before + 2 and tries5 < 60
    sleep(0.5)
    set tries5 to tries5 + 1
    set sends to tg_calls("sendMessage")
let to555 be where(sends, (c) => c["body"]["chat_id"] == 555)
check(length(to555) == 1 and contains(to555[0]["body"]["text"], "msgs=3") and to555[0]["bot"] == "botT1", "UNA respuesta al chat 555 para la ráfaga de 2: " + (when length(to555) > 0 then to555[0]["body"]["text"] otherwise "(ninguna)"))
check(length(where(sends, (c) => c["body"]["chat_id"] == 557)) == 1, "y otra al chat de la foto")
let ts557 be runtime.thread_session("rt-buf", "telegram:557")
let doc557 be when ts557 != "" then session.load(ts557) otherwise {"messages": []}
let u557 be where(doc557["messages"], (m) => m["role"] == "user" and contains(text(m["content"]), "mirá esto"))
check(length(u557) == 1 and contains(u557[0], "images") and length(u557[0]["images"]) == 1, "la foto llega al agente como IMAGEN, con el caption como texto")
check(length(u557) == 1 and contains(u557[0], "images") and u557[0]["images"][0]["media_type"] == "image/jpeg" and u557[0]["images"][0]["data"] == decode(bytes("FFD8FFE000104A46494600010100", "hex"), "base64"), "los bytes descargados con getFile, en base64")
check(length(where(tg_calls("getFile"), (c) => c["body"]["file_id"] == "x")) == 1, "eligió la versión más grande que entra en 1 MB (no la de 5 MB)")
check(length(tg_calls("sendChatAction")) >= typing_before + 5, "escribiendo…: al recibir cada mensaje y otra vez cuando el agente arranca el turno (" + text(length(tg_calls("sendChatAction")) - typing_before) + ")")
-- send en partes: el plugin solo, bajo su techo, con un texto de 9000 caracteres
let longtxt be ""
let li be 0
while li < 180
    set longtxt to longtxt + "Línea " + text(li) + " de una respuesta muy larga que Telegram no deja mandar entera.\n"
    set li to li + 1
let before_long be length(tg_calls("sendMessage"))
let lp be proc_spawn("synsema", ["run", "--cap-set", "stdout,time,env=PLUGIN_*,env=LAMP_*,net", "plugins/telegram/plugin.syn"], {"env": {"PLUGIN_TOOL": "send", "PLUGIN_ARGS": json_encode({"thread": "558", "text": longtxt, "meta": {"chat_id": 558}}), "PLUGIN_TELEGRAM_TOKEN": "T1", "PLUGIN_TELEGRAM_API": "http://127.0.0.1:8767"}, "stderr": "merge", "line_mode": true})
proc_close_stdin(lp)
let lout be ""
let lcode be nothing
while lcode == nothing
    let ev be proc_recv(lp, 30)
    when ev == nothing
        set lcode to -1
    otherwise when ev["type"] == "exit"
        set lcode to ev["data"]["exit_code"]
    otherwise
        set lout to lout + ev["data"]
proc_close(lp)
let parts be where(tg_calls("sendMessage"), (c) => c["body"]["chat_id"] == 558)
check(length(parts) == 4 and length(where(parts, (c) => length(c["body"]["text"]) <= 4000)) == 4, "un texto de " + text(length(longtxt)) + " caracteres sale en 4 partes de ≤ 4000: " + lout)
check(length(where(parts, (c) => ends_with(c["body"]["text"], "entera."))) == 4, "cada parte corta en un salto de línea, no a mitad de frase")
print("canales sin URL pública: lampson channel setup elige el modo poll y el workspace pide los mensajes solo")
let sp0 be channel_cli_pub("setup", "telegram", "")
check(sp0["code"] == 0 and contains(sp0["out"], "polling mode: @lampson_test_bot") and contains(sp0["out"], "modo sin URL pública"), "setup sin URL pública → modo poll: " + replace(trim(sp0["out"]), "\n", " | "))
check(length(tg_calls("deleteWebhook")) >= 1, "y quitó el webhook en Telegram (los dos modos no conviven)")
check(contains(channel_cli_pub("list", "", "")["out"], "modo: sin URL pública (poll)"), "channel list muestra el modo")
-- el tick del workspace (cada 5 s) arranca el poller; un mensaje encolado en "Telegram" tiene que llegar al agente
http_post("http://127.0.0.1:8767/telegram/queue", json_encode(tg_msg(600, "hola por poll", 500, {})), {"Content-Type": "application/json"}, 10)
let p600 be []
let tries6 be 0
while length(p600) == 0 and tries6 < 60
    sleep(0.5)
    set tries6 to tries6 + 1
    set p600 to where(tg_calls("sendMessage"), (c) => c["body"]["chat_id"] == 600)
check(length(p600) == 1, "un mensaje pedido por poll (sin webhook) recibe su respuesta en el chat 600")
check(length(where(tg_calls("getUpdates"), (c) => contains(c["body"], "offset") and c["body"]["offset"] == 501)) >= 1, "el cursor avanza: la próxima vuelta pide desde el update 501")
let cur_txt be ""
try
    set cur_txt to read_file(".lampson/channels/telegram.cursor")
recover err
    set cur_txt to ""
check(contains(cur_txt, "501"), "y queda guardado en disco (sobrevive a un reinicio): " + cur_txt)
-- volver a webhook: el poller se detiene solo
channel_cli("setup", "telegram")
let polls_before be length(tg_calls("getUpdates"))
sleep(4)
check(length(tg_calls("getUpdates")) <= polls_before + 1, "con el modo webhook de vuelta, el poller deja de pedir")
set threads_extra_600 to true
plugins.set_enabled("telegram", tg_was_on)
rm_file(".lampson/channels/telegram.log")
rm_file(".lampson/channels/telegram.cursor")
rm_file(".lampson/channels/modes.json")

print("MCP por HTTP (POST /v1/mcp): otro agente usa los de este workspace con la API key")
task mcp_rpc(k, payload)
    let hs be {"Content-Type": "application/json", "Accept": "application/json, text/event-stream"}
    when k != nothing
        set hs["Authorization"] to "Bearer " + k["key"]
    let r be http_post(BASE + "/mcp", json_encode(payload), hs, 60)
    let d be nothing
    try
        set d to json_decode(text(r["body"]))
    recover err
        set d to nothing
    give {"status": r["status"], "json": d}
check(mcp_rpc(nothing, {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {}})["status"] == 401, "sin key → 401")
let mi be mcp_rpc(ka, {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-03-26", "capabilities": {}, "clientInfo": {"name": "otro-agente", "version": "1"}}})
check(mi["status"] == 200 and mi["json"]["result"]["serverInfo"]["name"] == "lampson" and mi["json"]["result"]["protocolVersion"] == "2025-03-26", "initialize negocia la versión que pide el cliente")
check(mcp_rpc(ka, {"jsonrpc": "2.0", "method": "notifications/initialized"})["status"] == 202, "una notificación → 202")
let mt be mcp_rpc(ka, {"jsonrpc": "2.0", "id": 2, "method": "tools/list"})
check(apply((t) => t["name"], mt["json"]["result"]["tools"]) == ["ask", "agents", "history"] and not contains(mt["json"]["result"]["tools"][0]["inputSchema"]["properties"], "agent"), "la key A tiene un solo agente: ask sin parámetro agent")
let mtb be mcp_rpc(kb, {"jsonrpc": "2.0", "id": 2, "method": "tools/list"})
check(contains(mtb["json"]["result"]["tools"][0]["inputSchema"]["properties"]["agent"]["enum"], "rt-api") and contains(mtb["json"]["result"]["tools"][0]["inputSchema"]["properties"]["agent"]["enum"], "build"), "la key * ofrece varios agentes")
let ma be mcp_rpc(ka, {"jsonrpc": "2.0", "id": 3, "method": "tools/call", "params": {"name": "ask", "arguments": {"message": "ls", "thread": "mcp:http-1"}}})
check(ma["status"] == 200 and not ma["json"]["result"]["isError"] and starts_with(ma["json"]["result"]["content"][0]["text"], "final ls"), "ask → respuesta del agente")
let ma2 be mcp_rpc(ka, {"jsonrpc": "2.0", "id": 4, "method": "tools/call", "params": {"name": "ask", "arguments": {"message": "hola", "thread": "mcp:http-1"}}})
check(ma2["json"]["result"]["structuredContent"]["session"] == ma["json"]["result"]["structuredContent"]["session"] and contains(ma2["json"]["result"]["content"][0]["text"], "msgs=6"), "mismo thread → la conversación sigue")
check(mcp_rpc(ka, {"jsonrpc": "2.0", "id": 5, "method": "tools/call", "params": {"name": "ask", "arguments": {"message": "x", "agent": "build"}}})["json"]["result"]["isError"], "un agente fuera de la key → isError")
check(http_get(BASE + "/mcp", {"Authorization": "Bearer " + ka["key"]}, nothing, 10)["status"] == 405, "GET → 405 (sin stream servidor→cliente)")
let mh be mcp_rpc(ka, {"jsonrpc": "2.0", "id": 6, "method": "tools/call", "params": {"name": "history", "arguments": {"thread": "mcp:http-1"}}})
check(contains(mh["json"]["result"]["content"][0]["text"], "USER: ls") and contains(mh["json"]["result"]["content"][0]["text"], "AGENT: final directo"), "history por HTTP: la conversación de mcp:http-1")
-- /v1/mcp/stream: SSE con progreso
let ms be http_post(BASE + "/mcp/stream", json_encode({"jsonrpc": "2.0", "id": 7, "method": "tools/call", "params": {"name": "ask", "arguments": {"message": "ls", "thread": "mcp:http-2"}, "_meta": {"progressToken": "pt-1"}}}), {"Authorization": "Bearer " + ka["key"], "Content-Type": "application/json", "Accept": "application/json, text/event-stream"}, 60)
let sse_msgs be []
each l in split(replace(text(ms["body"]), "\r", ""), "\n")
    when starts_with(l, "data:")
        try
            set sse_msgs to append(sse_msgs, json_decode(trim(slice(l, 5, length(l)))))
        recover err
            set sse_msgs to sse_msgs
let progress be where(sse_msgs, (m) => contains(m, "method") and m["method"] == "notifications/progress")
let final_msg be where(sse_msgs, (m) => contains(m, "id") and m["id"] == 7)
check(length(progress) >= 1 and progress[0]["params"]["progressToken"] == "pt-1", "SSE: notifications/progress mientras el agente trabaja (" + text(length(progress)) + ": " + (when length(progress) > 0 then text(progress[0]["params"]["message"]) otherwise "-") + ")")
check(length(final_msg) == 1 and starts_with(final_msg[0]["result"]["content"][0]["text"], "final ls"), "y al final la respuesta con el id del pedido")
let ms2 be http_post(BASE + "/mcp/stream", json_encode({"jsonrpc": "2.0", "id": 8, "method": "tools/list"}), {"Authorization": "Bearer " + ka["key"], "Content-Type": "application/json"}, 30)
check(contains(text(ms2["body"]), "\"history\""), "por SSE también responde lo demás (tools/list)")

print("agente ↔ agente: un Lampson usa al agente de otro Lampson por MCP HTTP (mcp.json con url + key)")
-- Lampson A = `lampson run` con un mcp.json que apunta a este web.syn (Lampson B); la key va por ${LAMPSON_PROVEEDOR_KEY}
write_file(".lampson/tmp/a2a_mcp.json", json_encode({"mcpServers": {"proveedor": {"url": BASE + "/mcp", "headers": {"Authorization": "Bearer ${LAMPSON_PROVEEDOR_KEY}"}}}}))
-- el agente A es STRICT: la tool del proveedor la habilita SOLO el permiso por tool (approve auto), sin yolo
write_file(ADIR + "/rt-a2a.agent.json", json_encode({"id": "rt-a2a", "system": "Agente de compras.", "permission": "strict", "tools": [{"name": "mcp_proveedor_*", "approve": "auto"}]}))
write_file(ADIR + "/rt-a2a-no.agent.json", json_encode({"id": "rt-a2a-no", "system": "Agente de compras sin permiso.", "permission": "strict", "tools": ["mcp_proveedor_*"]}))
task run_a2a(agent_id)
    let ap be proc_spawn("synsema", ["run", "run.syn"], {"env": {"LAMPSON_AGENT": agent_id, "LAMPSON_MESSAGE": "pregunta-proveedor", "LAMPSON_RUN_JSON": "1", "LAMPSON_MCP_CONFIG": ".lampson/tmp/a2a_mcp.json", "LAMPSON_PROVEEDOR_KEY": ka["key"]}, "stderr": "merge", "line_mode": true, "on_full": "drop_oldest"})
    proc_close_stdin(ap)
    let lines be []
    let code be nothing
    let deadline be now() + 90
    while code == nothing and now() < deadline
        let ev be proc_recv(ap, 1)
        when ev != nothing
            when ev["type"] == "exit"
                set code to ev["data"]["exit_code"]
            otherwise
                set lines to append(lines, ev["data"])
    proc_close(ap)
    let done be nothing
    let calls be []
    let denied be []
    each l in lines
        when starts_with(trim(l), "{")
            try
                let e be json_decode(trim(l))
                when e["kind"] == "done"
                    set done to e["data"]
                when e["kind"] == "tool_call"
                    set calls to append(calls, e["data"]["name"])
                when e["kind"] == "tool_denied"
                    set denied to append(denied, e["data"]["reason"])
            recover err
                set calls to calls
    give {"code": code, "done": done, "calls": calls, "denied": denied, "raw": join(lines, " | ")}
let a2a be run_a2a("rt-a2a")
check(a2a["code"] == 0 and contains(a2a["calls"], "mcp_proveedor_ask") and length(a2a["denied"]) == 0, "el agente A (strict + approve auto) llamó a la tool del agente B")
check(a2a["done"] != nothing and contains(a2a["done"]["text"], "el proveedor dijo: final ls"), "y respondió con lo que contestó el agente B: " + (when a2a["done"] == nothing then a2a["raw"] otherwise a2a["done"]["text"]))
when a2a["done"] != nothing
    set created to append(created, a2a["done"]["session"])
let a2n be run_a2a("rt-a2a-no")
check(length(a2n["denied"]) == 1 and a2n["done"] != nothing and contains(a2n["done"]["text"], "DENIED"), "sin approve, el mismo agente strict NO puede usarla: " + (when length(a2n["denied"]) > 0 then a2n["denied"][0] otherwise a2n["raw"]))
when a2n["done"] != nothing
    set created to append(created, a2n["done"]["session"])
rm_file(ADIR + "/rt-a2a-no.agent.json")
rm_file(".lampson/tmp/a2a_mcp.json")
rm_file(ADIR + "/rt-a2a.agent.json")

print("agentes globales: un agente de agents/ (la instalación) atendido por la API — pasa por el worker del buzón")
write_file("agents/rt-gapi.agent.json", json_encode({"id": "rt-gapi", "description": "agente global", "system": "Soy global.", "tools": [], "buffer": false}))
let ga be post("/messages", {"to": "rt-gapi", "thread": "api:global-1", "text": "hola"}, kb)
check(ga["status"] == 200 and ga["json"]["agent"] == "rt-gapi" and contains(ga["json"]["text"], "final (no tools offered)"), "el agente global responde por /v1/messages: " + slice(ga["raw"], 0, 80))
when ga["json"] != nothing
    set created to append(created, ga["json"]["session"])
rm_file("agents/rt-gapi.agent.json")
rm_file(runtime.THREADS_DIR + "/" + runtime.thread_key("rt-gapi", "api:global-1") + ".json")

print("aprobación real por la API: un agente en modo ask espera a que una persona apruebe o deniegue")
-- dos tareas a la vez: el pedido (que queda esperando la aprobación) y "la persona" que la responde por la cola
task answer_approval(decision)
    let deadline be now() + 30
    while now() < deadline
        let ap be json_decode(text(http_get("http://127.0.0.1:47990/w/test/api/approvals", {}, nothing, 10)["body"]))
        let pend be where(ap["approvals"], (x) => x["status"] == "pending" and x["source"] == "api")
        when length(pend) > 0
            http_post("http://127.0.0.1:47990/w/test/api/approve", json_encode({"id": pend[0]["id"], "decision": decision}), {"Content-Type": "application/json"}, 10)
            give {"id": pend[0]["id"], "message": pend[0]["message"]}
        sleep(0.3)
    give nothing
task approval_job(job)
    when job["kind"] == "ask"
        sleep(0)
        let r be http_post(BASE + "/messages", json_encode(job["body"]), {"Authorization": "Bearer " + job["key"], "Content-Type": "application/json"}, 120)
        give json_decode(text(r["body"]))
    give answer_approval(job["decision"])
let den be parallel_map(approval_job, [{"kind": "ask", "key": kb["key"], "body": {"to": "rt-ask", "thread": "api:aprob-1", "text": "riesgo-suave"}}, {"kind": "human", "decision": false}])
check(den[1] != nothing and contains(den[1]["message"], "echo aprobado | sh"), "la aprobación pendiente aparece en la cola (UI, link, webhook): " + (when den[1] == nothing then "(nada)" otherwise den[1]["message"]))
check(contains(den[0]["text"], "DENIED by the user"), "denegada → el agente no lo ejecuta y lo informa: " + slice(den[0]["text"], 0, 70))
let apr be parallel_map(approval_job, [{"kind": "ask", "key": kb["key"], "body": {"to": "rt-ask", "thread": "api:aprob-2", "text": "riesgo-suave"}}, {"kind": "human", "decision": true}])
check(apr[1] != nothing and contains(apr[0]["text"], "aprobado") and not contains(apr[0]["text"], "DENIED"), "aprobada → se ejecuta y el agente ve la salida: " + slice(apr[0]["text"], 0, 70))
let hist be json_decode(text(http_get("http://127.0.0.1:47990/w/test/api/approvals", {}, nothing, 10)["body"]))["approvals"]
check(length(where(hist, (x) => x["id"] == den[1]["id"] and x["status"] == "denied")) == 1 and length(where(hist, (x) => x["id"] == apr[1]["id"] and x["status"] == "approved")) == 1, "y la cola registra denied / approved")
set created to append(created, den[0]["session"])
set created to append(created, apr[0]["session"])
rm_file(ADIR + "/rt-ask.agent.json")

print("límites por key: rate limit (429 + Retry-After) y callbacks solo a URLs permitidas")
let kr be apikeys.create_with("test-rate", ["rt-api"], {"rate": 3})
let codes be []
let rl_headers be {}
let ri be 0
while ri < 4
    set ri to ri + 1
    let rr be http_get(BASE + "/agents", {"Authorization": "Bearer " + kr["key"]}, nothing, 10)
    set codes to append(codes, rr["status"])
    when rr["status"] == 429
        set rl_headers to when contains(rr, "headers") then rr["headers"] otherwise {}
check(codes == [200, 200, 200, 429], "rate 3/min: el cuarto pedido → 429 (" + json_encode(codes) + ")")
let ra_val be ""
each hk in keys(rl_headers)
    when lower(hk) == "retry-after"
        set ra_val to text(rl_headers[hk])
check(ra_val != "" and int(ra_val) > 0 and int(ra_val) <= 60, "con Retry-After: " + ra_val + " s")
check(http_get(BASE + "/agents", {"Authorization": "Bearer " + kb["key"]}, nothing, 10)["status"] == 200, "el límite es por key: otra key sigue entrando")
let kc be apikeys.create_with("test-cb", ["rt-buf"], {"callbacks": ["http://127.0.0.1:8767/"]})
check(post("/messages", {"to": "rt-buf", "thread": "api:cb-allowed", "text": "hola", "callback": "http://127.0.0.1:9/otro"}, kc)["status"] == 403, "callback a una URL fuera de la lista → 403")
check(post("/messages", {"to": "rt-buf", "thread": "api:cb-allowed", "text": "hola", "callback": "http://127.0.0.1:8767/cb"}, kc)["status"] == 202, "callback a un prefijo permitido → 202")
sleep(2.5)
apikeys.remove(kr["id"])
apikeys.remove(kc["id"])

print("revocar")
apikeys.remove(ka["id"])
check(http_get(BASE + "/agents", {"Authorization": "Bearer " + ka["key"]}, nothing, 10)["status"] == 401, "key revocada → 401")
check(apikeys.list() != nothing and length(where(apikeys.list(), (k) => k["id"] == ka["id"])) == 0, "ya no está en la lista")

print("equipos: A le escribe a B (send), el pulso del servidor le da el turno a B en su conversación del equipo")
db_open(teams.DB)
teams.tasks("team:rt-team")
each tb in ["tasks", "ledger", "messages", "cursors", "rounds"]
    sql_exec("DELETE FROM " + tb + " WHERE scope = 'team:rt-team'")
sql_exec("DELETE FROM spend WHERE agent LIKE 'rt-team-%'")
write_file(ADIR + "/rt-team-a.agent.json", json_encode({"id": "rt-team-a", "system": "Líder.", "tools": [], "permission": "strict", "buffer": false}))
write_file(ADIR + "/rt-team-b.agent.json", json_encode({"id": "rt-team-b", "system": "Dev.", "tools": [], "permission": "strict", "buffer": false}))
write_file(teams.DIR + "/rt-team.team.json", json_encode({"id": "rt-team", "members": [{"agent": "rt-team-a", "role": "Líder"}, {"agent": "rt-team-b", "role": "Dev", "reports_to": "rt-team-a"}, {"agent": "rt-team-c", "role": "Otro"}]}))
let ta be post("/messages", {"to": "rt-team-a", "thread": "api:equipo", "text": "avisa-equipo"}, kb)
check(ta["status"] == 200 and contains(ta["json"]["text"], "sent to rt-team-b"), "A usó send: " + ta["raw"])
let bdoc_t be nothing
let waited be 0
while bdoc_t == nothing and waited < 30
    sleep(1)
    set waited to waited + 1
    let bs be runtime.thread_session("rt-team-b", "team:rt-team")
    when bs != nothing and bs != "" and session.exists(bs)
        let d be session.load(bs)
        when length(where(d["messages"], (m) => m["role"] == "assistant" and contains(text(m["content"]), "final equipo-b"))) > 0
            set bdoc_t to d
check(bdoc_t != nothing, "B tuvo su turno en la conversación team:rt-team (" + text(waited) + " s)")
when bdoc_t != nothing
    let first_user be where(bdoc_t["messages"], (m) => m["role"] == "user")[0]["content"]
    check(starts_with(first_user, "[message from rt-team-a (Líder)]\nhola B, ¿tomás el login?") and contains(first_user, "[team rt-team] Since your last turn:"), "con el mensaje, quién lo manda y las novedades del equipo: " + slice(first_user, 0, 120))
    check(contains(text(bdoc_t["messages"][0]["content"]), "# Team rt-team") and contains(text(bdoc_t["messages"][0]["content"]), "You report to rt-team-a"), "su rol en el prompt")
    set created to append(created, runtime.thread_session("rt-team-b", "team:rt-team"))
let lg be teams.ledger("team:rt-team", 0, 20)
check(length(where(lg, (r) => r["kind"] == "message" and r["actor"] == "rt-team-a")) == 1 and length(where(lg, (r) => r["actor"] == "rt-team-c")) == 0, "en el registro el mensaje es de rt-team-a: el _agent que mandó el modelo no cuenta")
check(length(where(lg, (r) => r["kind"] == "added" and r["actor"] == "rt-team-b")) == 1, "B agregó su tarea al tablero")
check(length(where(teams.pending(), (m) => m["scope"] == "team:rt-team")) == 0, "no quedan mensajes por entregar")
check(teams.spent_today("rt-team-b") > 0, "el turno de B cuenta para su presupuesto: " + text(teams.spent_today("rt-team-b")))
set created to append(created, ta["json"]["session"])
rm_file(ADIR + "/rt-team-a.agent.json")
rm_file(ADIR + "/rt-team-b.agent.json")
rm_file(teams.DIR + "/rt-team.team.json")

-- limpieza
apikeys.remove(kb["id"])
purge_threads()
each id in created
    when id != nothing and id != ""
        when session.exists(id)
            session.delete(id)
when jid != ""
    rm_file(".lampson/api/jobs/" + jid + ".json")
rm_file(ADIR + "/rt-api.agent.json")
rm_file(ADIR + "/rt-api2.agent.json")
rm_file(ADIR + "/rt-buf.agent.json")
rm_file(ADIR + "/rt-mid.agent.json")

proc_close(web)
proc_close(cbs)
proc_close(mock)

when length(failures) > 0
    print("api_test: " + text(length(failures)) + " fallas")
    raise("api_test failed")
print("api_test: todo OK")
