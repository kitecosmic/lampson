-- lib/apptools.syn — herramientas de una app escritas en Synsema: una carpeta, un archivo por herramienta
--
--   <proyecto>/.lampson/tools/            (o LAMPSON_TOOLS_DIR, relativa al proyecto: la opción `tools` del SDK)
--     README.md              cuándo usarlas: va al prompt de los agentes que las tienen
--     estado_pedido.syn      1 archivo = 1 herramienta = `export task estado_pedido(…)`; el nombre del archivo es el
--     _comun.syn             nombre de la tool. Los que empiezan con _ son ayudantes (`use "./_comun.syn"`), no tools
--
-- Del archivo sale todo, sin manifiesto (`synsema code outline --json`, sin ejecutarlo): la descripción es su
-- `intent:`, los parámetros los de la firma (un default la vuelve opcional), y su techo son sus `require` de arriba
-- — lo que el archivo no declara, Synsema se lo niega. `synsema test` corre sus `test`.
--
-- Una llamada = `synsema run -` con cwd = la carpeta de las tools: el archivo tal cual por stdin y, DEBAJO (así los
-- números de línea de un error son los del archivo), una línea que lee los argumentos y otra que llama a su task
-- con `call` (los permisos del programa = sus `require`; call_tool exigiría que el task los repita). No se escribe
-- nada en la carpeta del dev. Por qué así (2026-10-18, Synsema 0.6.44): un módulo importado con `use` no puede tener
-- `require` arriba, y `use` solo acepta rutas relativas al archivo que importa, dentro de su carpeta.
--
-- Techo del proceso (2026-10-19): `synsema run --no-env-file --cap-set <sus require>` — el .env de la carpeta no se
-- carga y lo que no está en los `require` de arriba del archivo lo niega el motor, aunque se escriba dentro de un
-- task. `env(…)` solo con nombres exactos, y nada que empiece con LAMPSON_ salvo LAMPSON_CTX: el proceso hijo hereda
-- el entorno de Lampson (las keys de los proveedores, el secreto del webhook) y `env("*")` lo leía entero.
--
-- Contexto de confianza: la herramienta que declara `require env("LAMPSON_CTX")` recibe ahí {from, thread, agent,
-- session, meta, channel} del sobre — lo pone la app, el modelo no lo ve ni lo escribe. Sus argumentos sí los escribe
-- el modelo: validarlos siempre.
--
-- Aprobación (2026-10-19): cada archivo de la carpeta (herramientas, ayudantes _*.syn y el README.md) corre o
-- entra al prompt solo si su sha256 es el que aprobó el humano: `lampson tools approve [nombre]`. Lo guardado vive
-- en .lampson/ del proceso del workspace, donde las tools de archivos del agente no llegan. Así, un agente que
-- reescribe una herramienta (por un alias de ruta, un bash disfrazado…) no le sube el techo: deja de correr hasta
-- que alguien mira el cambio. Con LAMPSON_APPROVE_TOOLS=1 (el SDK en modo local con approveTools: true: quien
-- edita es el dev) se aprueba solo.
--
-- Autorización: estar en la carpeta, aprobada, y en la lista de tools del agente. Pasan en cualquier modo;
-- "approve": "ask" en el agente las hace pedir, y una que declara `require spend(…)` pide siempre (runtime.opts_for).

export let MARK be "apptool"
let DEFAULT_DIR be ".lampson/tools"
let CACHE be ".lampson/apptools.json"
let APPROVED be ".lampson/apptools_approved.json"
let TIMEOUT be 60
let MAX_OUT be 60000
let MAX_README be 12000
-- el hash de toda la carpeta corre en cada escaneo (varias veces por turno): un .syn de 1 GB o un node_modules copiado
-- ahí harían lento cada turno de todos. Pasado el tope, las herramientas se frenan (no se cachea por fecha: con bash,
-- la fecha se vuelve atrás)
let MAX_FILE_BYTES be 1000000
let MAX_TOTAL_BYTES be 5000000
let MAX_FILES be 500
let MAX_ENTRIES be 5000
let MEMO_SECONDS be 3
-- nombres que ya usa Lampson: una herramienta del dev no puede pisarlos
export let TAKEN be ["read", "write", "edit", "ls", "find", "grep", "lsp", "fetch", "bash", "process", "memory", "todo", "skill", "mcp", "plugin", "schedule", "computer_use", "delegate", "send", "board", "objective"]

-- la carpeta, relativa al cwd del proceso (workspace/… es el proyecto). LAMPSON_TOOLS_DIR no puede salir del proyecto.
export task dir()
    require env("LAMPSON_*")
    let d be trim(replace(env("LAMPSON_TOOLS_DIR", ""), "\\", "/"))
    when d == "" or starts_with(d, "/") or contains(d, ":") or contains(split(d, "/"), "..")
        give "workspace/" + DEFAULT_DIR
    while ends_with(d, "/")
        set d to slice(d, 0, length(d) - 1)
    give "workspace/" + d

task synsema_exe()
    require env("LAMPSON_*")
    give env("LAMPSON_SYNSEMA", "synsema")

-- un proceso con plazo → {code, out, err}; stdin opcional (texto que se manda y se cierra)
task run_proc(argv, cwd, envs, stdin_text, t)
    require exec
    require time
    let p be proc_spawn(synsema_exe(), argv, {"cwd": cwd, "env": envs, "on_full": "drop_oldest"})
    when stdin_text != nothing
        proc_send(p, stdin_text)
    proc_close_stdin(p)
    let deadline be now() + t
    let out be []
    let errs be []
    let code be nothing
    let timed_out be false
    while code == nothing and not timed_out
        let left be deadline - now()
        when left <= 0
            set timed_out to true
        otherwise
            let ev be proc_recv(p, when left < 0.2 then 0.2 otherwise left)
            when ev == nothing
                set timed_out to now() >= deadline
            otherwise when ev["type"] == "exit"
                set code to ev["data"]["exit_code"]
            otherwise when ev["type"] == "stderr"
                set errs to append(errs, ev["data"])
            otherwise
                set out to append(out, ev["data"])
    proc_close(p)
    give {"code": code, "timed_out": timed_out, "out": join(out, "\n"), "err": join(errs, "\n")}

-- parámetros de la firma, leídos del archivo: "id, incluir_items = false" → [{name, optional, type}]
task signature(src, name)
    let out be []
    let m be regex_capture(src, "export\\s+task\\s+" + name + "\\s*\\(([^)]*)\\)")
    when m == nothing
        give out
    each raw in split(m[0], ",")
        let p be trim(raw)
        when p != ""
            let parts be split(p, "=")
            let pn be trim(parts[0])
            let dv be when length(parts) > 1 then trim(join(slice(parts, 1, length(parts)), "=")) otherwise ""
            let ty be when dv == "true" or dv == "false" then "boolean" otherwise (when starts_with(dv, "\"") then "string" otherwise (when matches(dv, "-?[0-9]+(\\.[0-9]+)?") then "number" otherwise (when starts_with(dv, "[") then "array" otherwise (when starts_with(dv, "{") then "object" otherwise ""))))
            set out to append(out, {"name": pn, "optional": length(parts) > 1, "type": ty})
    give out

-- una entrada a partir de su archivo → {name, file, description, params, requires, ctx, spend, error}
task load_one(d, file)
    require exec
    require time
    require file("workspace")
    require file("workspace/*")
    let name be slice(file, 0, length(file) - 4)
    let e be {"name": name, "file": file, "description": "", "params": [], "requires": [], "ctx": false, "spend": false, "error": nothing}
    when not matches(name, "[a-z][a-z0-9_]{0,39}")
        set e["error"] to "the file name is the tool name: lowercase letters, digits and _ (max 40), starting with a letter"
        give e
    when contains(TAKEN, name) or starts_with(name, "plugin_") or starts_with(name, "mcp_")
        set e["error"] to "'" + name + "' is a name Lampson already uses: rename the file"
        give e
    let r be run_proc(["code", "outline", file, "--json"], d, {}, nothing, 20)
    let doc be json_decode(r["out"], nothing)
    when doc == nothing or type_of(doc) != "map" or length(field_list(doc, "files")) == 0
        set e["error"] to "synsema code outline failed: " + trim(r["err"] + " " + r["out"])
        give e
    let f be doc["files"][0]
    when f["parse_error"] != nothing
        set e["error"] to "does not parse (line " + text(f["parse_error"]["line"]) + "): " + text(f["parse_error"]["message"])
        give e
    let sym be where(field_list(f, "symbols"), (s) => s["kind"] == "task" and s["name"] == name)
    when length(sym) == 0 or not sym[0]["exported"]
        set e["error"] to "needs `export task " + name + "(…)` — the task with the file's name is the tool"
        give e
    when f["intent"] == nothing or trim(text(f["intent"])) == ""
        set e["error"] to "needs an `intent: \"…\"` line: it is the description the model sees"
        give e
    set e["description"] to text(f["intent"])
    set e["requires"] to apply((q) => {"cap": text(q["cap"]), "scope": when q["scope"] == nothing then "" otherwise text(q["scope"])}, field_list(f, "requires"))
    each q in e["requires"]
        when q["cap"] == "env" and (not matches(q["scope"], "[A-Za-z_][A-Za-z0-9_]*") or (starts_with(q["scope"], "LAMPSON_") and q["scope"] != "LAMPSON_CTX"))
            set e["error"] to "require env(\"" + q["scope"] + "\"): name each variable exactly; LAMPSON_* is Lampson's own (only LAMPSON_CTX is for tools)"
            give e
        when contains(q["scope"], ",")
            set e["error"] to "require " + q["cap"] + "(\"" + q["scope"] + "\"): a scope with a comma cannot be passed to the tool's ceiling"
            give e
    set e["ctx"] to length(where(e["requires"], (q) => q["cap"] == "env" and q["scope"] == "LAMPSON_CTX")) > 0
    set e["spend"] to length(where(e["requires"], (q) => q["cap"] == "spend")) > 0
    let src be ""
    try
        set src to read_file(d + "/" + file)
    recover err
        set src to ""
    set e["params"] to signature(src, name)
    give e

task field_list(m, k)
    when type_of(m) == "map" and contains(m, k) and type_of(m[k]) == "list"
        give m[k]
    give []

task digest(path)
    give decode(sha256(read_file(path)), "hex")

task approved_map()
    try
        let m be json_decode(read_file(APPROVED))
        give when type_of(m) == "map" then m otherwise {}
    recover err
        give {}

-- un recorrido de la carpeta → {files, links, sizes, over}. files: TODA .syn de la carpeta y sus subcarpetas (una
-- herramienta puede `use "./sub/h.syn"` o `use "./otra.syn"`) y el README.md de arriba, que va al prompt; rutas
-- relativas a la carpeta. links: links a carpetas (junction, symlink): `use "./ext/o.syn"` los atraviesa (el chequeo
-- del motor es por el texto de la ruta) y list_dir no entra, así que lo de adentro nunca se aprobaría. list_dir los da
-- como archivo; file_info sigue el link y dice carpeta (Synsema 0.6.44 no tiene is_link). over: pasó el tope de
-- entradas o de .syn — se corta ahí, sin recorrer un node_modules entero en cada escaneo.
task walk(d)
    let acc be walk_into(d, "", {"files": [], "links": [], "sizes": {}, "seen": 0, "over": false})
    when file_exists(d + "/README.md")
        set acc["files"] to append(acc["files"], "README.md")
        set acc["sizes"]["README.md"] to file_info(d + "/README.md")["size"]
    set acc["files"] to sort(acc["files"])
    give acc

task walk_into(d, rel, acc)
    try
        each e in list_dir(d + (when rel == "" then "" otherwise "/" + rel))
            when not acc["over"]
                set acc["seen"] to acc["seen"] + 1
                let p be when rel == "" then e["name"] otherwise rel + "/" + e["name"]
                when acc["seen"] > MAX_ENTRIES or length(acc["files"]) > MAX_FILES
                    set acc["over"] to true
                otherwise when e["is_dir"]
                    set acc to walk_into(d, p, acc)
                otherwise
                    let fi be file_info(d + "/" + p)
                    when fi["is_dir"]
                        set acc["links"] to append(acc["links"], p)
                    otherwise when ends_with(e["name"], ".syn")
                        set acc["files"] to append(acc["files"], p)
                        set acc["sizes"][p] to when fi["size"] == nothing then 0 otherwise fi["size"]
    recover err
        give acc
    give acc

task watched(d)
    give walk(d)["files"]

-- {archivo: "ok" | "new" | "changed" | "unreadable" | "too_big" | "link" | "missing"}. Lo que no se puede leer (una
-- junction llamada x.syn, un archivo bloqueado) frena las herramientas pero no el resto: sin el try, tumbaba
-- registry_of de TODOS los agentes. "missing" (aprobado y borrado) solo se muestra: borrar no hace correr nada sin
-- aprobar (si vuelve con otro contenido, el hash guardado da "changed"). (approveTools del SDK aprueba UNA vez, al
-- arrancar `run --stdio`: lo que cambie después, aunque sea el agente, sigue el camino normal.)
--
-- Una vez por turno: el escaneo corre varias veces (registry_of, catalog_of, opts_for, missing), así que el
-- resultado se reusa unos segundos mientras la carpeta tenga los mismos archivos, tamaños y fechas. Pasado ese rato se
-- vuelve a leer todo; y `call` compara siempre el hash del archivo que va a correr.
export task approval()
    require exec
    require time
    require file(".lampson")
    require file(".lampson/*")
    require file("workspace")
    require file("workspace/*")
    require env("LAMPSON_*")
    let d be dir()
    let w be walk(d)
    let ok be approved_map()
    let fp be json_encode([d, w["files"], w["links"], w["over"], apply((f) => text(file_info(d + "/" + f)["modified"]), w["files"]), w["sizes"], ok])
    let key be "apptools:approval"
    observe key as memo
    when memo != nothing and memo["fp"] == fp and now() - memo["at"] < MEMO_SECONDS
        give memo["st"]
    let st be compute_approval(d, w, ok)
    share {"fp": fp, "at": now(), "st": st} as key
    give st

task compute_approval(d, w, ok)
    when w["over"]
        give {"(more than " + text(MAX_FILES) + " .syn or " + text(MAX_ENTRIES) + " entries)": "too_big"}
    let total be 0
    each f in w["files"]
        set total to total + w["sizes"][f]
    when total > MAX_TOTAL_BYTES
        give {"(" + text(total) + " bytes in total)": "too_big"}
    let out be {}
    each f in w["files"]
        try
            when w["sizes"][f] > MAX_FILE_BYTES
                raise("too big")
            let h be digest(d + "/" + f)
            set out[f] to when not contains(ok, f) then "new" otherwise (when ok[f] == h then "ok" otherwise "changed")
        recover err
            set out[f] to when contains(text(err), "too big") then "too_big" otherwise "unreadable"
    each f in keys(ok)
        when not contains(w["files"], f) and f != "README.md"
            set out[f] to "missing"
    each l in w["links"]
        set out[l] to "link"
    give out

-- aprobar lo que está ahora en la carpeta: un archivo (`estado_pedido` o `_comun.syn`) o, con "", todos → los que cambió
export task approve(name)
    require file(".lampson")
    require file(".lampson/*")
    require file("workspace")
    require file("workspace/*")
    require env("LAMPSON_*")
    let d be dir()
    let ok be approved_map()
    let done be []
    let wk be walk(d)
    when wk["over"]
        give ["(the tools folder is over the limit: " + text(MAX_FILES) + " .syn or " + text(MAX_ENTRIES) + " entries; nothing approved)"]
    let here be wk["files"]
    -- los aprobados que ya no están (el dev los borró): fuera, con "" (aprobar todo) o nombrándolos
    let kept be {}
    each f in keys(ok)
        when contains(here, f) or (name != "" and f != name and f != name + ".syn")
            set kept[f] to ok[f]
        otherwise
            set done to append(done, f + " (removed)")
    set ok to kept
    each f in here
        when name == "" or f == name or f == name + ".syn"
            try
                when file_info(d + "/" + f)["size"] > MAX_FILE_BYTES
                    raise("too big")
                let h be digest(d + "/" + f)
                when not contains(ok, f) or ok[f] != h
                    set ok[f] to h
                    set done to append(done, f)
            recover err
                set done to append(done, f + " (cannot be read: not approved)")
    write_file(APPROVED, json_encode(ok))
    give done

-- regla global: si CUALQUIER .syn de la carpeta no está aprobada, ninguna herramienta corre ("si algo cambió, nada
-- corre hasta que lo mires"): mirar qué importa cada una, transitivamente, es más código para un caso raro
task gate(e, st)
    when e["error"] != nothing
        give e
    let bad be where(sort(keys(st)), (f) => st[f] != "ok" and st[f] != "missing" and f != "README.md")
    when length(bad) > 0
        let own be where(bad, (f) => f == e["file"])
        let f be when length(own) > 0 then own[0] otherwise bad[0]
        when st[f] == "link"
            set e["error"] to "links are not allowed in the tools folder: " + f + " (a `use` would run what is behind it, never approved). Replace it with the real files and run `lampson tools approve`"
            give e
        set e["error"] to (when f == e["file"] then f otherwise "the tools folder's " + f) + (when st[f] == "new" then " is not approved yet" otherwise (when st[f] == "unreadable" then " cannot be read (a link, or locked)" otherwise (when st[f] == "too_big" then " is over the limit (" + text(MAX_FILE_BYTES) + " bytes per file, " + text(MAX_TOTAL_BYTES) + " in total, " + text(MAX_FILES) + " .syn files)" otherwise " changed since it was approved"))) + ": review it and run `lampson tools approve " + (when f == e["file"] then e["name"] otherwise f) + "` (it can touch: " + ceiling(e) + ")"
    give e

-- todas las herramientas de la carpeta, con la aprobación al día (también las rotas o sin aprobar, con su error).
-- Es la puerta de names/get/catalog: si algo de la carpeta falla de una forma que no vimos, es "no hay herramientas
-- .syn" y un aviso, nunca un error que llegue a registry_of y deje sin turno a todos los agentes.
export task scan()
    require exec
    require time
    require file(".lampson")
    require file(".lampson/*")
    require file("workspace")
    require file("workspace/*")
    require env("LAMPSON_*")
    try
        let st be approval()
        let out be apply((e) => gate(e, st), scan_files())
        observe "apptools:error" as prev
        when prev != nothing and prev != ""
            share "" as "apptools:error"
        give out
    recover err
        let msg be text(err)
        observe "apptools:error" as prev
        when prev != msg
            eprint("lampson: app tools skipped (" + dir() + "): " + msg)
            share msg as "apptools:error"
        give []

-- todas las herramientas de la carpeta (también las rotas, con su error). Caché en disco por nombre+tamaño+fecha.
export task scan_files()
    require exec
    require time
    require file(".lampson")
    require file(".lampson/*")
    require file("workspace")
    require file("workspace/*")
    require env("LAMPSON_*")
    let d be dir()
    let files be []
    try
        each e in list_dir(d)
            when not e["is_dir"] and ends_with(e["name"], ".syn") and not starts_with(e["name"], "_")
                set files to append(files, e["name"])
    recover err
        give []
    when length(files) == 0
        give []
    set files to sort(files)
    -- v2: load_one valida los env (2026-10-19); una caché vieja no los revisó
    let sig be "v2|" + d
    each fl in sort(apply((e) => e["name"], where(list_dir(d), (e) => not e["is_dir"])))
        let fi be file_info(d + "/" + fl)
        set sig to sig + "|" + fl + ":" + text(fi["size"]) + ":" + text(fi["modified"])
    try
        let c be json_decode(read_file(CACHE))
        when c["sig"] == sig
            give c["tools"]
    recover err
        set sig to sig
    let out be apply((fl) => load_one(d, fl), files)
    try
        write_file(CACHE, json_encode({"sig": sig, "tools": out}))
    recover err
        set sig to sig
    give out

-- por qué no se pudo leer la carpeta en el último escaneo ("" si se pudo): runtime.missing lo dice en vez de
-- «not a known tool»
export task load_error()
    observe "apptools:error" as e
    give when e == nothing then "" otherwise text(e)

export task names()
    require exec
    require time
    require file(".lampson")
    require file(".lampson/*")
    require file("workspace")
    require file("workspace/*")
    require env("LAMPSON_*")
    give apply((e) => e["name"], where(scan(), (e) => e["error"] == nothing))

export task get(name)
    require exec
    require time
    require file(".lampson")
    require file(".lampson/*")
    require file("workspace")
    require file("workspace/*")
    require env("LAMPSON_*")
    let f be where(scan(), (e) => e["name"] == name)
    give when length(f) == 0 then nothing otherwise f[0]

-- el esquema que ve el modelo: sin tipos en la firma (Synsema 0.6.44 no los tiene), el tipo sale del default si hay
task schema(e)
    let props be {}
    let req be []
    each p in e["params"]
        set props[p["name"]] to when p["type"] != "" then {"type": p["type"]} otherwise {}
        when not p["optional"]
            set req to append(req, p["name"])
    give {"type": "object", "properties": props, "required": req}

-- el techo del proceso: sus require + leer los argumentos + escribir la respuesta
task cap_set(e)
    let caps be ["stdout", "env=LAMPSON_TOOL_ARGS"]
    each q in e["requires"]
        set caps to append(caps, q["cap"] + (when q["scope"] != "" then "=" + q["scope"] otherwise ""))
    give join(caps, ",")

-- techo legible: "net(api.mitienda.com), env(LAMPSON_CTX)" — lo que puede tocar, para el catálogo y los avisos
export task ceiling(e)
    when length(e["requires"]) == 0
        give "nothing outside itself"
    give join(apply((q) => q["cap"] + (when q["scope"] != "" then "(" + q["scope"] + ")" otherwise ""), e["requires"]), ", ")

export task catalog(allowed_names)
    require exec
    require time
    require file(".lampson")
    require file(".lampson/*")
    require file("workspace")
    require file("workspace/*")
    require env("LAMPSON_*")
    let out be []
    each e in scan()
        when e["error"] == nothing and contains(allowed_names, e["name"])
            set out to append(out, {"name": e["name"], "description": e["description"], "parameters": schema(e)})
    give out

-- el README de la carpeta, para el prompt de un agente que tiene alguna de estas tools
export task instructions(tool_names)
    require exec
    require time
    require file(".lampson")
    require file(".lampson/*")
    require file("workspace")
    require file("workspace/*")
    require env("LAMPSON_*")
    let mine be where(names(), (n) => contains(tool_names, n))
    when length(mine) == 0
        give ""
    let st be {}
    try
        set st to approval()
    recover err
        give ""
    when not contains(st, "README.md") or st["README.md"] != "ok"
        give ""
    try
        let t be read_file(dir() + "/README.md")
        give "\n\n# Your app's tools\n" + slice(t, 0, MAX_README)
    recover err
        give ""

-- ejecutar una: el archivo por stdin + leer args + llamar; cwd = la carpeta (sus file(...) son relativos a ella)
export task call(name, args, ctx)
    require exec
    require time
    require file(".lampson")
    require file(".lampson/*")
    require file("workspace")
    require file("workspace/*")
    require env("LAMPSON_*")
    let e be get(name)
    when e == nothing
        give "ERROR: no tool named '" + name + "'"
    when e["error"] != nothing
        give "ERROR: tool '" + name + "' is broken: " + e["error"]
    let d be dir()
    let src be read_file(d + "/" + e["file"])
    let okm be approved_map()
    when not contains(okm, e["file"]) or okm[e["file"]] != decode(sha256(src), "hex")
        give "ERROR: tool '" + name + "' changed since it was approved: run `lampson tools approve " + name + "`"
    let prog be src + "\n\nrequire env(\"LAMPSON_TOOL_ARGS\")\nlet __lampson_r be call(" + name + ", json_decode(env(\"LAMPSON_TOOL_ARGS\")))\nprint(when type_of(__lampson_r) == \"text\" then __lampson_r otherwise json_encode(__lampson_r))\n"
    let envs be {"LAMPSON_TOOL_ARGS": json_encode(when args == nothing then {} otherwise args)}
    when e["ctx"]
        set envs["LAMPSON_CTX"] to json_encode(when ctx == nothing then {} otherwise ctx)
    let r be run_proc(["run", "--no-env-file", "--cap-set", cap_set(e), "-"], d, envs, prog, TIMEOUT)
    let out be trim(r["out"] + (when trim(r["err"]) != "" then "\n" + r["err"] otherwise ""))
    when r["timed_out"]
        give "ERROR: tool '" + name + "' timed out after " + text(TIMEOUT) + "s (killed). Output so far:\n" + slice(out, 0, MAX_OUT)
    when r["code"] != 0
        give "ERROR: " + regex_replace(slice(out, 0, MAX_OUT), "<stdin>", e["file"])
    give when out == "" then "(no output)" otherwise slice(out, 0, MAX_OUT)
