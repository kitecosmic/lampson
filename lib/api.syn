-- lib/api.syn — la API HTTP /v1 de un workspace (spec/engine.md, fase 2). Las rutas viven en web.syn; acá la lógica.
--
--   GET  /w/<slug>/v1/agents        los agentes que la key puede usar
--   POST /w/<slug>/v1/messages      un sobre → respuesta. Tres formas:
--        {"to", "thread", "text", "images", "from", "meta"}               → JSON con el resultado (espera el turno)
--        … + "stream": true                                             → SSE: los mismos eventos que `lampson run --json`
--        … + "callback": "https://…"                                     → 202 {job} enseguida; el resultado va por POST
--                                                                         al callback (canal `http`: WhatsApp, n8n…)
--   GET  /w/<slug>/v1/jobs/<id>     estado de un trabajo asíncrono
--
-- Auth: SIEMPRE `Authorization: Bearer lk_…` (lib/apikeys.syn), también por loopback: el hub reenvía /v1 sin pedir
-- passkey y este proceso confía en todo lo que le llega del hub, así que la key es la única puerta.
-- Todo mensaje pasa por el buzón de su conversación (lib/mailbox.syn): fila por (agente, thread), espera de silencio
-- ("buffer" del agente; default 3 s / tope 15 s) y lo que llega a mitad de turno entra al turno en curso. Los
-- mensajes de una ráfaga reciben la MISMA respuesta, con "batch" (ids del lote) y "lead" (el que lo encabeza).
-- Permisos: el modo del agente, o strict si no dice. En `ask`, la aprobación sale por la cola de lib/approvals.syn
-- (UI, link firmado al webhook, /approve en la terminal) y vence → denegado. Nunca se auto-aprueba.
-- Callback: UN POST por lote y URL: {job, jobs, batch, status, agent, thread, session, text, steps, usage, stopped,
-- meta}; con LAMPSON_WEBHOOK_SECRET va firmado (X-Lampson-Signature: sha256=<hmac hex>). Los demás jobs del lote
-- quedan "merged" (merged_into = el que encabeza).

use "./runtime.syn" as runtime
use "./apikeys.syn" as apikeys
use "./mailbox.syn" as mailbox
use "./teams.syn" as teams
use "./schedule.syn" as schedule
use "./worktree.syn" as worktree
use "./diagnose.syn" as diagnose
use "./sdktools.syn" as sdktools
use "./apptools.syn" as apptools
use "./tools/url.syn" as urls


-- la key del header Authorization (o nothing)
export task bearer_of(h)
    let a be ""
    each k in keys(h)
        when lower(k) == "authorization"
            set a to text(h[k])
    when starts_with(lower(a), "bearer ")
        give trim(slice(a, 7, length(a)))
    give nothing

-- {ok, key, status, error}: la key válida, o por qué no
export task authorize(h)
    require time
    require file(".lampson")
    require file(".lampson/**")
    let rec be apikeys.check(bearer_of(h))
    when rec == nothing
        give {"ok": false, "key": nothing, "status": 401, "error": "missing or invalid API key (Authorization: Bearer lk_…; create one with `lampson key add`)", "retry_after": 0}
    -- rate limit por key: ventana de un minuto (estado de serve, compartido por todos los handlers)
    when rec["rate"] > 0
        let win be floor(now() / 60)
        let n be state_incr("rl:" + rec["id"] + ":" + text(win), 1)
        when n == 1
            state_delete("rl:" + rec["id"] + ":" + text(win - 1))
        when n > rec["rate"]
            give {"ok": false, "key": rec, "status": 429, "error": "rate limit: " + text(rec["rate"]) + " requests per minute for this API key", "retry_after": 60 - floor(now() - win * 60)}
    give {"ok": true, "key": rec, "status": 200, "error": "", "retry_after": 0}

-- la respuesta de error de authorize (429 con Retry-After)
export task refuse(a)
    let r be fail(a["status"], a["error"])
    when a["status"] == 429
        give with_header(r, "Retry-After", text(a["retry_after"]))
    give r

-- los agentes que esta key puede usar: [{id, description}]
export task agents_for(rec)
    require file.read("workspace")
    require file.read("workspace/**")
    require file.read("agents")
    require file.read("agents/**")
    let out be []
    each id in runtime.names()
        when apikeys.allows(rec, id)
            set out to append(out, {"id": id, "description": runtime.get(id)["description"]})
    give out

-- la sesión de un asiento en un objetivo: la que quedó anotada; si no hay (objetivos de antes), la del thread
task pick_session(own, thread_sid)
    give when own != "" then own otherwise thread_sid

task field(m, k, fallback)
    when contains(m, k)
        when m[k] != nothing
            give m[k]
    give fallback

-- {ok, sobre, callback, stream, status, error}: el body de POST /v1/messages ya validado contra la key
export task parse(body, rec)
    require env("LAMPSON_*")
    require file.read("workspace")
    require file.read("workspace/**")
    require file.read("agents")
    require file.read("agents/**")
    when body == nothing or type_of(body) != "map"
        give {"ok": false, "status": 400, "error": "body must be a JSON object"}
    let msg be text(field(body, "text", ""))
    when trim(msg) == ""
        give {"ok": false, "status": 400, "error": "text is required"}
    let target be lower(text(field(body, "to", runtime.default_agent())))
    when not contains(runtime.names(), target)
        give {"ok": false, "status": 404, "error": "no agent named '" + target + "'"}
    when not apikeys.allows(rec, target)
        give {"ok": false, "status": 403, "error": "this API key cannot use agent '" + target + "'"}
    let cb be text(field(body, "callback", ""))
    when cb != "" and not (starts_with(cb, "https://") or starts_with(cb, "http://"))
        give {"ok": false, "status": 400, "error": "callback must be an http(s) URL"}
    when cb != "" and not apikeys.callback_allowed(rec, cb)
        give {"ok": false, "status": 403, "error": "this API key cannot send callbacks to " + cb + (when length(field(rec, "callbacks", [])) > 0 then " (allowed: " + join(rec["callbacks"], ", ") + ")" otherwise ": this API key has no callback list; create one with `lampson key add --callback URL`")}
    let images be field(body, "images", [])
    when type_of(images) != "list"
        set images to []
    let from be field(body, "from", {})
    when type_of(from) != "map"
        set from to {}
    let meta be field(body, "meta", {})
    when type_of(meta) != "map"
        set meta to {}
    -- la hora en que el cliente escribió (unix s), si el canal la da: ordena una ráfaga que llegó desordenada
    when contains(body, "sent_at") and body["sent_at"] != nothing
        set meta["sent_at"] to body["sent_at"]
    let sobre be {"to": target, "thread": text(field(body, "thread", "")), "session": text(field(body, "session", "")), "from": from, "text": msg, "images": images, "channel": text(field(body, "channel", "http")), "meta": meta}
    -- funciones de la app (lib/remotetools.syn): viajan en el mensaje, sin estado en Lampson. tools_url tiene que
    -- estar en la lista de callbacks de la key (obligatoria acá: sin lista no hay tools_url) y ser https salvo loopback
    let rt be field(body, "tools", nothing)
    when rt != nothing
        let tu be text(field(body, "tools_url", ""))
        when tu == ""
            give {"ok": false, "status": 400, "error": "tools needs tools_url: the URL where your app answers the tool calls"}
        let tp be urls.parse(tu)
        when not tp["ok"] or contains(tu, "#") or (tp["scheme"] != "https" and not urls.is_loopback(tp["host"]))
            give {"ok": false, "status": 400, "error": "tools_url must be an https URL without #fragment (http only for localhost)"}
        when length(field(rec, "callbacks", [])) == 0 or not apikeys.callback_allowed(rec, tu)
            give {"ok": false, "status": 403, "error": "this API key cannot call tools at " + tu + ": add it to the key's list (`lampson key add --callback URL`)"}
        when apikeys.signing_secret(rec["id"]) == ""
            give {"ok": false, "status": 403, "error": "this API key predates per-key signing secrets: create a new one to use app tools"}
        let nt be sdktools.normalize(rt)
        when length(nt["errors"]) > 0
            give {"ok": false, "status": 400, "error": join(nt["errors"], "; ")}
        let clash be where(nt["tools"], (t) => contains(apptools.names(), t["name"]))
        when length(clash) > 0
            give {"ok": false, "status": 400, "error": "tool '" + clash[0]["name"] + "' already exists as a Synsema tool of this project (.lampson/tools/)"}
        set sobre["tools"] to nt["tools"]
        set sobre["tools_url"] to tu
        set sobre["tools_key"] to rec["id"]
    set sobre to scope_sobre(sobre, rec)
    -- retomar una sesión: solo una de esta key. Una ajena (otra app, la web del dueño, un equipo) es 404, no una
    -- sesión nueva callada: la app creería que siguió la conversación
    when sobre["session"] != "" and runtime.session_space(sobre["session"]) != sobre["space"]
        give {"ok": false, "status": 404, "error": "no such session: " + sobre["session"]}
    give {"ok": true, "status": 200, "error": "", "sobre": sobre, "callback": cb, "stream": field(body, "stream", false) == true}

-- la conversación es de la key que la empezó: por dentro el thread es "key:<id>:<thread>" y la app sigue viendo el
-- suyo (shown_thread). Antes, dos apps con el mismo thread compartían historial y lote: la de B corría con las
-- herramientas y el `from` de A (2026-10-19). Tampoco puede escribir en "team:…" u "objective:…".
export task space_of(rec)
    give "key:" + text(rec["id"]) + ":"

task scope_sobre(sobre, rec)
    set sobre["space"] to space_of(rec)
    when sobre["thread"] != ""
        set sobre["shown_thread"] to sobre["thread"]
        set sobre["thread"] to space_of(rec) + sobre["thread"]
    give sobre

-- el modo de un agente por la API: el suyo, y si no dice → strict (nadie en la request para preguntarle)
export task mode_for(spec)
    give when spec != nothing and spec["permission"] != "" then "" otherwise "strict"

-- opts del buzón (lib/mailbox.syn) para un sobre ya validado
export task mailbox_opts(sobre)
    require file.read("workspace")
    require file.read("workspace/**")
    require file.read("agents")
    require file.read("agents/**")
    let spec be runtime.get(sobre["to"])
    give {"mode": mode_for(spec), "buffer": mailbox.buffer_of(spec, mailbox.DEFAULT_BUFFER)}

-- registro de un trabajo con callback (lo completa el worker del buzón al entregar)
export task create_job(id, rec, sobre, callback)
    require time
    require file(".lampson")
    require file(".lampson/**")
    mailbox.save_job({"job": id, "status": "queued", "key": rec["id"], "agent": sobre["to"], "thread": get(sobre, "shown_thread", sobre["thread"]), "callback": callback, "created": format_time(now()), "result": nothing, "delivered": false, "merged_into": nothing})

export task job(id)
    require file.read(".lampson")
    require file.read(".lampson/**")
    give mailbox.job(id)

-- MCP por HTTP (lib/mcp_server.syn): un `ask` pasa por el buzón de su conversación. Entre agentes no hay espera de
-- silencio salvo que el agente la configure (`buffer`): la fila sí, siempre.
export task mcp_deliver(sobre, mode)
    require time
    require random
    require file.read("workspace")
    require file.read("workspace/**")
    require file.read("agents")
    require file.read("agents/**")
    let spec be runtime.get(sobre["to"])
    let s be mailbox.submit(sobre, {"mode": mode, "buffer": mailbox.buffer_of(spec, false)})
    give mailbox.wait(s["id"])


-- ---------- objetivos (lib/teams.syn) ----------
-- un objetivo con su tablero y su registro, como lo devuelve la API
export task objective_view(o)
    require db(".lampson/teams.db")
    require file(".lampson")
    require file(".lampson/**")
    require file.read("workspace")
    require file.read("workspace/**")
    let scope be teams.obj_scope(o)
    let team_obj be field(o, "team", "") != ""
    -- el tablero y el registro de un equipo son de todos sus objetivos: acá, solo lo de este (sus tareas; el registro
    -- de mientras estuvo abierto)
    let mine be when team_obj then where(teams.tasks(scope), (t) => field(t, "objective", 0) == o["id"]) otherwise teams.tasks(scope)
    let ts be apply(mine, (t) => {"id": t["id"], "title": t["title"], "status": t["status"], "owner": t["owner"], "notes": t["notes"], "depends": json_decode(t["depends"])})
    let closed be not contains(["active", "waiting", "paused"], o["status"])
    let rows be when team_obj then where(teams.ledger(scope, 0, 400), (r) => r["at"] >= o["created_at"] - 2 and (not closed or r["at"] <= o["updated_at"] + 60)) otherwise teams.ledger(scope, 0, 150)
    let lg be apply(slice(rows, 0, min(150, length(rows))), (r) => {"id": r["id"], "at": r["at"], "actor": r["actor"], "kind": r["kind"], "ref": r["ref"], "text": r["text"]})
    -- quién trabajó y dónde quedó cada paso: la sesión de cada asiento en la conversación del objetivo (la pantalla lee
    -- su traza con /api/trace y la recorta a la ventana del objetivo)
    let seats be []
    when team_obj
        let tm be teams.get(o["team"])
        when tm != nothing
            each m in tm["members"]
                set seats to append(seats, {"agent": m["agent"], "role": m["role"], "lead": m["agent"] == o["agent"], "today": teams.spent_today(m["agent"]), "cap": teams.cap_of(tm, m["agent"]), "session": pick_session(teams.seat_session_of(o["id"], m["agent"]), runtime.thread_session(m["agent"], scope))})
    otherwise
        set seats to [{"agent": o["agent"], "role": o["agent"], "lead": true, "session": runtime.thread_session(o["agent"], "objective:" + text(o["id"]))}]
    -- el pase entre equipos: de dónde vino, a quién lo pasó, a quién lo puede pasar
    let chain be json_decode(field(o, "chain", "[]"))
    let origin be when field(o, "from_obj", 0) > 0 then {"id": o["from_obj"], "ref": "O-" + text(o["from_obj"]), "team": when length(chain) > 0 then chain[length(chain) - 1] otherwise ""} otherwise nothing
    let passed be apply(teams.obj_children(o["id"]), (c) => {"id": c["id"], "ref": "O-" + text(c["id"]), "team": c["team"], "status": c["status"]})
    let pend be field(o, "pass_pending", "")
    give {"id": o["id"], "ref": "O-" + text(o["id"]), "agent": o["agent"], "team": o["team"], "text": o["text"], "status": o["status"], "progress": o["progress"], "question": o["question"], "question_kind": o["question_kind"], "result": o["result"], "turns": o["turns"], "spent": o["spent"], "budget_tokens": o["budget_tokens"], "round_seconds": o["round_seconds"], "created_at": o["created_at"], "updated_at": o["updated_at"], "created_by": o["created_by"], "tasks": ts, "ledger": lg, "seats": seats, "from": origin, "passed": passed, "pass_to": json_decode(field(o, "pass_to", "[]")), "pass_ask": field(o, "pass_ask", 0) == 1, "pass_pending": when pend == "" then nothing otherwise json_decode(pend)}

-- POST /v1/objectives: {agent, text, round_seconds?, budget_tokens?} → {ok, id} / {ok: false, status, error}
export task create_objective(body, rec)
    require db(".lampson/teams.db")
    require time
    require file(".lampson")
    require file(".lampson/**")
    require file.read("workspace")
    require file.read("workspace/**")
    require file.read("agents")
    require file.read("agents/**")
    let agent be lower(text(field(body, "agent", "")))
    let tid be lower(text(field(body, "team", "")))
    when tid != ""
        let tm be teams.get(tid)
        when tm == nothing
            give {"ok": false, "status": 404, "error": "no team named '" + tid + "'"}
        when agent == ""
            set agent to teams.lead_of(tm)
        when teams.member(tm, agent) == nothing
            give {"ok": false, "status": 400, "error": agent + " is not in team " + tid}
    when agent == ""
        give {"ok": false, "status": 400, "error": "agent (or team) is required"}
    when runtime.get(agent) == nothing
        give {"ok": false, "status": 404, "error": "no agent named '" + agent + "'"}
    when not apikeys.allows(rec, agent)
        give {"ok": false, "status": 403, "error": "this API key can't use agent '" + agent + "'"}
    when trim(text(field(body, "text", ""))) == ""
        give {"ok": false, "status": 400, "error": "text is required"}
    let opts be {"budget_tokens": field(body, "budget_tokens", 700000), "created_by": "api:" + rec["name"], "team": tid, "pass_ask": field(body, "pass_ask", false) == true}
    when field(body, "round_seconds", nothing) != nothing
        set opts["round_seconds"] to body["round_seconds"]
    let id be teams.obj_create(agent, field(body, "text", ""), opts)
    give {"ok": true, "id": id}

-- el objetivo si la key puede verlo (su agente), si no nothing
export task objective_for(id, rec)
    require db(".lampson/teams.db")
    require file(".lampson")
    require file(".lampson/**")
    let o be teams.obj_get(floor(number(id)))
    when o == nothing or not apikeys.allows(rec, o["agent"])
        give nothing
    give o


-- los equipos con su gente (rol, a quién reporta, si está trabajando ahora, lo gastado hoy), su tablero y su registro
export task teams_view()
    require db(".lampson/teams.db")
    require time
    require file(".lampson")
    require file(".lampson/**")
    require file.read("workspace")
    require file.read("workspace/**")
    require file.read("agents")
    require file.read("agents/**")
    let sc be teams.scan()
    let out be []
    each t in sc["teams"]
        let scope be "team:" + t["id"]
        let members be []
        each m in t["members"]
            let spec be runtime.get(m["agent"])
            set members to append(members, {"agent": m["agent"], "role": m["role"], "reports_to": m["reports_to"], "description": when spec == nothing then "" otherwise spec["description"], "system": when spec == nothing then "" otherwise spec["system"], "tools": when spec == nothing then [] otherwise spec["tools"], "permission": when spec == nothing then "" otherwise spec["permission"], "missing": spec == nothing, "working": mailbox.working(m["agent"], scope), "spent_today": teams.spent_today(m["agent"]), "daily_tokens": m["daily_tokens"], "cap": teams.cap_of(t, m["agent"]), "peers": teams.peers(t, m["agent"])})
        let ts be apply(teams.tasks(scope), (x) => {"id": x["id"], "title": x["title"], "status": x["status"], "owner": x["owner"], "notes": x["notes"], "depends": json_decode(x["depends"])})
        let lg be apply(teams.ledger(scope, 0, 150), (r) => {"id": r["id"], "at": r["at"], "actor": r["actor"], "kind": r["kind"], "ref": r["ref"], "text": r["text"]})
        set out to append(out, {"id": t["id"], "name": t["name"], "description": t["description"], "members": members, "talks": t["talks"], "round_minutes": t["round_minutes"], "budget_daily_tokens": t["budget_daily_tokens"], "worktrees": t["worktrees"], "lead": teams.lead_of(t), "tasks": ts, "ledger": lg})
    give {"teams": out, "errors": sc["errors"]}


-- guardar un equipo desde la pantalla: el archivo del equipo y los de sus agentes (los que vienen). Cada agente
-- conserva lo que su archivo ya tenía y pisa solo lo que se editó. → {ok, error}
export let TOOL_PRESETS be {"code": ["read", "write", "edit", "ls", "find", "grep", "bash", "todo"], "read": ["read", "ls", "find", "grep", "bash"], "none": []}

-- las aprobaciones, y en un merge o un push pendiente lo que va a pasar (rama, commits, archivos, si choca): se
-- aprueba sabiendo qué entra, no leyendo el comando
export task approvals_view(list)
    require exec
    require time
    require file("workspace")
    require file("workspace/**")
    let out be []
    each a in list
        let x be a
        when a["status"] == "pending" and contains(text(a["why"]), "shared history")
            try
                set x["preview"] to worktree.preview(a["message"])
            recover err
                set x["preview"] to nothing
        set out to append(out, x)
    give out

-- darle más tokens por hoy a un asiento: {agent, action: grant|reset, tokens?} → {ok, today, cap}
export task seat_tokens(body)
    require db(".lampson/teams.db")
    require time
    require file(".lampson")
    require file(".lampson/**")
    require file.read("workspace")
    require file.read("workspace/**")
    let agent be lower(text(field(body, "agent", "")))
    let ts be teams.teams_of(agent)
    when length(ts) == 0
        give {"ok": false, "error": "'" + agent + "' is not in any team"}
    let act be lower(text(field(body, "action", "grant")))
    when act != "grant" and act != "reset"
        give {"ok": false, "error": "action must be grant or reset"}
    let before be teams.spent_today(agent)
    let after be teams.seat_tokens(agent, act, field(body, "tokens", teams.cap_of(ts[0], agent)))
    each t in ts
        teams.log("team:" + t["id"], "person", "tokens", "", agent + ": " + (when act == "reset" then "today's count reset" otherwise "+" + text(before - after) + " tokens for today") + " (" + text(after) + " of " + text(teams.cap_of(t, agent)) + ")")
    give {"ok": true, "today": after, "cap": teams.cap_of(ts[0], agent)}

-- «Revisar qué pasa» en un objetivo de equipo: los hechos (sin IA), el análisis (con el modelo) y lo que la persona
-- hace desde ahí (escribirle a un asiento, mover una tarea)
export task obj_facts(o)
    require db(".lampson/teams.db")
    require time
    require file(".lampson")
    require file(".lampson/**")
    require file.read("workspace")
    require file.read("workspace/**")
    when field(o, "team", "") == ""
        give []
    give diagnose.facts(o)

export task obj_analyze(o)
    require db(".lampson/teams.db")
    require net
    require net("0.0.0.0/0")
    require net("::/0")
    require time
    require env("LAMPSON_*")
    require secret("LAMPSON_*")
    require file(".lampson")
    require file(".lampson/**")
    require file.read("workspace")
    require file.read("workspace/**")
    when field(o, "team", "") == ""
        give {"ok": false, "error": "only team objectives"}
    let r be diagnose.analysis(o)
    when r["ok"]
        teams.log("team:" + o["team"], "lampson", "diagnosed", "O-" + text(o["id"]), r["summary"])
    give r

export task obj_act(o, body)
    require db(".lampson/teams.db")
    require time
    require file(".lampson")
    require file(".lampson/**")
    require file.read("workspace")
    require file.read("workspace/**")
    when field(o, "team", "") == ""
        give {"ok": false, "error": "only team objectives"}
    let kind be text(field(body, "kind", ""))
    when kind == "message"
        let ok be teams.person_message(o["team"], lower(text(field(body, "agent", ""))), text(field(body, "text", "")))
        give when ok then {"ok": true} otherwise {"ok": false, "error": "no seat '" + text(field(body, "agent", "")) + "' in this team"}
    when kind == "task"
        let ok be teams.person_move("team:" + o["team"], floor(number(field(body, "task", 0))), text(field(body, "status", "")))
        give when ok then {"ok": true} otherwise {"ok": false, "error": "no such task or status"}
    give {"ok": false, "error": "kind must be message or task"}

-- borrar un equipo: {id, agents?}. Se cancelan sus objetivos en curso y se borran sus rutinas (sin equipo no tienen a
-- quién darle el trabajo); con agents=true (lo que manda la pantalla), también los archivos de sus agentes, salvo el
-- que está en otro equipo: se crearon para este y sueltos solo confunden. Lo que hizo
-- queda: el historial de sus objetivos y sus ramas de git. → {ok, cancelled, routines, agents} / {ok: false, error}
export task delete_team(body)
    require db(".lampson/teams.db")
    require time
    require exec
    require env("LAMPSON_*")
    require file(".lampson")
    require file(".lampson/**")
    require file("workspace")
    require file("workspace/**")
    let id be lower(text(field(body, "id", "")))
    let team be teams.get(id)
    when team == nothing
        give {"ok": false, "error": "no team '" + id + "'"}
    let cancelled be []
    each o in teams.obj_list()
        when o["team"] == id and contains(["active", "waiting", "paused"], o["status"])
            teams.obj_cancel(o["id"], "person")
            set cancelled to append(cancelled, "O-" + text(o["id"]))
    let routines be []
    each t in schedule.all()
        let a be field(t, "action", nothing)
        when a != nothing and type_of(a) == "map" and field(a, "type", "") == "objective" and field(a, "team", "") == id
            schedule.remove(t["id"])
            set routines to append(routines, t["id"])
    let others be []
    each t in teams.all()
        when t["id"] != id
            each m in t["members"]
                set others to append(others, m["agent"])
    teams.log("team:" + id, "person", "team deleted", "", text(length(cancelled)) + " objectives cancelled, " + text(length(routines)) + " routines removed")
    -- que un equipo nuevo con el mismo nombre arranque de cero: tablero y registro archivados, conversaciones olvidadas,
    -- y la copia de git de cada asiento propio retirada (su trabajo sin mergear queda en una rama archive/…)
    let archived be teams.archive(id)
    let gone be []
    let branches be []
    each m in team["members"]
        runtime.forget_thread(m["agent"], "team:" + id)
        when not contains(others, m["agent"])
            let w be worktree.retire(id, m["agent"])
            when starts_with(w["branch"], "archive/")
                set branches to append(branches, w["branch"])
            when field(body, "agents", false) == true
                let path be runtime.PROJECT_DIR + "/" + m["agent"] + runtime.SUFFIX
                when file_exists(path)
                    delete_file(path)
                    set gone to append(gone, m["agent"])
                teams.forget_spend(m["agent"])
    delete_file(teams.DIR + "/" + id + ".team.json")
    give {"ok": true, "cancelled": cancelled, "routines": routines, "agents": gone, "archived": archived, "branches": branches}

export task save_team(body)
    require db(".lampson/teams.db")
    require time
    require file(".lampson")
    require file(".lampson/**")
    require file("workspace")
    require file("workspace/**")
    require file.read("agents")
    require file.read("agents/**")
    let t be field(body, "team", nothing)
    when t == nothing
        give {"ok": false, "error": "team is required"}
    let v be teams.validate(t, "team")
    when not v["ok"]
        give {"ok": false, "error": v["error"]}
    let team be v["team"]
    let files be []
    each a in field(body, "agents", [])
        let id be lower(text(field(a, "id", "")))
        let path be runtime.PROJECT_DIR + "/" + id + runtime.SUFFIX
        let cur be {}
        when file_exists(path)
            try
                set cur to json_decode(read_file(path))
            recover err
                set cur to {}
        set cur["id"] to id
        each key in ["description", "system", "permission", "base"]
            when contains(a, key) and a[key] != nothing
                set cur[key] to text(a[key])
        when not contains(cur, "base")
            set cur["base"] to "lampson"
        when contains(a, "preset") and a["preset"] != nothing and contains(TOOL_PRESETS, text(a["preset"]))
            set cur["tools"] to TOOL_PRESETS[text(a["preset"])]
        when not contains(cur, "tools")
            set cur["tools"] to TOOL_PRESETS["code"]
        when not contains(cur, "steps")
            set cur["steps"] to 25
        let av be runtime.validate(cur, id + runtime.SUFFIX)
        when not av["ok"]
            give {"ok": false, "error": av["error"]}
        set files to append(files, {"path": path, "doc": cur})
    -- los miembros sin archivo de agente (ni del proyecto ni global) no pueden trabajar
    each m in team["members"]
        when runtime.get(m["agent"]) == nothing and length(where(files, (f) => f["doc"]["id"] == m["agent"])) == 0
            give {"ok": false, "error": "agent '" + m["agent"] + "' has no file yet — give it a personality to create it"}
    each f in files
        write_file(f["path"], json_encode(f["doc"]))
    let raw be {"id": team["id"], "name": team["name"], "description": team["description"], "members": apply(team["members"], (m) => when m["daily_tokens"] > 0 then {"agent": m["agent"], "role": m["role"], "reports_to": m["reports_to"], "daily_tokens": m["daily_tokens"]} otherwise {"agent": m["agent"], "role": m["role"], "reports_to": m["reports_to"]}), "talks": team["talks"], "round_minutes": team["round_minutes"], "budget_daily_tokens": team["budget_daily_tokens"], "worktrees": team["worktrees"]}
    write_file(teams.DIR + "/" + team["id"] + ".team.json", json_encode(raw))
    teams.log("team:" + team["id"], "person", "team saved", "", join(apply(team["members"], (m) => m["agent"] + " (" + m["role"] + ")"), ", "))
    give {"ok": true, "error": ""}
