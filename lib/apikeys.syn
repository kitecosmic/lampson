-- lib/apikeys.syn — API keys de la API /v1 (spec/engine.md, fase 2)
--
-- Una key = acceso por HTTP a ciertos agentes de ESTE workspace. Se guarda solo su hash (sha256), en el estado del
-- workspace (.lampson/api_keys.json, al lado de las sesiones): nunca en la carpeta del proyecto, que puede ir a git.
-- La key en claro se muestra UNA vez, al crearla (`lampson key add`).
--
--   create(name, agents) → {id, key, name, agents}      agents: ["tienda"] o ["*"] (todos los elegibles)
--   create_with(name, agents, {rate, callbacks})        rate = pedidos/minuto (default 120; 0 = sin límite);
--                                                      callbacks = URLs permitidas: mismo esquema, host y puerto, y
--                                                      el path como prefijo ([] = cualquier host PÚBLICO)
--                                                      → también {secret}: con él se firman SUS callbacks
--   signing_secret(id) → el secreto de esa key ("" en keys de antes de 2026-10-18: usan LAMPSON_WEBHOOK_SECRET)
--   check(key) → registro sin hash | nothing           (y anota last_used)
--   allows(rec, agent) → bool
--   list() / remove(id)

use "./tools/url.syn" as urls

export let FILE be ".lampson/api_keys.json"
export let PREFIX be "lk_"
export let DEFAULT_RATE be 120

task hash_of(key)
    give decode(sha256("lampson-api:" + key), "hex")

task load()
    require file.read(".lampson")
    require file.read(".lampson/*")
    try
        let d be json_decode(read_file(FILE))
        when contains(d, "keys")
            give d["keys"]
    recover err
        give []
    give []

task store(keys_list)
    require file(".lampson")
    require file(".lampson/*")
    write_file(FILE, json_encode({"keys": keys_list}))

task public(k)
    give {"id": k["id"], "name": k["name"], "agents": k["agents"], "created": k["created"], "last_used": k["last_used"], "rate": when contains(k, "rate") then k["rate"] otherwise DEFAULT_RATE, "callbacks": when contains(k, "callbacks") then k["callbacks"] otherwise []}

export task create(name, agents)
    require time
    require random
    require file(".lampson")
    require file(".lampson/*")
    give create_with(name, agents, {})

export task create_with(name, agents, opts)
    require time
    require random
    require file(".lampson")
    require file(".lampson/*")
    let ag be when agents == nothing or length(agents) == 0 then ["*"] otherwise agents
    let rate be when contains(opts, "rate") and opts["rate"] != nothing then floor(number(opts["rate"])) otherwise DEFAULT_RATE
    let cbs be when contains(opts, "callbacks") and opts["callbacks"] != nothing then opts["callbacks"] otherwise []
    let key be PREFIX + token(24)
    let id be "k" + slice(token(16), 0, 8)
    -- un secreto por key para firmar sus callbacks: con uno global, una app que comparte este Lampson podía firmar una
    -- callback falsa hacia otra (2026-10-18). Se guarda en claro (hace falta para firmar), como el webhook global
    let secret be "whsec_" + token(24)
    let rec be {"id": id, "name": text(name), "agents": ag, "hash": hash_of(key), "created": format_time(now()), "last_used": nothing, "rate": rate, "callbacks": cbs, "secret": secret}
    store(append(load(), rec))
    give {"id": id, "key": key, "name": rec["name"], "agents": ag, "rate": rate, "callbacks": cbs, "secret": secret}

-- ¿esta key puede pedir un callback a esta URL? sin lista = cualquiera; con lista = solo esos prefijos
-- ¿esta key puede mandar una callback a `url`? Con lista: mismo esquema, host y puerto, y el path de la lista como
-- prefijo de carpeta ("https://app.com/hooks" deja /hooks y /hooks/x, no /hooks-x). Sin lista: cualquier host público
-- — nunca loopback, red privada ni metadatos de la nube. Antes (hasta 2026-10-18) era starts_with sobre la URL
-- entera: "https://app.com" dejaba pasar "https://app.com.evil.net", y sin lista, cualquier URL (SSRF).
export task callback_allowed(rec, url)
    let u be urls.parse(url)
    when not u["ok"]
        give false
    let cbs be when contains(rec, "callbacks") then rec["callbacks"] otherwise []
    when length(cbs) == 0
        give urls.host_class(u["host"]) == "public"
    each pre in cbs
        let p be urls.parse(pre)
        when p["ok"] and p["scheme"] == u["scheme"] and p["host"] == u["host"] and p["port"] == u["port"]
            let base be p["path"]
            while ends_with(base, "/")
                set base to slice(base, 0, length(base) - 1)
            when base == "" or u["path"] == base or starts_with(u["path"], base + "/")
                give true
    give false

export task signing_secret(id)
    require file.read(".lampson")
    require file.read(".lampson/*")
    let f be where(load(), (k) => k["id"] == id)
    give when length(f) > 0 and contains(f[0], "secret") then text(f[0]["secret"]) otherwise ""

export task list()
    require file.read(".lampson")
    require file.read(".lampson/*")
    give apply((k) => public(k), load())

export task remove(id)
    require file(".lampson")
    require file(".lampson/*")
    let all be load()
    let rest be where(all, (k) => k["id"] != id)
    when length(rest) == length(all)
        give false
    store(rest)
    give true

-- el registro de la key (sin hash) o nothing. Anota last_used como mucho una vez por minuto (no reescribir en cada request)
export task check(key)
    require time
    require file(".lampson")
    require file(".lampson/*")
    when key == nothing
        give nothing
    let k be text(key)
    when not starts_with(k, PREFIX)
        give nothing
    let h be hash_of(k)
    let all be load()
    let found be nothing
    let changed be false
    let out be []
    each r in all
        when r["hash"] == h
            set found to public(r)
            let stamp be format_time(now(), "%Y-%m-%dT%H:%M")
            when r["last_used"] == nothing or slice(text(r["last_used"]), 0, 16) != stamp
                set r["last_used"] to format_time(now())
                set changed to true
        set out to append(out, r)
    when changed
        store(out)
    give found

export task allows(rec, agent)
    when rec == nothing
        give false
    give contains(rec["agents"], "*") or contains(rec["agents"], agent)
