-- lib/settings.syn — configuración editable en caliente: proveedor, modelo y API keys
--
-- Dónde: lampson/.lampson/config.json (gitignored, local). Lo escriben el onboarding de la terminal, la
-- ventana "proveedor" de la web y /provider. .env sigue valiendo (LAMPSON_PROVIDER, LAMPSON_API_KEY[_X]):
-- config.json gana sobre .env, y una key guardada acá se sella con as_secret() al leerla (nunca se
-- devuelve al navegador ni se imprime; el frontend solo ve has_key).
--
-- Forma: {"provider": "deepseek", "model": "deepseek-chat", "keys": {"deepseek": "sk-…"}}

-- bajo el hub cada workspace corre con su propio .lampson/ y una junction .lampson/global → <home>/.lampson:
-- la config (keys, ⚙) es una sola para todos. Sin junction (instalación directa, tests) es .lampson/config.json
task cfg_path()
    try
        when file_exists(".lampson/global/config.json") or file_exists(".lampson/global")
            give ".lampson/global/config.json"
    recover err
        give ".lampson/config.json"
    give ".lampson/config.json"

export task load()
    require file.read(".lampson")
    require file.read(".lampson/*")
    require env("LAMPSON_*")
    -- LAMPSON_NO_CONFIG=1: ignorar config.json (proveedor/key reales) — lo fija tests/run.ps1|sh para que la
    -- suite hable SOLO con el mock (2026-08-27: agents_test gastó tokens reales de DeepSeek por no tenerlo)
    when env("LAMPSON_NO_CONFIG", "") == "1"
        give {"provider": "", "model": "", "keys": {}}
    try
        let doc be json_decode(read_file(cfg_path()))
        -- claves siempre presentes: quien lee no tiene que chequear (y `and` no cortocircuita)
        when not contains(doc, "keys")
            set doc["keys"] to {}
        when not contains(doc, "provider")
            set doc["provider"] to ""
        when not contains(doc, "model")
            set doc["model"] to ""
        give doc
    recover err
        give {"provider": "", "model": "", "keys": {}}

export task save(doc)
    require file(".lampson")
    require file(".lampson/*")
    require env("LAMPSON_*")
    -- LAMPSON_NO_CONFIG=1 (tests): NUNCA escribir el archivo real. Como load() devuelve un doc en blanco,
    -- cualquier save() (remember_command al tipear /exit en tty_test, /verbose, set_key, set_default…)
    -- pisaba provider y keys del usuario (pasó el 2026-09-05: tty_test dejó config.json vacío).
    when env("LAMPSON_NO_CONFIG", "") == "1"
        give false
    write_file(cfg_path(), json_encode(doc))
    give true

-- key guardada para un proveedor, como TEXTO ("" si no hay). Sellarla con as_secret antes de usarla.
export task raw_key(name)
    require file.read(".lampson")
    require file.read(".lampson/*")
    let doc be load()
    when contains(doc["keys"], lower(name))
        give text(doc["keys"][lower(name)])
    give ""

export task set_key(name, key)
    require file(".lampson")
    require file(".lampson/*")
    let doc be load()
    when trim(key) == ""
        let keys be {}
        each k in keys(doc["keys"])
            when k != lower(name)
                set keys[k] to doc["keys"][k]
        set doc["keys"] to keys
    otherwise
        set doc["keys"][lower(name)] to trim(key)
    save(doc)
    give true

export task set_default(name, model)
    require file(".lampson")
    require file(".lampson/*")
    let doc be load()
    set doc["provider"] to lower(name)
    set doc["model"] to model
    save(doc)
    give true

-- valores de configuración generales (rueda de la UI): tz, public_url, webhook_url, webhook_secret…
-- Vacío = borrar la clave. Nunca se devuelven secretos al navegador: `values()` marca webhook_secret como has_*.
-- computer_*: la tool computer_use (lib/computer.syn) — "1" enciende; max_tabs y grant_profile son sus knobs.
-- judge = off | jev | laya: el juez de decisión de Lampson (lib/judge.syn), una credencial propia que usa computer
-- use y puede usar cualquier otra parte; judge_model = con laya, la carpeta del checkpoint; con jev, un id para
-- pinear (opcional). computer_judge / computer_judge_model: los nombres del primer día (2026-09-28), solo se leen.
export let KEYS be ["tz", "public_url", "webhook_url", "webhook_secret", "idle_hours", "computer_use", "computer_max_tabs", "computer_grant_profile", "judge", "judge_model", "computer_judge", "computer_judge_model"]

-- el archivo REAL, ignorando LAMPSON_NO_CONFIG: escribir con el doc en blanco de los tests pisaría provider/keys
-- (pasó el 2026-08-29 probando la rueda con un web de test)
task load_raw()
    try
        let doc be json_decode(read_file(cfg_path()))
        when not contains(doc, "keys")
            set doc["keys"] to {}
        when not contains(doc, "provider")
            set doc["provider"] to ""
        when not contains(doc, "model")
            set doc["model"] to ""
        give doc
    recover err
        give {"provider": "", "model": "", "keys": {}}

export task set_value(key, value)
    require file(".lampson")
    require file(".lampson/*")
    require env("LAMPSON_*")
    when not contains(KEYS, key)
        raise("unknown setting '" + text(key) + "'")
    let doc be load_raw()
    when trim(text(value)) == ""
        let clean be {}
        each k in keys(doc)
            when k != key
                set clean[k] to doc[k]
        set doc to clean
    otherwise
        set doc[key] to trim(text(value))
    save(doc)
    give true

export task values()
    require file.read(".lampson")
    require file.read(".lampson/*")
    require env("LAMPSON_*")
    let doc be load_raw()
    let out be {}
    each k in KEYS
        when k == "webhook_secret"
            set out["has_webhook_secret"] to (contains(doc, k) and text(doc[k]) != "") or env("LAMPSON_WEBHOOK_SECRET", "") != ""
        otherwise
            set out[k] to when contains(doc, k) then text(doc[k]) otherwise ""
            -- lo fijado en .env gana y se muestra como tal
            let e be env("LAMPSON_" + upper(k), "")
            when e != ""
                set out[k] to e
                set out[k + "_from_env"] to true
    give out

-- el juez de computer use como ENTORNO para el runtime: Synsema lee SYNSEMA_JUDGE_* y TYPESAFE_API_KEY del proceso
-- (o del .env) al arrancar, y un programa no puede cambiarlos en caliente. Lo usan quienes lanzan procesos: el
-- workspace web (workspaces.start_ws) y la terminal (cli.syn ensure → lampson.ps1|sh). {} = no tocar nada.
-- La key de TypeSafe se guarda con set_key("typesafe", …) como las de los proveedores.
export task judge_env()
    require file.read(".lampson")
    require file.read(".lampson/*")
    require env("LAMPSON_*")
    let js be judge_setting()
    let mode be lower(trim(text(js["mode"])))
    let model be trim(text(js["model"]))
    when mode == "jev" or mode == "typesafe"
        let out be {"SYNSEMA_JUDGE_PROVIDER": "typesafe"}
        let k be raw_key("typesafe")
        when k != ""
            set out["TYPESAFE_API_KEY"] to k
        when model != ""
            set out["SYNSEMA_JUDGE_MODEL"] to model
        give out
    when mode == "laya" or mode == "local"
        let out be {"SYNSEMA_JUDGE_PROVIDER": "laya"}
        when model != ""
            set out["SYNSEMA_JUDGE_MODEL"] to model
        give out
    give {}

-- el juez configurado → {mode, model, from_env}: `judge` / `judge_model` (LAMPSON_JUDGE en .env gana), y si no, los
-- nombres viejos computer_judge / computer_judge_model
export task judge_setting()
    require file.read(".lampson")
    require file.read(".lampson/*")
    require env("LAMPSON_*")
    let v be values()
    let m be trim(text(v["judge"]))
    let mo be trim(text(v["judge_model"]))
    when m == ""
        set m to trim(text(v["computer_judge"]))
    when mo == ""
        set mo to trim(text(v["computer_judge_model"]))
    give {"mode": m, "model": mo, "from_env": contains(v, "judge_from_env")}

-- guardar el juez con los nombres nuevos y borrar los viejos (una sola fuente de verdad)
export task set_judge(mode, model)
    require file(".lampson")
    require file(".lampson/*")
    require env("LAMPSON_*")
    set_value("judge", when mode == "off" then "" otherwise mode)
    when model != nothing
        set_value("judge_model", text(model))
    set_value("computer_judge", "")
    when model != nothing
        set_value("computer_judge_model", "")
    give true
