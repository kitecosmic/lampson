-- lib/teamrun.syn — el pulso de los equipos: entrega los mensajes entre agentes y lanza las rondas
--
-- Corre en el proceso del workspace (web.syn, cron cada TICK_SECONDS). Todo entra al agente por el BUZÓN
-- (lib/mailbox.syn), como un mensaje de un cliente: una conversación por agente y equipo (thread "team:<id>"),
-- nunca dos turnos a la vez, ráfagas juntas. Cada turno arranca con lo que llegó + lo que pasó en el equipo desde su
-- último turno + sus tareas (teams.turn_text).
--   * mensajes: los que `send` dejó pendientes en la base → al buzón del destinatario
--   * rondas: un agente con trabajo (novedades de otros o tareas suyas abiertas) cada round_minutes del equipo
--   * presupuesto: un agente que pasó su tope diario no recibe turnos (sus mensajes esperan al día siguiente);
--     queda UNA entrada en el registro por día
use "./teams.syn" as teams
use "./mailbox.syn" as mailbox
use "./runtime.syn" as runtime
use "./approvals.syn" as approvals

export let TICK_SECONDS be 3
-- lo que el hub muestra de este workspace (inicio, /equipos) sin abrir su base: equipos, objetivos y lo que espera
export let SUMMARY_FILE be ".lampson/teams-summary.json"
export let ASSIGNED_TEXT be "[assigned] You have a new task on the board (see your open tasks below). Start on it; if something is unclear, `send` whoever assigned it."
export let ROUND_TEXT be "[round] Your periodic round: look at your open tasks and the team's news above, and move your work forward. If there is nothing for you to do, reply with one short line and stop — don't invent work."

task flag_budget(team, agent)
    require db(".lampson/teams.db")
    require file(".lampson")
    require file(".lampson/*")
    require time
    let k be "teams:budget:" + team["id"] + ":" + agent + ":" + format_time(now(), "%Y-%m-%d")
    when state_get(k) == nothing
        state_set(k, true)
        teams.log("team:" + team["id"], agent, "budget", "", "daily budget reached (" + text(teams.cap_of(team, agent)) + " tokens): no more turns today")

-- un turno para `agent` en su conversación del equipo
export task deliver_to(team, agent, sender, head)
    require db(".lampson/teams.db")
    require time
    require random
    require file(".lampson")
    require file(".lampson/*")
    require file.read("workspace")
    require file.read("workspace/*")
    require file.read("agents")
    require file.read("agents/*")
    let spec be runtime.get(agent)
    when spec == nothing
        teams.log("team:" + team["id"], "lampson", "error", "", "no agent file for '" + agent + "' — create .lampson/agents/" + agent + ".agent.json")
        give false
    -- su primer turno en un objetivo: conversación nueva (el tablero, el registro y git ya cuentan lo anterior)
    let oid be teams.objective_of_scope("team:" + team["id"])
    when oid != 0 and teams.seat_session_of(oid, agent) == ""
        runtime.forget_thread(agent, "team:" + team["id"])
    -- quién está en medio de un turno: sus mensajes le llegan cuando termina. (Visto 2026-10-17: el CEO le preguntó
    -- tres veces al CMO, que estaba documentando, no le contestó, y le pasó su tarea al CTO: los dos hicieron lo mismo.)
    let busy be []
    each m in team["members"]
        when m["agent"] != agent and mailbox.working(m["agent"], "team:" + team["id"])
            set busy to append(busy, m["agent"])
    let now_line be when length(busy) == 0 then "" otherwise "\nWorking right now (your messages reach them when their turn ends — wait for them, don't reassign their tasks): " + join(busy, ", ")
    let sobre be {"to": agent, "thread": "team:" + team["id"], "session": "", "from": sender, "text": teams.turn_text(team, agent, head) + now_line, "images": [], "channel": "team", "meta": {"team": team["id"], "from": sender}}
    mailbox.submit(sobre, {"mode": when spec["permission"] != "" then "" otherwise "strict", "buffer": mailbox.buffer_of(spec, false)})
    give true

-- un turno del objetivo `o` en su conversación (thread objective:<id>)
export task deliver_objective(o)
    require db(".lampson/teams.db")
    require time
    require random
    require file(".lampson")
    require file(".lampson/*")
    require file.read("workspace")
    require file.read("workspace/*")
    require file.read("agents")
    require file.read("agents/*")
    let spec be runtime.get(o["agent"])
    when spec == nothing
        teams.obj_set(o["id"], {"status": "failed", "result": "no agent file for '" + o["agent"] + "'"})
        give false
    -- objetivo de equipo: el turno es del líder, en la conversación del equipo (con sus novedades y el tablero del equipo)
    when o["team"] != ""
        let tm be teams.get(o["team"])
        when tm == nothing
            teams.obj_set(o["id"], {"status": "failed", "result": "team '" + o["team"] + "' no longer exists"})
            give false
        let head be teams.obj_head(o)
        teams.obj_set(o["id"], {"last_start": now(), "turns": o["turns"] + 1, "reply": ""})
        give deliver_to(tm, o["agent"], "lampson", head)
    let txt be teams.obj_turn_text(o)
    teams.obj_set(o["id"], {"last_start": now(), "turns": o["turns"] + 1, "reply": ""})
    let sobre be {"to": o["agent"], "thread": "objective:" + text(o["id"]), "session": "", "from": "lampson", "text": txt, "images": [], "channel": "objective", "meta": {"objective": o["id"]}}
    mailbox.submit(sobre, {"mode": when spec["permission"] != "" then "" otherwise "strict", "buffer": mailbox.buffer_of(spec, false)})
    give true

-- ¿le toca un turno? activo, el anterior terminó y pasaron round_seconds (el primero, enseguida; una respuesta de la
-- persona, enseguida también)
export task objective_due(o)
    require db(".lampson/teams.db")
    require file(".lampson")
    require file(".lampson/*")
    require time
    when o["status"] != "active"
        give false
    when o["turns"] == 0
        give true
    -- el turno anterior sigue (o murió sin cerrar: a los 15 min se da por perdido y se sigue)
    when o["last_end"] < o["last_start"] and now() - o["last_start"] < 900
        give false
    when o["reply"] != ""
        give true
    when now() - o["last_end"] < o["round_seconds"]
        give false
    -- en un equipo, el líder solo hace ronda si algo cambió o tiene tareas propias (si no, está esperando a los demás)
    when o["team"] != ""
        when teams.has_work("team:" + o["team"], o["agent"])
            give true
        -- nadie se mueve hace rato: el líder recibe UNA ronda para destrabar (y otra si sigue igual, STALL_SECONDS después)
        when stalled(o)
            teams.obj_set(o["id"], {"reply": STALL_TEXT})
            give true
        give false
    give true

export let STALL_SECONDS be 600
export let STALL_TEXT be "[stalled] Nothing has moved in the team for 10 minutes and nobody is working. Look at the board: is someone waiting for something, or did someone stop without saying? Unblock it (`send` them what they need; reassign only if they said they are blocked) or, if the team can't go on, ask the person with `objective` ask."

-- ¿el equipo de un objetivo está quieto? nadie trabajando, ningún mensaje por entregar y nada en el registro hace rato
task stalled(o)
    require db(".lampson/teams.db")
    require file(".lampson")
    require file(".lampson/*")
    require file.read("workspace")
    require file.read("workspace/*")
    require time
    let tm be teams.get(o["team"])
    when tm == nothing or now() - o["last_end"] < STALL_SECONDS
        give false
    each m in tm["members"]
        when mailbox.working(m["agent"], "team:" + tm["id"])
            give false
    give teams.quiet_for("team:" + tm["id"]) >= STALL_SECONDS

-- escribe el resumen si cambió: equipos, objetivos abiertos (y los últimos cerrados) y aprobaciones pendientes
export task write_summary()
    require db(".lampson/teams.db")
    require time
    require net
    require env("LAMPSON_*")
    require file(".lampson")
    require file(".lampson/*")
    require file.read("workspace")
    require file.read("workspace/*")
    -- roles: lo que /equipos del hub muestra de cada equipo (el rol, o el id del agente si no tiene)
    let ts be apply(teams.all(), (t) => {"id": t["id"], "name": t["name"], "description": t["description"], "members": length(t["members"]), "lead": teams.lead_of(t), "roles": apply(t["members"], (m) => when contains(m, "role") and m["role"] != nothing and text(m["role"]) != "" then text(m["role"]) otherwise text(m["agent"]))})
    let objs be teams.obj_list()
    let open_o be where(objs, (o) => contains(["active", "waiting", "paused"], o["status"]))
    let closed be slice(where(objs, (o) => not contains(["active", "waiting", "paused"], o["status"])), 0, 5)
    let brief be apply(open_o + closed, (o) => {"id": o["id"], "ref": "O-" + text(o["id"]), "agent": o["agent"], "team": o["team"], "text": slice(o["text"], 0, 240), "status": o["status"], "question": o["question"], "question_kind": o["question_kind"], "progress": slice(o["progress"], 0, 240), "spent": o["spent"], "updated_at": o["updated_at"]})
    let aps be []
    try
        set aps to apply(approvals.pending(), (a) => {"id": a["id"], "message": a["message"], "why": a["why"], "created": a["created"]})
    recover err
        set aps to []
    let body be {"teams": ts, "objectives": brief, "approvals": aps, "active": length(where(open_o, (o) => o["status"] == "active")), "waiting": length(where(open_o, (o) => o["status"] == "waiting")) + length(aps)}
    let enc be json_encode(body)
    when state_get("teams:summary:last", "") != enc
        state_set("teams:summary:last", enc)
        set body["updated"] to now()
        write_file(SUMMARY_FILE, json_encode(body))
    give body

export task tick()
    require net
    require env("LAMPSON_*")
    require db(".lampson/teams.db")
    require time
    require random
    require file(".lampson")
    require file(".lampson/*")
    require file.read("workspace")
    require file.read("workspace/*")
    require file.read("agents")
    require file.read("agents/*")
    let n be 0
    try
        write_summary()
    recover err
        set n to 0
    each o in teams.obj_list()
        when objective_due(o)
            when deliver_objective(o)
                set n to n + 1
    let teams_now be teams.all()
    when length(teams_now) == 0
        give n
    each m in teams.pending()
        let tid be slice(m["scope"], 5, length(m["scope"]))
        let found be where(teams_now, (t) => t["id"] == tid)
        when length(found) == 0
            teams.mark(m["id"], "dropped")
        otherwise
            let team be found[0]
            when teams.over_budget(team, m["recipient"])
                flag_budget(team, m["recipient"])
            otherwise
                let who be teams.member(team, m["sender"])
                let head be when m["sender"] == "person" then "[message from the person who owns this team — act on it]\n" + m["text"] otherwise "[message from " + m["sender"] + (when who != nothing then " (" + who["role"] + ")" otherwise "") + "]\n" + m["text"]
                when deliver_to(team, m["recipient"], m["sender"], head)
                    teams.mark(m["id"], "delivered")
                    set n to n + 1
                otherwise
                    teams.mark(m["id"], "failed")
    each team in teams_now
        each mem in team["members"]
            when teams.over_budget(team, mem["agent"])
                flag_budget(team, mem["agent"])
            otherwise when teams.round_due(team, mem["agent"])
                deliver_to(team, mem["agent"], "lampson", when team["round_minutes"] <= 0 then ASSIGNED_TEXT otherwise ROUND_TEXT)
                set n to n + 1
    give n
