-- web.syn — Lampson por URL (chat web con SSE)
--
--   Un proceso POR WORKSPACE, lanzado por el hub / cli.syn con cwd = .lampson/ws/<slug> (ver lib/workspaces.syn):
--     synsema serve web.syn --port 808N --bind 127.0.0.1 --env-file <home>/.env
--   Todas las rutas van bajo /w/:slug/… porque el hub (hub.syn, :8080) proxyea sin quitar el prefijo. El :slug se
--   ignora (cada proceso es un workspace); LAMPSON_WS trae el propio. Standalone sigue sirviendo en :8080.
--
-- API (bajo /w/<slug>):
--   GET  /api/health             {alive, last_used, schedules_on} (hub, terminal)
--   GET  /api/sessions           lista de sesiones
--   GET  /api/sessions/:id       historial de una sesión
--   POST /api/chat               {session?, message, agent?} → SSE con eventos del loop y "done" al final
--
-- Permisos bajo web: el modo (ask|yolo|strict) viene en cada POST /api/chat (selector de la UI; default
-- LAMPSON_PERMISSION). En "ask", una tool peligrosa emite el evento SSE `approval_request` y el loop
-- espera (polling de state_*) hasta que la UI responda por POST /api/approve o venza el timeout → deniega.
-- Nunca se auto-aprueba en silencio.
--
-- MIGAS serve: secret() y config() se resuelven DENTRO del handler (globals redactados por request);
-- las tasks deben definirse ANTES de `serve on`; `send` solo parsea dentro de `stream`, así que
-- el emisor de eventos se define dentro del bloque stream.

intent: "Web chat for a coding agent: tools from an allow-list, least-privilege per tool, SSE progress"

require serve(8080)
require net
require time
require exec
require random
require env("LAMPSON_*")
require env("OS")
require secret("LAMPSON_*")
require db(".lampson/teams.db")
require judge
require file("workspace")
require file("workspace/*")
require file.read("skills")
require file.read("skills/*")
require file.read("plugins")
require file.read("plugins/*")
require file.read("agents")
require file.read("agents/*")
require file("memory")
require file("memory/*")
require file(".lampson")
require file(".lampson/*")
require file.read("public")
require file.read("public/*")

use "./lib/provider.syn" as provider
use "./lib/tools.syn" as tools
use "./lib/session.syn" as session
use "./lib/agents.syn" as agents
use "./lib/tree.syn" as tree
use "./lib/fs.syn" as fs
use "./lib/git.syn" as git
use "./lib/tools/proc.syn" as proc
use "./lib/tools/memo.syn" as memo
use "./lib/update.syn" as update
use "./lib/settings.syn" as settings
use "./lib/trace.syn" as trace
use "./lib/mcp.syn" as mcp
use "./lib/plugins.syn" as plugins
use "./lib/lsp.syn" as lsp
use "./lib/tools/todo.syn" as todo
use "./lib/schedule.syn" as schedule
use "./lib/sched_run.syn" as sched_run
use "./lib/approvals.syn" as approvals
use "./lib/permission.syn" as permission
use "./lib/term.syn" as term
use "./lib/computer.syn" as computer
use "./lib/workspaces.syn" as workspaces
use "./lib/judge.syn" as jdg
use "./lib/origin.syn" as origin
use "./lib/runtime.syn" as runtime
use "./lib/api.syn" as api
use "./lib/apikeys.syn" as apikeys
use "./lib/mailbox.syn" as mailbox
use "./lib/teamrun.syn" as teamrun
use "./lib/teams.syn" as teams
use "./lib/channels.syn" as channels
use "./lib/mcp_server.syn" as mcp_server

let APPROVAL_TIMEOUT be 180

-- Quién puede usar la API (chat con tools, terminal, matar procesos). `auth with` corre ANTES del upgrade
-- WebSocket, así que cubre /api/term. Reglas en lib/origin.syn:
--   * otra origin en el navegador (CSRF, WebSocket desde otra página, DNS rebinding) → fuera, siempre;
--   * bajo el hub (LAMPSON_WS): el proceso escucha solo en 127.0.0.1 (--bind) y confía en el proxy del hub
--     (`trust proxy` en el serve de abajo), que ya autenticó al cliente y reescribe el Host a 127.0.0.1:<puerto>.
--     Un Host público = un túnel apuntado a este puerto en vez de al hub → fuera;
--   * solo (docker, `synsema serve web.syn`): esta PC (lib/origin.syn is_local).
-- Opt-in para scripts remotos: LAMPSON_WEB_TOKEN en .env + `Authorization: Bearer <token>`.
task check_client(token, request)
    let h be headers of request
    when origin.cross_site(h)
        give nothing
    when env("LAMPSON_WS", "") != "" and origin.loopback_host(h)
        give {"local": true}
    when env("LAMPSON_WS", "") == "" and origin.is_local(text(ip of request), h)
        give {"local": true}
    let want be env("LAMPSON_WEB_TOKEN", "")
    when want != "" and token == want
        give {"local": false}
    -- API key de /v1 (lib/apikeys.syn): vale SOLO para /w/<slug>/v1/… — nunca para la UI, la terminal o el chat
    when token != nothing and starts_with(text(token), apikeys.PREFIX) and contains(text(request.path), "/v1/")
        when apikeys.check(token) != nothing
            give {"local": false, "api_key": true}
    give nothing

-- salida del pty como texto (la doc de 0.6.8 ya lo dice así; is_bytes por si cambia)
task as_text(x)
    when is_bytes(x)
        give decode(x, "utf8_lossy")
    give x

-- Subagente en background: `agent Child` (lib/agents.syn) solo puede llamar tasks TOP-LEVEL de este
-- programa; esta es su puerta de entrada. Bajo serve el agente sobrevive al request que lo lanzó.
task lampson_subagent(spec_json)
    give agents.run_child_json(spec_json)

-- Worker del buzón de una conversación (lib/mailbox.syn): `agent MailboxWorker` solo llama tasks TOP-LEVEL; esta es su puerta
task lampson_mailbox_worker(spec_json)
    give mailbox.work(spec_json)

-- Canales en modo sin URL pública (lib/channels.syn): un agente ChannelPoller por canal; el tick lo mantiene vivo
task lampson_channel_poller(name)
    give channels.poll_loop(name)
task channel_poll_tick()
    give channels.poll_tick()
cron_every(5, channel_poll_tick)

-- EQUIPOS (lib/teamrun.syn): entrega los mensajes entre agentes (tool send) por el buzón y lanza las rondas
task team_tick()
    give teamrun.tick()
cron_every(teamrun.TICK_SECONDS, team_tick)

-- TAREAS PROGRAMADAS (lib/schedule.syn): este proceso es el residente de lampson — con `lampson --daemon start`
-- (synsema daemon) queda en background y ejecuta lo programado aunque no haya ninguna UI abierta. Un tick cada
-- 30 s (cron_every de Synsema: intervalo puro; la hora de reloj la resuelve schedule.syn) corre lo vencido:
-- plugins, comandos y corridas del agente con su sobre de permisos; una aprobación en una corrida desatendida
-- sale por lib/approvals.syn (panel «Aprobaciones» de la UI, webhook firmado, link de un solo uso).
task sched_tick()
    give sched_run.tick()
cron_every(schedule.TICK_SECONDS, sched_tick)

-- servers MCP: supervisores (agentes) lanzados al arrancar; los handlers leen su estado del blackboard
mcp.start_all(8)

-- marca de corrida (blackboard): session.save la estampa en meta.run; reanudar una sesión guardada por
-- OTRA corrida dispara la nota de procesos muertos (proc.resume_note) para que el modelo no los crea vivos
share {"id": text(now())} as "lampson:run"
share {"kind": "web"} as "lampson:ui"

-- la pantalla de equipos (public/teams.html) en cualquiera de sus rutas; abierta por el puerto de este proceso, al hub
task teams_page(request, slug, rest)
    let h be headers of request
    when env("LAMPSON_WS", "") != "" and not contains(h, "x-forwarded-host")
        give redirect("http://127.0.0.1:8080/w/" + slug + rest)
    give html(read_file("public/teams.html"))

serve on 8080
    -- el proxy del hub (y nada más) conecta por loopback: sus X-Forwarded-* traen la origin real (check_client).
    -- Acá y no como flag de start_ws: el web.syn se copia al arrancar, y un hub viejo en memoria lo lanzaba sin el
    -- flag → toda origin parecía ajena y la terminal no conectaba (2026-10-05)
    trust proxy ["127.0.0.1", "::1"]
    max_streams 50
    auth with check_client
    static "./public"
    -- lo que publican /openapi.json, /llms.txt, /docs y la agent card: SOLO la API /v1 (todo lo demás lleva `private`)
    describe
        about: "Lampson API — agents of this workspace for your apps, channels and other agents"
        version: "1.0.0"
        api: ["POST /w/:slug/v1/messages -- send a message to an agent and get its answer (JSON); with \"callback\", 202 now and the answer POSTed later. Body: {to, thread, text, images?, from?, meta?, sent_at?, session?, callback?}", "POST /w/:slug/v1/messages/stream -- the same, as Server-Sent Events: session, the agent's steps, done", "GET /w/:slug/v1/agents -- the agents this API key can use", "GET /w/:slug/v1/jobs/:id -- status and result of a message sent with a callback", "POST /w/:slug/v1/mcp -- Model Context Protocol (Streamable HTTP, JSON responses): tools ask, agents and history, for other AI agents", "POST /w/:slug/v1/mcp/stream -- the same MCP server answering with Server-Sent Events: with params._meta.progressToken, each step of the agent arrives as notifications/progress before the result", "GET /w/:slug/v1/mcp -- 405: this MCP server opens no server-to-client stream", "POST /w/:slug/v1/objectives -- give an agent (or a team) an objective to work on by itself until done; it plans on a board, works in rounds and asks before anything irreversible. Body: {text, agent? | team?, budget_tokens?, round_seconds?}", "GET /w/:slug/v1/objectives -- the objectives this API key can see", "GET /w/:slug/v1/objectives/:id -- one objective: status, last report, question or approval it waits for, result, board and record", "POST /w/:slug/v1/objectives/:id/reply -- answer its question, or approve/deny what it asked: {text?, approved?}", "POST /w/:slug/v1/objectives/:id/cancel -- stop it"]

    -- la UI vive bajo /w/<slug> (BASE en js/core.js); si alguien entra por el puerto del proceso, es lo mismo
    -- Acceso DIRECTO por el puerto del proceso (sin X-Forwarded-Host, que solo agrega el hub al proxyear): la UI se
    -- usa siempre por el hub → redirigir a http://127.0.0.1:8080/w/<slug>. Standalone sin hub (docker) no hay
    -- LAMPSON_WS y se sirve acá mismo.
    route "GET /w/:slug"
        private
        let h be headers of request
        when env("LAMPSON_WS", "") != "" and not contains(h, "x-forwarded-host")
            give redirect("http://127.0.0.1:8080/w/" + params.slug)
        give html(read_file("public/index.html"))
    route "GET /"
        private
        when env("LAMPSON_WS", "") == ""
            give redirect("/w/local")
        give redirect("http://127.0.0.1:8080/w/" + env("LAMPSON_WS", ""))
    route "GET /api/hub"
        private
        proxy to "http://127.0.0.1:8080"
    route "GET /api/workspaces"
        private
        proxy to "http://127.0.0.1:8080"
    route "GET /api/workspaces/*path"
        private
        proxy to "http://127.0.0.1:8080"
    route "POST /api/workspaces"
        private
        proxy to "http://127.0.0.1:8080"
    route "POST /api/workspaces/*path"
        private
        proxy to "http://127.0.0.1:8080"

    -- salud para el hub/supervisor y la terminal (último uso = chat, terminal, eventos o abrir la UI)
    route "GET /w/:slug/api/health"
        private
        give {"alive": true, "slug": env("LAMPSON_WS", ""), "last_used": state_get("lampson:last_used", nothing), "schedules_on": length(where(schedule.all(), (t) => t["enabled"] == true)), "version": env("LAMPSON_VERSION", "")}

    route "GET /w/:slug/api/sessions" requires auth
        private
        state_set("lampson:last_used", now())
        give {"sessions": session.list()}

    -- buscador de sesiones (modal «ver todas»): ?q=texto busca en títulos y mensajes de este proyecto
    route "GET /w/:slug/api/sessions/search" requires auth
        private
        let q be when contains(query, "q") then text(query.q) otherwise ""
        let n be when contains(query, "limit") then floor(number(query.limit)) otherwise 200
        give {"q": q, "sessions": session.search(q, n)}

    route "GET /w/:slug/api/sessions/:id" requires auth
        private
        when not session.exists(params.id)
            give not_found("session not found")
        let doc be session.load(params.id)
        let visible be where(doc["messages"], (m) => m["role"] != "system")
        give {"id": doc["id"], "updated": doc["updated"], "meta": doc["meta"], "messages": visible}

    route "GET /w/:slug/api/config" requires auth
        private
        let cfg be provider.config()
        give {"provider": cfg["provider"], "model": cfg["model"], "wire": cfg["wire"], "vision": provider.supports_vision(cfg), "providers": provider.providers(), "configured": provider.configured(), "permission": lower(env("LAMPSON_PERMISSION", "ask")), "agents": agents.names(), "workspace": env("LAMPSON_WORKSPACE", "./workspace"), "profiles": agents.PROFILES}

    -- proveedor/modelo por defecto y API keys → .lampson/config.json (local). La key nunca vuelve al cliente.
    route "POST /w/:slug/api/settings" requires auth
        private
        expect body {provider: text}
        let b be json of request
        let name be lower(text(b["provider"]))
        when not contains(provider.PRESETS, name)
            give fail(400, "unknown provider " + name)
        when contains(b, "key")
            settings.set_key(name, text(b["key"]))
        let model be when contains(b, "model") then trim(text(b["model"])) otherwise ""
        settings.set_default(name, model)
        let ncfg be provider.config_for(name, "")
        give {"ok": true, "providers": provider.providers(), "provider": name, "model": ncfg["model"], "vision": provider.supports_vision(ncfg), "configured": provider.configured()}

    route "POST /w/:slug/api/sessions/delete" requires auth
        private
        expect body {id: text}
        let b be json of request
        give {"result": session.delete(text(b["id"]))}

    route "GET /w/:slug/api/tree" requires auth
        private
        let t be tree.tree(6)
        -- ruta real del proyecto (lampson.ps1/.sh exportan LAMPSON_WORKSPACE): «copiar ruta absoluta» en el explorador
        set t["root"] to env("LAMPSON_WORKSPACE", "")
        give t

    -- Terminales del navegador. El pty NO vive en este handler: vive en un agente supervisor
    -- (lib/term.syn), y este socket es un puente por el bus. Así la shell sobrevive a un F5 —
    -- la pestaña se reengancha con ?id=<id> y recibe el replay de lo último que imprimió.
    -- Navegador → servidor: {type: "in", data} | {type: "resize", cols, rows} | {type: "kill"}.
    -- Servidor → navegador: "o" + salida cruda del pty | "c" + JSON de control (hello | exit).
    -- Sin ningún socket enganchado por 30 min, el supervisor recoge la shell; todo muere con lampson.
    route "GET /w/:slug/api/term" requires auth
        private
        socket
            state_set("lampson:last_used", now())
            let id be when contains(query, "id") then text(query.id) otherwise ""
            when id == "" or not term.alive(id)
                set id to term.start(120, 32)          -- nothing = ya hay MAX_TERMS abiertas
            when id == nothing
                ws_send(socket, "c" + json_encode({"type": "exit", "code": -1, "error": "too_many"}))
            otherwise
                let st be term.state(id)
                ws_send(socket, "c" + json_encode({"type": "hello", "id": id, "shell": st["shell"], "pid": st["pid"], "cwd": st["cwd"]}))
                let sub be bus_subscribe("term.out." + id)
                -- el replay vuelve marcado con este id de socket: otra pestaña abierta no lo repite
                let me be text(floor(now() * 1000)) + "-" + text(floor(random() * 100000))
                term.ctl(id, {"k": "replay", "to": me})
                while true
                    let ev be select({"ui": socket, "sh": sub}, 20)
                    when ev == nothing
                        when not term.alive(id)
                            stop
                        term.ctl(id, {"k": "ping"})           -- «sigo acá»: sin pings se recoge la shell
                    otherwise when ev["name"] == "ui"
                        when ev["type"] == "close"
                            stop
                        otherwise when ev["type"] == "binary"
                            term.ctl(id, {"k": "in", "d": as_text(ev["data"])})
                        otherwise
                            let m be json_decode(ev["data"])
                            when m["type"] == "in"
                                term.ctl(id, {"k": "in", "d": m["data"]})
                            otherwise when m["type"] == "resize"
                                term.ctl(id, {"k": "resize", "cols": m["cols"], "rows": m["rows"]})
                            otherwise when m["type"] == "kill"
                                term.kill(id)                  -- cerrar la pestaña SÍ mata la shell, a pedido
                    otherwise
                        let d be ev["data"]
                        when d["k"] == "exit"
                            ws_send(socket, "c" + json_encode({"type": "exit", "code": d["code"]}))
                            stop
                        otherwise when d["k"] == "replay"
                            when d["to"] == me and d["d"] != ""
                                ws_send(socket, "o" + d["d"])
                        otherwise
                            ws_send(socket, "o" + d["d"])
                bus_unsubscribe(sub)

    -- las terminales vivas: la UI las repinta como pestañas al cargar (después de un F5 siguen ahí)
    route "GET /w/:slug/api/terms" requires auth
        private
        give {"terminals": term.list(), "max": term.MAX_TERMS}

    route "GET /w/:slug/api/update" requires auth
        private
        give update.check()

    route "POST /w/:slug/api/update" requires auth
        private
        give {"result": update.apply()}

    route "GET /w/:slug/api/git" requires auth
        private
        give git.status()

    route "GET /w/:slug/api/memory" requires auth
        private
        -- ok=false: el link memory/ del workspace está roto (la UI lo dice; el agente ya lo sabe por el prompt)
        give {"dir": memo.dir(), "ok": memo.available(), "notes": memo.list()}

    route "GET /w/:slug/api/memory/note" requires auth
        private
        when not contains(query, "name")
            give fail(400, "name required")
        give {"name": query.name, "content": memo.note_read(query.name)}

    -- traza legible de una sesión (ver lib/trace.syn)
    route "GET /w/:slug/api/trace" requires auth
        private
        when not contains(query, "session")
            give fail(400, "session required")
        when not matches(query.session, "[A-Za-z0-9_-]{1,40}")
            give fail(400, "bad session id")
        let n be when contains(query, "tail") then floor(number(query.tail)) otherwise 400
        give {"session": query.session, "file": trace.file_of(query.session), "trace": trace.tail(query.session, n)}

    -- modelos que declara la API del proveedor (para no tipear nombres a ciegas: DeepSeek es case-sensitive)
    route "GET /w/:slug/api/models" requires auth
        private
        let pname be when contains(query, "provider") then lower(text(query.provider)) otherwise ""
        let cfg be provider.config_for(pname, "")
        give provider.list_models(cfg)

    route "GET /w/:slug/api/todo" requires auth
        private
        -- ?session=<id> → la lista de esa sesión; sin query, la de la sesión en curso
        when contains(query, "session") and matches(query.session, "[A-Za-z0-9_-]{1,40}")
            give {"items": todo.load(query.session)}
        give {"items": todo.load(nothing)}

    route "GET /w/:slug/api/mcp" requires auth
        private
        give {"servers": mcp.summary(), "global": mcp.GLOBAL_CONFIG, "project": mcp.PROJECT_CONFIG}

    -- conectar un server MCP desde la UI: se escribe en el mcp.json del scope y arranca su supervisor
    route "POST /w/:slug/api/mcp/add" requires auth
        private
        expect body {name: text, command: text}
        let b be json of request
        let scope be when contains(b, "scope") then lower(text(b["scope"])) otherwise "global"
        let envm be when contains(b, "env") then b["env"] otherwise {}
        try
            give {"ok": true, "result": mcp.add_server(text(b["name"]), text(b["command"]), envm, scope), "servers": mcp.summary()}
        recover err
            give fail(400, text(err))

    route "POST /w/:slug/api/mcp/remove" requires auth
        private
        expect body {name: text}
        let b be json of request
        try
            give {"ok": true, "result": mcp.remove_server(text(b["name"])), "servers": mcp.summary()}
        recover err
            give fail(400, text(err))

    -- language servers (navegación semántica): listar, agregar (preset o comando propio), quitar
    route "GET /w/:slug/api/lsp" requires auth
        private
        give {"servers": lsp.summary(), "presets": lsp.PRESETS, "global": lsp.GLOBAL_CONFIG, "project": lsp.PROJECT_CONFIG}

    route "POST /w/:slug/api/lsp/add" requires auth
        private
        expect body {name: text}
        let b be json of request
        let scope be when contains(b, "scope") then lower(text(b["scope"])) otherwise "global"
        let cmd be when contains(b, "command") then text(b["command"]) otherwise nothing
        let langs be when contains(b, "languages") then b["languages"] otherwise nothing
        try
            give {"ok": true, "result": lsp.add_server(text(b["name"]), cmd, langs, scope), "servers": lsp.summary()}
        recover err
            give fail(400, text(err))

    route "POST /w/:slug/api/lsp/remove" requires auth
        private
        expect body {name: text}
        let b be json of request
        try
            give {"ok": true, "result": lsp.remove_server(text(b["name"])), "servers": lsp.summary()}
        recover err
            give fail(400, text(err))

    -- plugins (tools propias): listar y encender/apagar desde la barra superior de la UI
    route "GET /w/:slug/api/plugins" requires auth
        private
        give {"plugins": plugins.summary(), "global": plugins.GLOBAL_DIR, "project": plugins.PROJECT_DIR}

    -- el usuario corre una tool de un plugin encendido él mismo (sin pasar por el modelo)
    route "POST /w/:slug/api/plugins/run" requires auth
        private
        expect body {tool: text}
        let b be json of request
        let args be when contains(b, "args") then b["args"] otherwise {}
        try
            give {"ok": true, "output": plugins.call(text(b["tool"]), args)}
        recover err
            give fail(400, text(err))

    route "POST /w/:slug/api/plugins/remove" requires auth
        private
        expect body {name: text}
        let b be json of request
        try
            give {"ok": true, "result": plugins.remove(text(b["name"])), "plugins": plugins.summary()}
        recover err
            give fail(400, text(err))

    route "POST /w/:slug/api/plugins/toggle" requires auth
        private
        expect body {name: text}
        let b be json of request
        let on be contains(b, "enabled") and b["enabled"] == true
        try
            give {"ok": true, "result": plugins.set_enabled(text(b["name"]), on), "plugins": plugins.summary()}
        recover err
            give fail(400, text(err))

    route "GET /w/:slug/api/agents" requires auth
        private
        agents.prune(10, 1800)
        give {"agents": agents.list_children()}

    -- Eventos en vivo para la UI (SSE): lo que publican los supervisores de procesos (proc.<name>: líneas y
    -- cambios de estado) y los subagentes (subagent.started|done|<id>). Un bus por programa; cada cliente
    -- tiene su cola acotada (drop_oldest). Heartbeat cada 25 s para que el proxy/navegador no cierre.
    route "GET /w/:slug/api/events" requires auth
        private
        stream
            state_set("lampson:last_used", now())
            let sub be bus_subscribe(["proc.*", "subagent.*", "mcp.*", "approval.*", "schedule.*", "team.*"], {"max_queue": 512})
            let open be true
            while open
                let ev be bus_recv(sub, 25)
                try
                    when ev == nothing
                        send {"topic": "ping"} as "event"
                    otherwise
                        send {"topic": ev["topic"], "data": ev["data"]} as "event"
                recover err
                    set open to false
            bus_unsubscribe(sub)

    route "GET /w/:slug/api/agents/log" requires auth
        private
        when not contains(query, "id")
            give fail(400, "id required")
        when not matches(query.id, "[a-z]+-[0-9]+")
            give fail(400, "bad id")
        try
            let meta be nothing
            try
                set meta to json_decode(read_file(agents.DIR + "/" + query.id + ".json"))
            recover e2
                set meta to nothing
            give {"id": query.id, "log": read_file(agents.DIR + "/" + query.id + ".log"), "agent": meta}
        recover err
            give fail(404, "no such sub-agent")

    route "POST /w/:slug/api/agents/stop" requires auth
        private
        expect body {id: text}
        let b be json of request
        when not matches(b["id"], "[a-z]+-[0-9]+")
            give fail(400, "bad id")
        write_file(agents.DIR + "/" + b["id"] + ".stop", "stop")
        bus_publish("subagent." + b["id"], {"kind": "stop", "line": "stop requested from the UI"})
        give {"result": "stop requested for " + b["id"]}

    route "GET /w/:slug/api/proc" requires auth
        private
        give {"processes": proc.list()}

    route "GET /w/:slug/api/proc/log" requires auth
        private
        when not contains(query, "name")
            give fail(400, "name required")
        let n be when contains(query, "tail") then number(query.tail) otherwise 200
        give {"name": query.name, "running": proc.alive(query.name), "log": proc.logs(query.name, n)}

    route "GET /w/:slug/api/ports" requires auth
        private
        give {"ports": proc.listeners()}

    route "POST /w/:slug/api/ports/kill" requires auth
        private
        expect body {pid: number}
        let b be json of request
        give {"result": proc.kill_pid(b["pid"])}

    route "POST /w/:slug/api/proc/stop" requires auth
        private
        expect body {name: text}
        let b be json of request
        give {"result": proc.halt(b["name"])}

    route "GET /w/:slug/api/file" requires auth
        private
        when not contains(query, "path")
            give fail(400, "path required")
        give tree.file_content(query.path)

    -- explorador: nuevo archivo/carpeta, renombrar, mover, copiar/duplicar, borrar (lib/fs.syn; solo dentro
    -- del workspace, nunca pisa un destino). {op, path, name?, to?, content?} → {ok, result: {path, is_dir}}
    route "POST /w/:slug/api/fs" requires auth
        private
        expect body {op: text, path: text}
        let b be json of request
        try
            give {"ok": true, "result": fs.apply(b)}
        recover err
            give fail(400, text(err))

    -- configuración general (rueda de la UI): zona horaria, URL pública, webhook… → .lampson/config.json
    route "GET /w/:slug/api/settings/values" requires auth
        private
        give {"values": settings.values(), "tz_detected": schedule.tz_offset()}

    route "POST /w/:slug/api/settings/values" requires auth
        private
        let b be json of request
        try
            each k in keys(b)
                settings.set_value(k, b[k])
            -- la zona horaria cacheada en el blackboard se recalcula
            share nothing as "lampson:tz"
            give {"ok": true, "values": settings.values(), "tz_detected": schedule.tz_offset()}
        recover err
            give fail(400, text(err))

    -- computer use (lib/computer.syn): estado del driver externo (instalado, versión, doctor) y encendido/apagado.
    -- Lampson no instala el driver: si falta, `install` trae el comando oficial y la UI lo muestra.
    route "GET /w/:slug/api/computer" requires auth
        private
        give computer.status()

    route "POST /w/:slug/api/computer" requires auth
        private
        let b be json of request
        try
            when contains(b, "enabled")
                settings.set_value("computer_use", when b["enabled"] == true then "1" otherwise "")
                computer.reset_state()
                when b["enabled"] != true
                    computer.stop_driver()
            when contains(b, "max_tabs")
                settings.set_value("computer_max_tabs", text(b["max_tabs"]))
            when contains(b, "grant_profile")
                settings.set_value("computer_grant_profile", when b["grant_profile"] == true then "1" otherwise "")
            give {"ok": true, "status": computer.status()}
        recover err
            give fail(400, text(err))

    -- el juez de decisión (lib/judge.syn): una credencial de Lampson, no de computer use. El runtime lo lee al
    -- arrancar el proceso, así que cambiarlo reinicia este workspace solo en ~3 s (la UI espera y recarga).
    route "GET /w/:slug/api/judge" requires auth
        private
        give jdg.status()

    route "POST /w/:slug/api/judge" requires auth
        private
        let b be json of request
        try
            let cur be jdg.status()
            let m be when contains(b, "mode") then text(b["mode"]) otherwise cur["mode"]
            let model be when contains(b, "model") then text(b["model"]) otherwise nothing
            let key be when contains(b, "typesafe_key") then text(b["typesafe_key"]) otherwise nothing
            let r be jdg.configure(m, model, key)
            when not r["ok"]
                give fail(400, r["error"])
            let restarting be false
            when env("LAMPSON_WS", "") != ""
                workspaces.restart_ws_later(env("LAMPSON_WS", ""))
                set restarting to true
            give {"ok": true, "status": jdg.status(), "restarting": restarting}
        recover err
            give fail(400, text(err))

    -- aprobaciones (lib/approvals.syn): las del chat y las de tareas programadas comparten la cola
    route "POST /w/:slug/api/approve" requires auth
        private
        expect body {id: text, decision: bool}
        let b be json of request
        give {"ok": approvals.answer(text(b["id"]), b["decision"])}

    route "GET /w/:slug/api/approvals" requires auth
        private
        give {"approvals": api.approvals_view(approvals.list()), "public_url": approvals.public_url(), "webhook": approvals.webhook_url() != ""}

    -- link de decisión (PÚBLICO a propósito: lo abre el humano desde el teléfono; el token de un solo uso es la
    -- autorización, como en el `approve` nativo de Synsema bajo serve). GET porque un link en un chat es un GET.
    route "GET /w/:slug/approve/:id/:token"
        private
        let d be when contains(query, "d") then lower(text(query.d)) otherwise ""
        when d != "yes" and d != "no"
            give html(approvals.html_page("¿Permitir?", "<a href='?d=yes' style='display:inline-block;padding:10px 18px;border-radius:4px;background:#1d1c1a;color:#fff;text-decoration:none;margin-right:10px'>Sí, permitir</a> <a href='?d=no' style='display:inline-block;padding:10px 18px;border-radius:4px;border:1px solid #a33;color:#a33;text-decoration:none'>No, denegar</a>"))
        let r be approvals.answer_with_token(text(params.id), text(params.token), d == "yes")
        when not r["ok"]
            give html(approvals.html_page("Este link ya no sirve", "La aprobación venció, ya fue respondida o el link no es válido (" + r["why"] + ")."))
        give html(approvals.html_page(when d == "yes" then "✓ Permitido" otherwise "✗ Denegado", "Lampson sigue con la tarea. Podés cerrar esta pestaña."))

    -- tareas programadas (lib/schedule.syn): listar, crear, quitar, encender/apagar, correr ahora, log
    route "GET /w/:slug/api/schedules" requires auth
        private
        let age be schedule.daemon_age()
        -- este proceso tiene su propio tick (cron_every): las tareas corren mientras la web esté abierta
        give {"tasks": schedule.summary(), "tick": schedule.TICK_SECONDS, "alive": true, "heartbeat_age": age, "mount_ok": schedule.mount_ok(), "workspace": env("LAMPSON_WORKSPACE", ""), "tz": schedule.tz_offset(), "plugins": plugins.summary()}

    route "POST /w/:slug/api/schedules/add" requires auth
        private
        let b be json of request
        try
            let t be schedule.add(b)
            give {"ok": true, "task": t, "result": "programada «" + t["name"] + "»: " + schedule.describe_plan(t["plan"]) + " · próxima " + schedule.fmt_local(t["next_run"])}
        recover err
            give fail(400, text(err))

    route "POST /w/:slug/api/schedules/remove" requires auth
        private
        expect body {id: text}
        let b be json of request
        try
            give {"ok": true, "result": schedule.remove(text(b["id"]))}
        recover err
            give fail(400, text(err))

    route "POST /w/:slug/api/schedules/toggle" requires auth
        private
        expect body {id: text}
        let b be json of request
        let on be contains(b, "enabled") and b["enabled"] == true
        try
            give {"ok": true, "result": schedule.set_enabled(text(b["id"]), on)}
        recover err
            give fail(400, text(err))

    -- correr ahora: la marca run_now la levanta el próximo tick (así el request no se queda minutos abierto
    -- y la corrida vive en el hilo del cron, no en el del request)
    route "POST /w/:slug/api/schedules/run" requires auth
        private
        expect body {id: text}
        let b be json of request
        try
            let t be schedule.request_run(text(b["id"]))
            give {"ok": true, "result": "«" + t["name"] + "» corre en el próximo tick (≤ " + text(schedule.TICK_SECONDS) + " s)"}
        recover err
            give fail(400, text(err))

    route "GET /w/:slug/api/schedules/log" requires auth
        private
        when not contains(query, "id")
            give fail(400, "id required")
        let n be when contains(query, "tail") then floor(number(query.tail)) otherwise 300
        give {"id": query.id, "log": schedule.log_tail(query.id, n), "task": schedule.get(query.id)}

    route "POST /w/:slug/api/chat" requires auth
        private
        expect body {message: text}
        let b be json of request
        let message be b["message"]
        let sid be when contains(b, "session") then text(b["session"]) otherwise ""
        let want be when contains(b, "agent") then lower(text(b["agent"])) otherwise "build"
        let mode be when contains(b, "permission") then lower(text(b["permission"])) otherwise lower(env("LAMPSON_PERMISSION", "ask"))
        when mode != "ask" and mode != "yolo" and mode != "strict"
            set mode to "ask"
        let pname be when contains(b, "provider") then lower(text(b["provider"])) otherwise ""
        let pmodel be when contains(b, "model") then text(b["model"]) otherwise ""
        state_set("lampson:last_used", now())
        stream
            -- el runtime (lib/runtime.syn) ya traza cada evento en .lampson/trace/<sid>.log: acá solo se reenvían por SSE
            task emit(kind, data, tag)
                send {"kind": kind, "data": data, "tag": tag} as "event"
            -- aprobación humana: la cola de lib/approvals.syn (id + token) — la UI responde por SSE/POST /api/approve,
            -- y si hay webhook/LAMPSON_PUBLIC_URL también llega un link al canal del usuario (aprobar desde el móvil)
            task ask_web(name, args, why)
                let id be approvals.open("chat", permission.describe_call(name, args), why, APPROVAL_TIMEOUT)
                send {"kind": "approval_request", "data": {"id": id, "name": name, "args": args, "why": why, "timeout": APPROVAL_TIMEOUT}} as "event"
                let t0 be now()
                let ok be approvals.wait(id, APPROVAL_TIMEOUT)
                send {"kind": "approval_result", "data": {"id": id, "approved": ok, "timeout": (not ok) and now() - t0 >= APPROVAL_TIMEOUT - 1}} as "event"
                give ok
            task on_start(info)
                set sid to info["session"]
                send {"kind": "session", "data": sid} as "event"
                send {"kind": "mode", "data": {"agent": info["agent"], "permission": info["mode"], "provider": info["provider"], "model": info["model"], "has_key": info["has_key"]}} as "event"
            -- worker es interno de delegate: por la API tampoco se elige como agente de sesión
            when not contains(runtime.names(), want)
                set want to "build"
            let sobre be {"to": want, "session": sid, "from": {"id": "", "name": "", "kind": "human"}, "text": message, "images": [], "channel": "web", "meta": {}}
            let hooks be {"mode": mode, "provider": pname, "model": pmodel, "ask_fn": ask_web, "on_event": emit, "on_start": on_start}
            when starts_with(trim(message), "!")
                -- comando del USUARIO: sin política de permisos, salida al contexto; el modelo no interviene
                let o be runtime.open(sobre, hooks)
                let cfg be o["ctx"]["cfg"]
                on_start({"session": o["session"], "agent": o["ctx"]["agent"], "thread": o["thread"], "mode": o["mode"], "provider": cfg["provider"], "model": cfg["model"], "has_key": cfg["has_key"]})
                when o["note"] != ""
                    trace.event(sid, "inbox", o["note"], "")
                    send {"kind": "inbox", "data": o["note"], "tag": ""} as "event"
                let cmd be trim(slice(trim(message), 1, length(trim(message))))
                let bash_tool be agents.registry_for("build")["bash"]
                send {"kind": "tool_call", "data": {"id": "user", "name": "bash", "args": {"command": cmd}}} as "event"
                let out be call_tool(bash_tool, {"command": cmd, "timeout": 600})
                send {"kind": "tool_result", "data": {"call": {"id": "user", "name": "bash", "args": {"command": cmd}}, "output": out}} as "event"
                let messages be append(o["messages"], {"role": "user", "content": "[The user ran this command in the shell themselves]\n$ " + cmd + "\n" + tools.truncate(out, 6000)})
                runtime.save(o, messages)
                send {"kind": "done", "data": {"text": "", "steps": 0, "usage": {"input": 0, "output": 0}, "stopped": "user_command", "session": sid}} as "event"
            otherwise
                -- imágenes pegadas en la UI: [{media_type, data(base64)}] — el cliente ya las redujo; tope 5 MB por mensaje
                let images be []
                when contains(b, "images")
                    let total be 0
                    each im in b["images"]
                        when contains(im, "data") and contains(im, "media_type")
                            set total to total + length(im["data"])
                            when total <= 5000000
                                let entry be {"media_type": text(im["media_type"]), "data": text(im["data"])}
                                when contains(im, "w") and contains(im, "h")
                                    set entry to {"media_type": text(im["media_type"]), "data": text(im["data"]), "w": floor(number(im["w"])), "h": floor(number(im["h"]))}
                                set images to append(images, entry)
                set sobre["images"] to images
                let result be runtime.deliver(sobre, hooks)
                send {"kind": "done", "data": {"text": result["text"], "steps": result["steps"], "usage": result["usage"], "stopped": result["stopped"], "session": result["session"]}} as "event"

    -- ---------- API /v1 para apps (lib/api.syn · spec/engine.md fase 2) ----------
    -- Sin `requires auth`: bajo el hub todo llega por loopback y check_client lo daría por bueno. La API exige SIEMPRE
    -- una API key (Authorization: Bearer lk_…), que valida api.authorize.
    -- el OpenAPI de la API pública (solo /v1: el resto lleva `private`), por la ruta /v1 que el hub sí reenvía
    route "GET /w/:slug/v1/openapi.json"
        private
        give respond(openapi_json(), "application/json")

    route "GET /w/:slug/v1/agents" requires auth
        let a be api.authorize(headers of request)
        when not a["ok"]
            give api.refuse(a)
        give {"agents": api.agents_for(a["key"])}

    route "POST /w/:slug/v1/messages" requires auth
        expect body {text: text}
        let a be api.authorize(headers of request)
        when not a["ok"]
            give api.refuse(a)
        let p be api.parse(json of request, a["key"])
        when not p["ok"]
            give fail(p["status"], p["error"])
        state_set("lampson:last_used", now())
        -- todo pasa por el buzón de la conversación (lib/mailbox.syn): fila, espera de silencio, mitad de turno
        let mo be api.mailbox_opts(p["sobre"])
        when p["callback"] != ""
            let jid be mailbox.new_id()
            api.create_job(jid, a["key"], p["sobre"], p["callback"])
            mailbox.submit(p["sobre"], merge(mo, {"id": jid, "callback": p["callback"], "job": true}))
            give respond(json_encode({"job": jid, "status": "queued"}), "application/json", 202)
        let s be mailbox.submit(p["sobre"], mo)
        give mailbox.wait(s["id"])

    route "POST /w/:slug/v1/messages/stream" requires auth
        expect body {text: text}
        let a be api.authorize(headers of request)
        when not a["ok"]
            give api.refuse(a)
        let p be api.parse(json of request, a["key"])
        when not p["ok"]
            give fail(p["status"], p["error"])
        state_set("lampson:last_used", now())
        let sobre be p["sobre"]
        let mo be api.mailbox_opts(sobre)
        -- suscripto ANTES de encolar: el worker publica en el bus los eventos de la conversación
        let mid be mailbox.new_id()
        let sub be bus_subscribe("lampson.mb." + mailbox.key_of(sobre, mid))
        mailbox.submit(sobre, merge(mo, {"id": mid}))
        stream
            let finished be false
            let deadline be now() + mailbox.WAIT_TIMEOUT
            while not finished and now() < deadline
                let ev be bus_recv(sub, 1)
                when ev != nothing
                    let d be ev["data"]
                    when d["kind"] == "done"
                        -- el done de un lote anterior de la misma conversación no es el nuestro
                        when contains(d["data"]["batch"], mid)
                            state_delete("mb:res:" + mid)
                            send d as "event"
                            set finished to true
                    otherwise
                        send d as "event"
                -- por si el done pasó mientras no estábamos escuchando
                when not finished
                    let r be state_get("mb:res:" + mid, nothing)
                    when r != nothing
                        state_delete("mb:res:" + mid)
                        send {"kind": "done", "data": r, "tag": "", "agent": r["agent"], "thread": r["thread"]} as "event"
                        set finished to true
            bus_unsubscribe(sub)

    -- MCP por HTTP (lib/mcp_server.syn, "Streamable HTTP" con respuestas JSON): Claude, Cursor u otro agente usan los
    -- agentes de este workspace desde cualquier lado, con la API key. Una notificación → 202 sin cuerpo.
    route "POST /w/:slug/v1/mcp" requires auth
        expect body {jsonrpc: text, method: text}
        let a be api.authorize(headers of request)
        when not a["ok"]
            give with_header(fail(a["status"], a["error"]), "WWW-Authenticate", "Bearer")
        state_set("lampson:last_used", now())
        let offered be apply((x) => x["id"], api.agents_for(a["key"]))
        when length(offered) == 0
            give fail(403, "this API key has no agents")
        let resp be mcp_server.handle(json of request, offered, api.mcp_deliver)
        when resp == nothing
            give respond("", "application/json", 202)
        give resp

    -- la misma conversación MCP pero con respuestas SSE: si el pedido trae params._meta.progressToken, cada paso del
    -- agente sale como notifications/progress antes de la respuesta. Ruta aparte porque en Synsema una ruta transmite
    -- o no (un `stream` dentro de un `when` no transmite) y /v1/mcp debe contestar 202 vacío a las notificaciones.
    route "POST /w/:slug/v1/mcp/stream" requires auth
        expect body {jsonrpc: text, method: text}
        let a be api.authorize(headers of request)
        let offered be when a["ok"] then apply((x) => x["id"], api.agents_for(a["key"])) otherwise []
        let req be json of request
        let ptoken be nothing
        when contains(req, "params") and type_of(req["params"]) == "map" and contains(req["params"], "_meta") and type_of(req["params"]["_meta"]) == "map" and contains(req["params"]["_meta"], "progressToken")
            set ptoken to req["params"]["_meta"]["progressToken"]
        stream
            -- un ask por el buzón, mirando el bus de la conversación para el progreso
            task deliver_sse(sobre, mode)
                let mid be mailbox.new_id()
                let sub be bus_subscribe("lampson.mb." + mailbox.key_of(sobre, mid))
                mailbox.submit(sobre, {"mode": mode, "buffer": mailbox.buffer_of(runtime.get(sobre["to"]), false), "id": mid})
                let n be 0
                let result be nothing
                let deadline be now() + mailbox.WAIT_TIMEOUT
                while result == nothing and now() < deadline
                    let ev be bus_recv(sub, 1)
                    when ev != nothing
                        let d be ev["data"]
                        when d["kind"] == "done" and contains(d["data"]["batch"], mid)
                            set result to d["data"]
                        otherwise when ptoken != nothing and (d["kind"] == "assistant" or d["kind"] == "tool_call")
                            set n to n + 1
                            let what be when d["kind"] == "tool_call" then "using " + text(d["data"]["name"]) otherwise slice(text(d["data"]), 0, 200)
                            send {"jsonrpc": "2.0", "method": "notifications/progress", "params": {"progressToken": ptoken, "progress": n, "message": what}} as "message"
                    when result == nothing
                        let r be state_get("mb:res:" + mid, nothing)
                        when r != nothing
                            set result to r
                state_delete("mb:res:" + mid)
                bus_unsubscribe(sub)
                give when result == nothing then {"agent": sobre["to"], "thread": sobre["thread"], "session": "", "text": "", "steps": 0, "usage": {"input": 0, "output": 0, "cached": 0}, "stopped": "error: timed out"} otherwise result
            when not a["ok"]
                send {"jsonrpc": "2.0", "id": nothing, "error": {"code": -32001, "message": a["error"]}} as "message"
            otherwise when length(offered) == 0
                send {"jsonrpc": "2.0", "id": nothing, "error": {"code": -32001, "message": "this API key has no agents"}} as "message"
            otherwise
                state_set("lampson:last_used", now())
                let resp be mcp_server.handle(req, offered, deliver_sse)
                when resp != nothing
                    send resp as "message"

    route "GET /w/:slug/v1/mcp"
        give fail(405, "this MCP server does not open a server-to-client stream; POST JSON-RPC messages")

    -- ---------- panel de la UI: API keys y canales (privadas: son de la UI, autenticadas por el hub/local) ----------
    -- ---------- EQUIPOS Y OBJETIVOS: su pantalla propia (public/teams.html) y la API privada que la alimenta ----------
    route "GET /w/:slug/equipos"
        private
        give teams_page(request, params.slug, "/equipos")
    route "GET /w/:slug/equipos/*rest"
        private
        give teams_page(request, params.slug, "/equipos/" + params.rest)
    route "GET /w/:slug/objetivos/*rest"
        private
        give teams_page(request, params.slug, "/objetivos/" + params.rest)

    route "GET /w/:slug/api/objectives" requires auth
        private
        let rows be apply(teams.obj_list(), (o) => {"id": o["id"], "ref": "O-" + text(o["id"]), "agent": o["agent"], "team": o["team"], "text": o["text"], "status": o["status"], "progress": o["progress"], "question": o["question"], "question_kind": o["question_kind"], "turns": o["turns"], "spent": o["spent"], "budget_tokens": o["budget_tokens"], "updated_at": o["updated_at"], "created_at": o["created_at"], "created_by": o["created_by"], "from_obj": o["from_obj"], "pass_pending": o["pass_pending"] != "", "working": mailbox.working(o["agent"], teams.obj_scope(o))})
        give {"objectives": rows, "teams": apply(teams.all(), (t) => {"id": t["id"], "name": t["name"], "lead": teams.lead_of(t), "description": t["description"]}), "agents": apply(where(runtime.names(), (n) => not runtime.get(n)["builtin"]), (n) => {"id": n, "description": runtime.get(n)["description"]})}

    route "GET /w/:slug/api/objectives/:id" requires auth
        private
        let o be teams.obj_get(floor(number(params.id)))
        when o == nothing
            give fail(404, "no such objective")
        let v be api.objective_view(o)
        set v["working"] to mailbox.working(o["agent"], teams.obj_scope(o))
        give v

    route "POST /w/:slug/api/objectives/add" requires auth
        private
        expect body {text: text}
        let c be api.create_objective(json of request, {"name": "person", "agents": ["*"]})
        when not c["ok"]
            give fail(c["status"], c["error"])
        give api.objective_view(teams.obj_get(c["id"]))

    route "POST /w/:slug/api/objectives/:id/reply" requires auth
        private
        let b be json of request
        try
            give api.objective_view(teams.obj_reply(floor(number(params.id)), when contains(b, "text") and b["text"] != nothing then text(b["text"]) otherwise "", contains(b, "approved") and b["approved"] == true, "person"))
        recover err
            give fail(409, regex_replace(text(err), "^.*?:\\d+:\\d+: ", ""))

    route "GET /w/:slug/api/objectives/:id/facts" requires auth
        private
        let o be teams.obj_get(floor(number(params.id)))
        when o == nothing
            give fail(404, "no such objective")
        give {"facts": api.obj_facts(o)}

    route "POST /w/:slug/api/objectives/:id/diagnose" requires auth
        private
        let o be teams.obj_get(floor(number(params.id)))
        when o == nothing
            give fail(404, "no such objective")
        let r be api.obj_analyze(o)
        when not r["ok"]
            give fail(502, r["error"])
        give r

    route "POST /w/:slug/api/objectives/:id/act" requires auth
        private
        let o be teams.obj_get(floor(number(params.id)))
        when o == nothing
            give fail(404, "no such objective")
        let r be api.obj_act(o, json of request)
        when not r["ok"]
            give fail(400, r["error"])
        give r

    route "POST /w/:slug/api/objectives/:id/cancel" requires auth
        private
        give api.objective_view(teams.obj_cancel(floor(number(params.id)), "person"))

    route "GET /w/:slug/api/teams" requires auth
        private
        give api.teams_view()

    route "POST /w/:slug/api/teams/save" requires auth
        private
        let r be api.save_team(json of request)
        when not r["ok"]
            give fail(400, r["error"])
        give api.teams_view()

    route "POST /w/:slug/api/teams/seat-tokens" requires auth
        private
        expect body {agent: text}
        let r be api.seat_tokens(json of request)
        when not r["ok"]
            give fail(400, r["error"])
        give r

    route "POST /w/:slug/api/teams/delete" requires auth
        private
        expect body {id: text}
        let r be api.delete_team(json of request)
        when not r["ok"]
            give fail(400, r["error"])
        give r

    route "GET /w/:slug/api/keys" requires auth
        private
        let pub be approvals.public_url()
        let base be (when pub != "" then pub otherwise "http://127.0.0.1:8080") + "/w/" + env("LAMPSON_WS", "local") + "/v1"
        give {"keys": apikeys.list(), "api_url": base + "/messages", "mcp_url": base + "/mcp", "public": pub != "", "agents": runtime.names()}

    route "POST /w/:slug/api/keys/add" requires auth
        private
        let b be json of request
        let ag be when b != nothing and contains(b, "agents") and type_of(b["agents"]) == "list" then b["agents"] otherwise []
        each a in ag
            when a != "*" and not contains(runtime.names(), text(a))
                give fail(400, "no agent named '" + text(a) + "'")
        let cbs be when b != nothing and contains(b, "callbacks") and type_of(b["callbacks"]) == "list" then b["callbacks"] otherwise []
        each cb in cbs
            when not (starts_with(text(cb), "https://") or starts_with(text(cb), "http://"))
                give fail(400, "a callback prefix must be an http(s) URL")
        let ko be {"callbacks": cbs}
        when b != nothing and contains(b, "rate") and b["rate"] != nothing and text(b["rate"]) != ""
            set ko["rate"] to floor(number(b["rate"]))
        give apikeys.create_with(when b != nothing and contains(b, "name") then text(b["name"]) otherwise "", ag, ko)

    route "POST /w/:slug/api/keys/remove" requires auth
        private
        expect body {id: text}
        give {"ok": apikeys.remove(text((json of request)["id"]))}

    route "GET /w/:slug/api/channels" requires auth
        private
        give {"channels": channels.summary(approvals.public_url(), env("LAMPSON_WS", "local")), "public": approvals.public_url() != ""}

    route "POST /w/:slug/api/channels/toggle" requires auth
        private
        expect body {name: text, on: bool}
        let b be json of request
        give {"ok": plugins.set_enabled(text(b["name"]), b["on"])}

    route "POST /w/:slug/api/channels/setup" requires auth
        private
        expect body {name: text}
        give channels.setup_channel(text((json of request)["name"]), approvals.public_url(), env("LAMPSON_WS", "local"))

    -- ---------- canales (lib/channels.syn · spec/engine.md fase 4) ----------
    -- El webhook de la plataforma. Sin auth de Lampson: la firma de la plataforma la verifica el plugin en `receive`
    -- (recibe el body exacto). GET para las verificaciones de webhook (Meta, Slack…), que el plugin contesta con "http".
    route "POST /w/:slug/ch/:name"
        private
        state_set("lampson:last_used", now())
        let r be channels.handle(params.name, {"method": "POST", "path": request.path, "query": query, "headers": headers of request, "body": read_body()})
        give respond(r["body"], r["ctype"], r["status"])

    route "GET /w/:slug/ch/:name"
        private
        let r be channels.handle(params.name, {"method": "GET", "path": request.path, "query": query, "headers": headers of request, "body": ""})
        give respond(r["body"], r["ctype"], r["status"])

    -- OBJETIVOS (lib/teams.syn): lo que le pedís a un agente para que trabaje solo hasta terminarlo
    route "POST /w/:slug/v1/objectives" requires auth
        expect body {text: text}
        let a be api.authorize(headers of request)
        when not a["ok"]
            give api.refuse(a)
        let c be api.create_objective(json of request, a["key"])
        when not c["ok"]
            give fail(c["status"], c["error"])
        state_set("lampson:last_used", now())
        give respond(json_encode(api.objective_view(teams.obj_get(c["id"]))), "application/json", 201)

    route "GET /w/:slug/v1/objectives" requires auth
        let a be api.authorize(headers of request)
        when not a["ok"]
            give api.refuse(a)
        let mine be where(teams.obj_list(), (o) => apikeys.allows(a["key"], o["agent"]))
        give {"objectives": apply(mine, (o) => {"id": o["id"], "ref": "O-" + text(o["id"]), "agent": o["agent"], "text": o["text"], "status": o["status"], "progress": o["progress"], "question": o["question"], "turns": o["turns"], "spent": o["spent"], "updated_at": o["updated_at"]})}

    route "GET /w/:slug/v1/objectives/:id" requires auth
        let a be api.authorize(headers of request)
        when not a["ok"]
            give api.refuse(a)
        let o be api.objective_for(params.id, a["key"])
        when o == nothing
            give fail(404, "no such objective")
        give api.objective_view(o)

    route "POST /w/:slug/v1/objectives/:id/reply" requires auth
        let a be api.authorize(headers of request)
        when not a["ok"]
            give api.refuse(a)
        let o be api.objective_for(params.id, a["key"])
        when o == nothing
            give fail(404, "no such objective")
        let b be json of request
        let txt be when contains(b, "text") and b["text"] != nothing then text(b["text"]) otherwise ""
        let ok be contains(b, "approved") and b["approved"] == true
        try
            give api.objective_view(teams.obj_reply(o["id"], txt, ok, "api:" + a["key"]["name"]))
        recover err
            give fail(409, regex_replace(text(err), "^.*?:\\d+:\\d+: ", ""))

    route "POST /w/:slug/v1/objectives/:id/cancel" requires auth
        let a be api.authorize(headers of request)
        when not a["ok"]
            give api.refuse(a)
        let o be api.objective_for(params.id, a["key"])
        when o == nothing
            give fail(404, "no such objective")
        give api.objective_view(teams.obj_cancel(o["id"], "api:" + a["key"]["name"]))

    route "GET /w/:slug/v1/jobs/:id" requires auth
        let a be api.authorize(headers of request)
        when not a["ok"]
            give api.refuse(a)
        let j be api.job(params.id)
        when j == nothing or j["key"] != a["key"]["id"]
            give fail(404, "no such job")
        give j
