-- run_test.syn — el runtime (lib/runtime.syn) y la puerta `lampson run` (run.syn) contra el mock LLM
-- (tests/mock_llm.syn, que este script arranca en :8765). Lo lanza tests/run.ps1 / run.sh con:
--   LAMPSON_PROVIDER=openai LAMPSON_WIRE=openai LAMPSON_BASE_URL=http://127.0.0.1:8765/v1 LAMPSON_API_KEY=x
-- Vive en la raíz porque un módulo no puede importar ../. Sale con error si algo falla.
require net
require time
require exec
require random
require env("LAMPSON_*")
require env("OS")
require secret("LAMPSON_*")
require file("workspace")
require file("workspace/*")
require file.read("skills")
require file.read("skills/*")
require file.read("plugins")
require file.read("plugins/*")
require file("memory")
require file("memory/*")
require file(".lampson")
require file(".lampson/*")
use "./lib/runtime.syn" as runtime
use "./lib/agents.syn" as agents
use "./lib/session.syn" as session

task lampson_subagent(spec_json)
    give agents.run_child_json(spec_json)

let failures be []
task check(cond, msg)
    when not cond
        set failures to append(failures, msg)
        print("  ✗ " + msg)
    otherwise
        print("  ✓ " + msg)

task rm_file(path)
    when env("OS", "") == "Windows_NT"
        run("cmd", ["/c", "del", "/q", replace(path, "/", "\\")], 10)
    otherwise
        run("rm", ["-f", path], 10)

-- mock LLM
let mock be proc_spawn("synsema", ["serve", "tests/mock_llm.syn"], {"stderr": "merge"})
let up be false
let tries be 0
while not up and tries < 40
    sleep(0.25)
    set tries to tries + 1
    try
        let r be http_get("http://127.0.0.1:8765/v1/models")
        set up to r["status"] > 0
    recover err
        set up to false
check(up, "mock LLM arriba en :8765")

-- agentes del proyecto para el test
let ADIR be runtime.PROJECT_DIR
write_file(ADIR + "/rt-shop.agent.json", json_encode({"id": "rt-shop", "description": "bot de prueba", "system": "Eres el bot de una tienda.", "tools": ["ls"], "steps": 6, "permission": "strict"}))
write_file(ADIR + "/rt-mute.agent.json", json_encode({"id": "rt-mute", "system": "Sin herramientas.", "tools": ["read"]}))

let created be []
let threads be []

print("deliver: un agente del proyecto, sesión por thread")
let events be []
task collect(kind, data, tag)
    set events to append(events, kind)
let started be nothing
task on_start(info)
    set started to info
let r1 be runtime.deliver({"to": "rt-shop", "thread": "whatsapp:+5491100000001", "text": "ls"}, {"on_event": collect, "on_start": on_start})
set created to append(created, r1["session"])
set threads to append(threads, ["rt-shop", "whatsapp:+5491100000001"])
check(r1["stopped"] == "done", "turno terminado: " + r1["stopped"])
check(starts_with(r1["text"], "final ls"), "respuesta del agente: " + slice(r1["text"], 0, 60))
check(r1["agent"] == "rt-shop" and r1["thread"] == "whatsapp:+5491100000001", "resultado con agente y thread")
check(contains(events, "tool_call") and contains(events, "tool_result"), "eventos del loop llegan a la puerta")
check(started != nothing and started["session"] == r1["session"] and started["mode"] == "strict", "on_start antes del turno con sesión y modo del agente")
check(file_exists(".lampson/trace/" + r1["session"] + ".log"), "el runtime trazó el turno")
let r2 be runtime.deliver({"to": "rt-shop", "thread": "whatsapp:+5491100000001", "text": "hola de nuevo"}, {})
check(r2["session"] == r1["session"], "mismo thread → misma sesión")
check(contains(r2["text"], "msgs=6"), "el historial siguió: " + r2["text"])
let r3 be runtime.deliver({"to": "rt-shop", "thread": "whatsapp:+5491100000002", "text": "hola"}, {})
set created to append(created, r3["session"])
set threads to append(threads, ["rt-shop", "whatsapp:+5491100000002"])
check(r3["session"] != r1["session"], "otro cliente → otra sesión")
check(contains(r3["text"], "msgs=2"), "y arranca de cero: " + r3["text"])
let doc be session.load(r1["session"])
check(doc["meta"]["agent"] == "rt-shop" and doc["meta"]["thread"] == "whatsapp:+5491100000001", "la sesión guarda agente y thread")
check(starts_with(doc["messages"][0]["content"], "Eres el bot de una tienda."), "system prompt del agente, no el de código")

print("deliver: el allow-list manda")
let denied be []
task collect_denied(kind, data, tag)
    when kind == "tool_denied"
        set denied to append(denied, data["reason"])
let r4 be runtime.deliver({"to": "rt-mute", "text": "ls"}, {"on_event": collect_denied})
set created to append(created, r4["session"])
check(contains(r4["text"], "unknown tool"), "una tool fuera del allow-list no corre: " + slice(r4["text"], 0, 80))
check(contains(denied, "unknown tool"), "y la puerta ve el rechazo")

print("deliver: sin humano, lo que pide aprobación se deniega")
let r5 be runtime.deliver({"to": "build", "text": "peligro"}, {"mode": "ask", "ask_fn": nothing})
set created to append(created, r5["session"])
check(contains(r5["text"], "DENIED"), "bash peligroso denegado: " + slice(r5["text"], 0, 80))
let unknown_failed be false
try
    runtime.deliver({"to": "nadie", "text": "x"}, {})
recover err
    set unknown_failed to contains(text(err), "no agent named")
check(unknown_failed, "agente inexistente → error claro")

print("lampson run (run.syn) como proceso")
task run_cli(envs)
    let p be proc_spawn("synsema", ["run", "run.syn"], {"env": envs, "stderr": "merge", "line_mode": true, "on_full": "drop_oldest"})
    proc_close_stdin(p)
    let deadline be now() + 60
    let lines be []
    let code be nothing
    while code == nothing and now() < deadline
        let ev be proc_recv(p, 1)
        when ev != nothing
            when ev["type"] == "exit"
                set code to ev["data"]["exit_code"]
            otherwise
                set lines to append(lines, ev["data"])
    proc_close(p)
    give {"code": code, "out": join(lines, "\n")}

task jsonl(out)
    let evs be []
    each l in split(replace(out, "\r", ""), "\n")
        when starts_with(trim(l), "{")
            try
                set evs to append(evs, json_decode(trim(l)))
            recover err
                set evs to evs
    give evs

let c1 be run_cli({"LAMPSON_AGENT": "rt-shop", "LAMPSON_THREAD": "cli:test-1", "LAMPSON_MESSAGE": "ls", "LAMPSON_RUN_JSON": "1"})
set threads to append(threads, ["rt-shop", "cli:test-1"])
let evs be jsonl(c1["out"])
check(c1["code"] == 0, "sale con 0 (code " + text(c1["code"]) + ")")
check(length(evs) > 2 and evs[0]["kind"] == "session", "primero el evento session")
let last be when length(evs) > 0 then evs[length(evs) - 1] otherwise {"kind": ""}
check(last["kind"] == "done" and starts_with(last["data"]["text"], "final ls"), "último: done con la respuesta")
check(length(where(evs, (e) => e["kind"] == "tool_call" and e["agent"] == "rt-shop" and e["thread"] == "cli:test-1")) == 1, "cada evento lleva agente y thread")
check(length(where(evs, (e) => e["kind"] == "busy" or e["kind"] == "idle")) == 0, "sin busy/idle en el JSONL")
when last["kind"] == "done"
    set created to append(created, last["data"]["session"])
let c2 be run_cli({"LAMPSON_AGENT": "rt-shop", "LAMPSON_THREAD": "cli:test-1", "LAMPSON_MESSAGE": "hola"})
check(c2["code"] == 0 and contains(c2["out"], "final directo · msgs=6"), "modo texto: solo la respuesta, y el thread siguió: " + trim(c2["out"]))
let c3 be run_cli({"LAMPSON_AGENT": "nadie", "LAMPSON_MESSAGE": "x"})
check(c3["code"] == 2 and contains(c3["out"], "no agent named"), "agente inexistente → código 2")
let c4 be run_cli({"LAMPSON_AGENT": "rt-shop", "LAMPSON_MESSAGE": ""})
check(c4["code"] == 2 and contains(c4["out"], "empty message"), "mensaje vacío → código 2")

-- limpieza
-- por thread también: si un check falló a mitad, la sesión del thread igual se borra
each t in threads
    let ts be runtime.thread_session(t[0], t[1])
    when ts != "" and not contains(created, ts)
        set created to append(created, ts)
    rm_file(runtime.THREADS_DIR + "/" + runtime.thread_key(t[0], t[1]) + ".json")
each id in created
    session.delete(id)
rm_file(ADIR + "/rt-shop.agent.json")
rm_file(ADIR + "/rt-mute.agent.json")
proc_close(mock)

when length(failures) > 0
    print("run_test: " + text(length(failures)) + " fallas")
    raise("run_test failed")
print("run_test: todo OK")
