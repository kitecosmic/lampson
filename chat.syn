-- chat.syn — Lampson por terminal (REPL)
--
--   synsema run chat.syn                 -- sesión nueva
--   LAMPSON_SESSION=<id> synsema run chat.syn   -- reanudar
--
-- Comandos: /help /new /sessions /resume <id> /tokens /yolo /ask /strict /agent <build|plan|review|explore> /exit
--
-- El ENTRY otorga el superset de capacidades; cada tool declara las suyas y call_tool intersecta.
-- El proyecto objetivo se monta como ./workspace (ver lampson.ps1 / lampson.sh y lib/tools/common.syn).

intent: "Coding agent REPL: the model picks tools from an allow-list, each runs least-privilege in the workspace"

require net
require time
require stdin
require exec
require random
require env("LAMPSON_*")
require env("OS")
require secret("LAMPSON_*")
require file("workspace")
require file("workspace/*")
require file.read("skills")
require file.read("skills/*")
require file.read("plugins")
require file.read("plugins/*")
require file("memory")
require file("memory/*")
require file(".lampson")
require file(".lampson/*")

use "./lib/provider.syn" as provider
use "./lib/tools.syn" as tools
use "./lib/prompt.syn" as prompt
use "./lib/loop.syn" as loop
use "./lib/session.syn" as session
use "./lib/permission.syn" as permission
use "./lib/agents.syn" as agents
use "./lib/tree.syn" as tree
use "./lib/skills.syn" as skills
use "./lib/git.syn" as git
use "./lib/tools/proc.syn" as proc
use "./lib/tools/memo.syn" as memo
use "./lib/update.syn" as update
use "./lib/settings.syn" as settings
use "./lib/trace.syn" as trace
use "./lib/md.syn" as md
use "./lib/diff.syn" as diff
use "./lib/line.syn" as ed
use "./lib/ui.syn" as ui
use "./lib/mcp.syn" as mcp
use "./lib/plugins.syn" as plugins
use "./lib/lsp.syn" as lsp
use "./lib/tools/todo.syn" as todo
use "./lib/schedule.syn" as schedule
use "./lib/sched_run.syn" as sched_run
use "./lib/approvals.syn" as approvals

-- ---------- UI de terminal ----------
-- Colores ANSI (Windows Terminal, PowerShell 7, cualquier terminal moderna). LAMPSON_NO_COLOR=1 los apaga.

let ESC be decode(bytes("1b", "hex"))
let COLOR be env("LAMPSON_NO_COLOR", "") == ""
-- /verbose: mostrar el output completo de cada tool (persistido en .lampson/config.json); si no, se
-- colapsa a OUT_LINES líneas y /out [n] muestra el resultado n-ésimo (desde el último) del turno completo
let saved_cfg be settings.load()
let VERBOSE be contains(saved_cfg, "verbose") and saved_cfg["verbose"] == true
let OUT_LINES be 15
let turn_outputs be []

task c(code, s)
    when not COLOR
        give s
    give ESC + "[" + code + "m" + s + ESC + "[0m"

task cyan(s)
    give c("36;1", s)
task dim(s)
    give c("2", s)
task yellow(s)
    give c("33", s)
-- actividad de tools (▸, $): amarillo atenuado, para que el 33 pleno quede solo como "atención
-- requerida" (⚠ aprobaciones, avisos) — semáforo: actividad ≠ advertencia (2026-08-31)
task act(s)
    give c("2;33", s)
task green(s)
    give c("32", s)
task red(s)
    give c("31", s)

task first_line(s, max)
    let f be split(s, "\n")[0]
    when length(f) > max
        give slice(f, 0, max) + "…"
    give f

task fmt_tokens(n)
    when n >= 1000
        give text(floor(n / 100) / 10) + "k"
    give text(n)

-- resumen de UNA línea del resultado de una tool, según la tool
task summarize(name, out)
    let lines be split(out, "\n")
    when starts_with(out, "ERROR") or starts_with(out, "DENIED")
        give first_line(out, 140)
    when name == "read" and not VERBOSE
        give text(length(lines)) + " líneas"
    when (name == "ls" or name == "find") and not VERBOSE
        -- las primeras entradas en una línea (hasta ~100 chars), y cuántas más hay
        let shown be []
        let used be 0
        each l in lines
            when used < 100 and trim(l) != ""
                set shown to append(shown, trim(l))
                set used to used + length(l) + 2
        let rest be length(lines) - length(shown)
        give text(length(lines)) + (when name == "ls" then " entradas: " otherwise " archivos: ") + join(shown, "  ") + (when rest > 0 then dim("  +" + text(rest)) otherwise "")
    when name == "delegate" and not VERBOSE
        -- una línea por subagente: el encabezado [id · agente · estado · pasos · tokens · log]
        let heads be []
        each l in lines
            when starts_with(trim(l), "[") and contains(l, " steps") or (starts_with(trim(l), "[") and contains(l, " · log:"))
                set heads to append(heads, trim(l))
        when length(heads) == 0
            give first_line(out, 120)
        give join(heads, "\n      ")
    when name == "grep" and not VERBOSE
        let files be {}
        each l in lines
            let f be split(l, ":")[0]
            when trim(l) != ""
                set files[f] to true
        give text(length(lines)) + " coincidencias en " + text(length(keys(files))) + " archivo" + (when length(keys(files)) == 1 then "" otherwise "s") + " · " + first_line(out, 90)
    when name == "bash" or name == "process" or VERBOSE
        -- hasta OUT_LINES líneas del output (todas con /verbose), el resto colapsado → /out
        let shown be []
        each e in enumerate(lines)
            when VERBOSE or e["index"] < OUT_LINES
                set shown to append(shown, when VERBOSE then e["item"] otherwise slice(e["item"], 0, 160))
        let extra be when not VERBOSE and length(lines) > OUT_LINES then "\n      " + dim("(+" + text(length(lines) - OUT_LINES) + " líneas · /out para ver todo)") otherwise ""
        give join(shown, "\n      ") + extra
    give first_line(out, 120)

-- diff de un edit/write (antes/después publicado por la tool en el blackboard) — nothing si no hay
task diff_of(name, out)
    when name != "edit" and name != "write"
        give nothing
    when starts_with(out, "ERROR") or starts_with(out, "DENIED")
        give nothing
    observe "lampson:ui:diff" as d
    when d == nothing
        give nothing
    give diff.diff(d["old"], d["new"], 2, COLOR)

task print_diff(path, d)
    print_diff_with("    ", path, d)

-- lead = lo que va antes del ✓ (la llamada, si se fusionó en la misma línea)
task print_diff_with(lead, path, d)
    let head be green("✓") + " " + c("34", path) + "  " + green("+" + text(d["added"])) + " " + red("−" + text(d["removed"]))
    print(lead + head)
    each l in d["lines"]
        print("      " + l)

-- tools "instantáneas": la llamada se imprime junto con su resultado, en una sola línea
task is_instant(name)
    give name == "read" or name == "ls" or name == "find" or name == "grep" or name == "memory" or name == "edit" or name == "write" or name == "todo" or name == "lsp" or name == "fetch"

let pending_call be ""

-- /out: resultado completo de una tool del turno
task print_full(o)
    when o["diff"] != nothing
        print_diff(o["path"], o["diff"])
    otherwise
        each l in split(o["output"], "\n")
            print("      " + l)

-- ---------- indicador de espera ----------
-- El intérprete principal se bloquea en la llamada al modelo y en cada tool; el que dibuja es un agente
-- (hilo real) que mira el blackboard: `lampson:busy` = {label, kind, since} mientras hay algo en curso.
-- Arranca a dibujar recién a los 0,4 s (las tools instantáneas no parpadean) y suelta la terminal
-- (`lampson:spinner:holding` = false) antes de que el principal vuelva a imprimir.
agent Spinner
    require time
    let frames be ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
    let i be 0
    let drawn be false
    let run be true
    -- MIGA: un agente NO puede abrir la terminal (term_open → nothing) pero sí print+flush. Cada print de un
    -- agente sale con el prefijo "[Spinner_0] " en la línea de abajo: cada frame limpia esa línea (\r ESC[K),
    -- sube una (ESC[1A) y redibuja la suya. Al terminar deja el cursor en la línea del spinner, vacía.
    let clear_here be "\r" + esc + "[K"
    let up be esc + "[1A"
    while run
        observe "lampson:spinner:stop" as st
        observe "lampson:busy" as b
        when st == true
            set run to false
        otherwise when b == nothing
            when drawn
                print(clear_here + up + clear_here + up)
                flush()
                set drawn to false
            share false as "lampson:spinner:holding"
            sleep(0.05)
        otherwise
            let el be now() - b["since"]
            when el >= 0.4
                -- barra de "costo hundido": se llena rápido al principio y cada vez más despacio
                let fill be floor(10 * (1 - exp(0 - el / 40)))
                let bar be ""
                let k be 0
                while k < 10
                    set bar to bar + (when k < fill then "▰" otherwise "▱")
                    set k to k + 1
                let hint be when el > 90 then "  esto está tardando (Ctrl+C corta)" otherwise (when el > 30 then "  ya casi" otherwise (when el > 8 then "  sigue trabajando" otherwise ""))
                let secs be text(floor(el)) + "s"
                let label be b["label"]
                when length(label) > 60
                    set label to slice(label, 0, 59) + "…"
                let frame be frames[i % 10]
                let body be when color then esc + "[36m" + frame + esc + "[0m " + label + "  " + esc + "[2m" + bar + " " + secs + hint + esc + "[0m" otherwise frame + " " + label + "  " + bar + " " + secs + hint
                when drawn
                    print(clear_here + up + clear_here + "  " + body)
                otherwise
                    share true as "lampson:spinner:holding"
                    print(clear_here + "  " + body)
                    set drawn to true
                flush()
                set i to i + 1
            sleep(0.08)
    when drawn
        print(clear_here + up + clear_here + up)
        flush()
    share false as "lampson:spinner:holding"

task busy_on(label, kind)
    share {"label": label, "kind": kind, "since": now()} as "lampson:busy"

-- apagar y esperar a que el agente suelte la terminal (máx. 1 s) antes de volver a imprimir
task busy_off()
    share nothing as "lampson:busy"
    let waited be 0
    let holding be true
    while holding and waited < 100
        observe "lampson:spinner:holding" as hd
        set holding to hd == true
        when holding
            sleep(0.01)
            set waited to waited + 1

-- tag = "" para el agente principal; los subagentes en background NO pasan por acá (escriben su log)
task on_event(kind, data, tag)
    trace.event(sid, kind, data, tag)
    when kind == "busy"
        busy_on(data["label"], data["kind"])
    otherwise when kind == "idle"
        busy_off()
    otherwise when kind == "assistant"
        -- ● marca el turno del asistente (primera línea con contenido)
        let lines be split(md.render(data, COLOR), "\n")
        let marked be false
        let out_lines be []
        each l in lines
            when not marked and trim(l) != "" and starts_with(l, "  ")
                set out_lines to append(out_lines, c("36;1", "● ") + slice(l, 2, length(l)))
                set marked to true
            otherwise
                set out_lines to append(out_lines, l)
        print("")
        print(join(out_lines, "\n"))
        print("")
    otherwise when kind == "inbox"
        print("  " + cyan("✉ " + first_line(data, 140)))
    otherwise when kind == "tool_call"
        let desc be permission.describe_call(data["name"], data["args"])
        when is_instant(data["name"])
            set pending_call to desc
        otherwise
            set pending_call to ""
            print("  " + act("▸ " + desc))
    otherwise when kind == "tool_result"
        let out be data["output"]
        let name be data["call"]["name"]
        let bad be starts_with(out, "ERROR") or starts_with(out, "DENIED")
        let d be diff_of(name, out)
        let path be when d != nothing then text(data["call"]["args"]["path"]) otherwise ""
        set turn_outputs to append(turn_outputs, {"name": name, "args": data["call"]["args"], "output": out, "diff": d, "path": path})
        let lead be when pending_call != "" then "  " + act("▸ " + pending_call) + "  " otherwise "    "
        set pending_call to ""
        when d != nothing
            print_diff_with(lead, path, d)
        otherwise
            let mark be when bad then red("✗") otherwise green("✓")
            let s be summarize(name, out)
            -- una sola línea → cortar al ancho; multilínea (bash) se deja
            when not contains(s, "\n")
                set s to ui.cut(s, ui.cols() - ui.width(lead) - 4)
            print(lead + mark + " " + (when bad then red(s) otherwise dim(s)))
    otherwise when kind == "tool_denied"
        set data to data
    otherwise when kind == "error"
        print("  " + red("‼ " + text(data)))
        when contains(lower(text(data)), "model")
            print("  " + yellow("el proveedor rechazó el nombre del modelo (" + cfg["model"] + "): /model sin argumentos lista los válidos, /model <nombre> lo cambia"))
    otherwise when kind == "compact"
        print("  " + dim("⧗ compactando contexto (~" + text(data["before"]) + " tokens)"))
        busy_on("compactando contexto", "llm")
    flush()

-- Human in the loop con el `approve` nativo de Synsema: prompt [approve] … (y/n) en TTY; sin TTY deniega
-- (fail-closed, un agente no puede auto-aprobarse); `within` acota la espera.
task ask_user(name, args, why)
    busy_off()
    print("")
    print("  " + yellow("⚠ requiere tu aprobación · " + why))
    print("    " + permission.describe_call(name, args))
    flush()
    -- menú ↑↓/Enter (o p/d, 1/2, Esc = no) cuando hay TTY; sin TTY, el approve nativo (fail-closed)
    let pick be ed.choose("  ¿permitir?", ["permitir", "denegar"], COLOR)
    when pick == -1
        let ok be approve "  ¿permitir?" within 10m
        give ok
    give pick == 0

let LINE be "  ────────────────────────────────────────────────────────────────────────"

-- catálogo de comandos del REPL: [comando, argumentos, descripción]. Es la fuente de /help, de `/` y de las sugerencias.
let COMMANDS be [
    ["/agent", "<build|plan|review|explore>", "cambiar de agente (qué tools ve): build edita · plan solo lee y propone · review revisa y corre tests · explore busca"],
    ["/ask", "", "permisos: PREGUNTAR antes de un comando peligroso (rm -rf, git push --force, sudo…)"],
    ["/yolo", "", "permisos: PERMITIR comandos peligrosos sin preguntar (los destructivos del sistema siguen bloqueados)"],
    ["/strict", "", "permisos: DENEGAR comandos peligrosos"],
    ["/model", "[proveedor] [modelo]", "elegir proveedor y modelo con flechas (la lista de modelos la da la API); pide la key solo si falta; queda guardado"],
    ["/paste", "", "adjuntar la imagen del portapapeles al próximo mensaje (copiá una captura y escribí /paste)"],
    ["/image", "<ruta>", "adjuntar una imagen (png/jpg/gif/webp) al próximo mensaje; /image sin ruta muestra o quita las pendientes"],
    ["/delete", "<id>", "borrar una sesión guardada, con confirmación (ver /sessions)"],
    ["/config", "", "ver la configuración vigente (proveedor, modelo, límites, workspace)"],
    ["/files", "", "árbol completo del workspace"],
    ["/procs", "", "procesos que el agente dejó corriendo (servidores) y su estado"],
    ["/logs", "<nombre> [n]", "últimas n líneas del log de un proceso gestionado"],
    ["/stop", "<nombre>", "parar un proceso gestionado"],
    ["/kill", "<pid>", "matar un proceso NO gestionado (p.ej. un servidor huérfano que ves en /procs)"],
    ["/memory", "[nombre]", "notas que el agente guardó sobre ESTE proyecto (memory/<proyecto>/*.md); con nombre, la muestra"],
    ["/skills", "", "skills disponibles (instrucciones que el agente puede cargar)"],
    ["/agents", "", "subagentes lanzados con delegate: estado, pasos y log de cada uno"],
    ["/todo", "", "lista de tareas del agente en esta sesión (la mantiene con la tool todo)"],
    ["/mcp", "[add <nombre> <comando…> [--project] | remove <nombre>]", "servers MCP: listar, conectar o quitar (global: lampson/.lampson/mcp.json · proyecto: .lampson/mcp.json)"],
    ["/plugins", "[on <nombre> | off <nombre> | run <plugin> <tool> [json] | remove <nombre>]", "plugins (tools propias, en cualquier lenguaje): listar, encender o apagar (global: lampson/plugins/ · proyecto: .lampson/plugins/)"],
    ["/lsp", "[add <typescript|python|rust|go|css|html> [--project] | add <nombre> <comando…> --ext .x=lang | remove <nombre>]", "language servers (navegación semántica: symbols/definition/references/hover); arrancan en la primera consulta"],
    ["/schedule", "[add <json> | run <id> | on <id> | off <id> | remove <id> | log <id>]", "tareas programadas (cada 6h, todos los días a las 9…): plugin, comando o corrida del agente; corren mientras lampson esté abierto (o con lampson --daemon start, sin nada abierto)"],
    ["/approve", "<id> [yes|no]", "responder una aprobación pendiente de una tarea programada que corre en background (sin yes|no la pregunta con el menú ↑↓)"],
    ["/out", "[n]", "resultado completo de la última tool del turno (n = contar hacia atrás: /out 2 es la anteúltima)"],
    ["/verbose", "", "alternar: mostrar SIEMPRE el output completo de cada tool (queda guardado en config.json)"],
    ["/trace", "[n]", "traza legible de esta sesión (pasos, tools, tiempos, tokens, errores): .lampson/trace/<sesión>.log"],
    ["/tokens", "", "tamaño del contexto y tokens gastados en esta sesión"],
    ["/new", "", "empezar una sesión nueva (historial vacío)"],
    ["/sessions", "", "listar sesiones guardadas"],
    ["/resume", "<id>", "reanudar una sesión guardada"],
    ["/flags", "", "flags de arranque: lampson --web --agent --yolo --workspace …"],
    ["/update", "", "actualizar Lampson a la última versión (git pull); también: lampson --update"],
    ["!<comando>", "", "correr un comando VOS en un terminal real (prompts y REPLs funcionan; ^C corta); la salida queda en el contexto del agente"],
    ["/help", "", "esta ayuda"],
    ["/exit", "", "salir (la sesión queda guardada)"]
]

task pad(s, n)
    let out be s
    while length(out) < n
        set out to out + " "
    give out

-- entrada multilínea sin modo raw (read_key llegará a Synsema): una línea que termina en "\" continúa
-- en la siguiente; una línea que EMPIEZA con """ abre un bloque que cierra con una línea """ sola
-- (ideal para pegar código o logs). EOF corta el bloque con lo acumulado.
-- candidatos para completar el argumento de un comando (Tab / menú del editor de línea).
-- head = argumentos ya escritos antes del último token; last = lo que se está escribiendo
task complete_args(cmd, head, last)
    let first be trim(head) == ""
    when cmd == "/image"
        give workspace_paths(last)
    when cmd == "/resume" or cmd == "/delete"
        give apply((s) => s["id"], session.list())
    when cmd == "/provider" or cmd == "/model" or cmd == "/setup"
        when first
            give apply((p) => p["name"], provider.providers())
        give []
    when cmd == "/logs" or cmd == "/stop"
        when first
            give apply((p) => p["name"], proc.list())
        give []
    when cmd == "/memory"
        give apply((m) => m["name"], memo.list())
    when cmd == "/plugins"
        when first
            give ["on", "off", "run", "remove"]
        give apply((l) => l["name"], plugins.summary())
    when cmd == "/mcp"
        when first
            give ["add", "remove"]
        when starts_with(trim(head), "remove")
            give apply((m) => m["name"], mcp.summary())
        give ["--project"]
    when cmd == "/lsp"
        when first
            give ["add", "remove"]
        when starts_with(trim(head), "remove")
            give apply((s) => s["name"], lsp.summary())
        when trim(head) == "add"
            give sort_by(keys(lsp.PRESETS), (x) => x)
        give ["--project", "--ext"]
    when cmd == "/approve"
        when first
            give apply((a) => a["id"], approvals.pending())
        give ["yes", "no"]
    when cmd == "/schedule"
        when first
            give ["add", "run", "on", "off", "remove", "log"]
        when starts_with(trim(head), "add")
            give []
        give apply((s) => s["id"], schedule.summary())
    when cmd == "/agent"
        -- solo los perfiles elegibles por el usuario: `worker` es interno de delegate (agents.names lo filtra)
        give agents.names()
    give []

-- rutas del workspace que empiezan con el prefijo escrito (directorios con "/" final para seguir completando)
task workspace_paths(prefix)
    let dir be ""
    let base be prefix
    let cut be -1
    let i be length(prefix) - 1
    while i >= 0 and cut == -1
        when slice(prefix, i, i + 1) == "/" or slice(prefix, i, i + 1) == "\\"
            set cut to i
        set i to i - 1
    when cut >= 0
        set dir to slice(prefix, 0, cut + 1)
        set base to slice(prefix, cut + 1, length(prefix))
    let out be []
    try
        each e in list_dir(when dir == "" then "workspace" otherwise "workspace/" + dir)
            when starts_with(e["name"], base) and e["name"] != ".git"
                set out to append(out, dir + e["name"] + (when e["is_dir"] then "/" otherwise ""))
    recover err
        set out to []
    give sort_by(out, (x) => x)

-- mientras el humano no escribe: ¿hay avisos de subagentes en background? → cortar la lectura y
-- dejar que el bucle principal los inyecte (turno automático)
task idle()
    let pending be false
    try
        each c in agents.list_children()
            when c["status"] != "running" and not c["delivered"]
                set pending to true
    recover err
        set pending to false
    give pending

let input_history be []

task read_input(prompt)
    let first be read_line(prompt)
    when first == nothing
        give nothing
    let more be []
    when trim(first) == "\"\"\"" or starts_with(first, "\"\"\"")
        let body be slice(first, 3, length(first))
        when trim(body) != ""
            set more to append(more, body)
        let open be true
        while open
            let l be read_line(dim("  … "))
            when l == nothing or trim(l) == "\"\"\""
                set open to false
            otherwise
                set more to append(more, l)
        give join(more, "\n")
    let cur be first
    while ends_with(cur, "\\")
        set more to append(more, slice(cur, 0, length(cur) - 1))
        let l be read_line(dim("  … "))
        set cur to when l == nothing then "" otherwise l
    set more to append(more, cur)
    give join(more, "\n")

-- últimos comandos usados (config.json "recent"): "/" solo los muestra primero
task remember_command(input)
    let name be split(trim(input), " ")[0]
    when name == "/" or name == "/help"
        give nothing
    let doc be settings.load()
    let old be when contains(doc, "recent") then doc["recent"] otherwise []
    let recent be [name]
    each r in old
        when r != name and length(recent) < 3
            set recent to append(recent, r)
    set doc["recent"] to recent
    settings.save(doc)
    give nothing

task help()
    let doc be settings.load()
    let recent be when contains(doc, "recent") then doc["recent"] otherwise []
    print("")
    when length(recent) > 0
        print("  recientes   " + join(apply((r) => cyan(r), recent), "   "))
        print("")
    print("  Escribí lo que querés hacer en el proyecto. El agente lee, busca, edita y corre comandos con tools")
    print("  acotadas al workspace; cada paso queda a la vista. Los comandos empiezan con /:")
    print("  Teclas: Tab completa · ↑↓ historial/menú · Alt+Enter salto de línea · Ctrl+O último resultado completo · Esc cierra el menú")
    print("  Sin TTY (pipe): terminá la línea con \\ para continuar, o un bloque entre líneas \"\"\".")
    print("")
    each c in COMMANDS
        print("  " + pad(c[0] + " " + c[1], 38) + c[2])
    print("")

task flags()
    print("")
    print("  Flags de arranque (desde cualquier carpeta; el directorio actual es el workspace):")
    print("")
    print("  lampson                          REPL por terminal sobre el proyecto actual")
    print("  lampson --web                    interfaz web en http://127.0.0.1:8080")
    print("  lampson --workspace C:\\ruta      elegir el proyecto sin hacer cd")
    print("  lampson --agent plan             perfil inicial: build | plan | review | explore")
    print("  lampson --yolo | --strict | --ask   permisos (--dangerously-skip-permissions = --yolo)")
    print("  lampson --help                   ayuda del launcher")
    print("")
    print("  Configuración persistente (opcional): lampson\\.env → LAMPSON_PROVIDER, LAMPSON_API_KEY, LAMPSON_MODEL…")
    print("")

task show_config(cfg, ws, profile, mode, opts)
    print("")
    print("  proveedor   " + cfg["provider"] + " (" + cfg["wire"] + " → " + cfg["base_url"] + ")")
    print("  modelo      " + cfg["model"] + "   max_tokens " + text(cfg["max_tokens"]) + "   timeout " + text(floor(cfg["timeout"])) + "s")
    print("  agente      " + profile + "   tools: " + join(agents.profile(profile)["tools"], ", "))
    print("  permisos    " + mode)
    print("  límites     " + text(opts["max_steps"]) + " pasos/turno · " + text(floor(opts["budget_tokens"])) + " tokens/turno · compacta a " + text(floor(opts["compact_at_tokens"])))
    print("  workspace   " + ws)
    print("")

-- sugerencias para un comando desconocido: por prefijo
task suggest(input)
    let word be split(input, " ")[0]
    let hits be []
    each c in COMMANDS
        when starts_with(c[0], word)
            set hits to append(hits, c[0])
    when length(hits) == 0
        give "comando desconocido: " + word + " · escribí / para ver la lista"
    give "¿quisiste decir " + join(hits, " · ") + "?"

task banner(ws, cfg, profile, mode, sid)
    print("")
    print("  ██   █████  ███  ███ ██████  ███████  ██████  ███   ██")
    print("  ██  ██   ██ ████████ ██   ██ ██      ██    ██ ████  ██")
    print("  ██  ███████ ██ ██ ██ ██████  ███████ ██    ██ ██ ██ ██")
    print("  ██  ██   ██ ██    ██ ██           ██ ██    ██ ██  ████")
    print("  ██████   ██ ██    ██ ██      ███████  ██████  ██   ███")
    print("  harness de agente en Synsema")
    print(LINE)
    print("  workspace   " + ws)
    print("  agente      " + profile + "        permisos  " + mode + "        modelo  " + cfg["model"])
    print("  sesión      " + sid + "        " + git.summary())
    -- extensiones en una línea (detalle con /plugins, /mcp, /lsp): encendidas/total
    let ls be plugins.summary()
    let plugins_on be length(where(ls, (l) => l["enabled"]))
    let ms be mcp.summary()
    let mcp_on be length(where(ms, (m) => m["status"] == "ready"))
    let ss be lsp.summary()
    let ext be []
    when length(ls) > 0
        set ext to append(ext, (when plugins_on > 0 then green("plugins " + text(plugins_on) + "/" + text(length(ls))) otherwise dim("plugins 0/" + text(length(ls)))))
    when length(ms) > 0
        set ext to append(ext, (when mcp_on == length(ms) then green("mcp " + text(mcp_on) + "/" + text(length(ms))) otherwise red("mcp " + text(mcp_on) + "/" + text(length(ms)))))
    when length(ss) > 0
        set ext to append(ext, dim("lsp " + text(length(ss))))
    when length(ext) > 0
        print("  extras      " + join(ext, dim("  ·  ")) + dim("   (/plugins /mcp /lsp)"))
    let upd be update.line()
    when upd != ""
        print("  " + yellow("⬆ " + upd) + dim("  (o /update acá)"))
    print(LINE)
    print(tree.render(0, 22))
    print(LINE)
    print("  Escribí un pedido, " + cyan("/") + " para los comandos, " + cyan("!") + "comando para correr algo vos.")

task skills_list()
    let idx be skills.index()
    let out be []
    each n in sort_by(keys(idx), (x) => x)
        set out to append(out, "  " + n + " (" + idx[n]["source"] + "): " + idx[n]["description"])
    when length(out) == 0
        give "  (sin skills)"
    give join(out, "\n")

-- ---------- onboarding ----------
-- Primera vez (ningún proveedor con key) o /setup: elegir proveedor, modelo y pegar la key. Va a
-- lampson/.lampson/config.json (local, gitignored) y vale para terminal y web. Sin TTY no pregunta.
-- ---------- /model · /provider · /setup: UN solo flujo ----------
-- Proveedor → modelo (lista viva de la API del proveedor) → key solo si falta. Todo con menús ↑↓ cuando hay
-- TTY; sin TTY, listas numeradas + read_line. Siempre se GUARDA en lampson/.lampson/config.json (igual que
-- la web): ya no hay "solo esta sesión". Con args (`/model glm glm-5.3-flash`) aplica directo lo que vino y
-- pregunta solo lo que falte. cur_name/cur_model = lo activo, para marcarlo y ponerlo primero.
let MENU_MAX be 18

-- menú o lista numerada según haya TTY. Devuelve el índice elegido, o nothing si el usuario canceló.
task pick_from(question, labels)
    flush()
    let pick be ed.choose("  " + question, labels, COLOR)
    when pick == nothing
        give nothing
    when pick != -1
        give pick
    print("  " + question + " (número)")
    each e in enumerate(labels)
        print("  " + pad(text(e["index"] + 1) + ".", 4) + e["item"])
    let choice be read_line("  > ")
    when choice == nothing or trim(choice) == ""
        give nothing
    let c be trim(choice)
    when matches(c, "^[0-9]+$")
        let i be floor(number(c)) - 1
        when i >= 0 and i < length(labels)
            give i
        give nothing
    -- también vale escribir el nombre (primera palabra de la etiqueta)
    each e in enumerate(labels)
        when lower(split(trim(e["item"]), " ")[0]) == lower(c)
            give e["index"]
    give nothing

task ask_provider(cur_name)
    let list be provider.providers()
    -- el actual primero, después el resto en orden
    let ordered be where(list, (p) => p["name"] == cur_name) + where(list, (p) => p["name"] != cur_name)
    let labels be []
    each p in ordered
        let flag be when p["name"] == "ollama" then "local, sin key" otherwise (when p["has_key"] then "● key" otherwise "")
        set labels to append(labels, pad(p["name"], 12) + pad(p["model"], 26) + pad(flag, 16) + (when p["name"] == cur_name then "◀ actual" otherwise ""))
    let i be pick_from(cyan("Proveedor:"), labels)
    when i == nothing
        give ""
    give ordered[i]["name"]

-- modelos del proveedor según su API; si son muchos, un filtro antes del menú; siempre "otro…" para tipear
task ask_model(name, cur_name, cur_model)
    let pcfg be provider.config_for(name, "")
    let default be when name == cur_name and cur_model != "" then cur_model otherwise pcfg["model"]
    let lm be provider.list_models(pcfg)
    when lm["error"] != nothing
        print("  " + dim("no pude listar los modelos de " + name + " (" + lm["error"] + ")"))
        let typed be read_line("  modelo [" + default + "]: ")
        give when typed == nothing or trim(typed) == "" then default otherwise trim(typed)
    let ids be lm["models"]
    when length(ids) > MENU_MAX
        print("  " + dim(text(length(ids)) + " modelos en " + name + " · escribí parte del nombre para filtrar (Enter = los primeros " + text(MENU_MAX) + ")"))
        let f be read_line("  filtro: ")
        let ff be when f == nothing then "" otherwise lower(trim(f))
        when ff != ""
            set ids to where(ids, (m) => contains(lower(m), ff))
        when length(ids) == 0
            print("  " + dim("ningún modelo contiene «" + ff + "»"))
            set ids to lm["models"]
        when length(ids) > MENU_MAX
            set ids to slice(ids, 0, MENU_MAX)
    -- el default primero (si la API lo lista), después el resto; al final la opción de escribir
    let ordered be where(ids, (m) => m == default) + where(ids, (m) => m != default)
    let labels be apply((m) => m + (when m == default then "   ◀ actual" otherwise ""), ordered)
    set labels to append(labels, "otro… (escribir)")
    let i be pick_from(cyan("Modelo de " + name + ":") + dim("  (según su API)"), labels)
    when i == nothing
        give ""
    when i == length(labels) - 1
        let typed be read_line("  modelo [" + default + "]: ")
        give when typed == nothing or trim(typed) == "" then default otherwise trim(typed)
    give ordered[i]

-- pide la key si el proveedor no tiene una guardada. Devuelve false si el usuario canceló.
task ensure_key(name)
    when name == "ollama" or provider.has_key(name)
        give true
    print("  " + dim("la key se guarda en lampson/.lampson/config.json (solo en esta máquina)"))
    let key be read_line("  API key de " + name + ": ")
    when key == nothing
        give false
    when trim(key) == ""
        print("  " + yellow("sin key: podés agregarla después con /model"))
        give true
    settings.set_key(name, trim(key))
    give true

-- pre_name / pre_model: lo que vino por args ("" = preguntar). Devuelve true si guardó algo.
task setup_wizard(pre_name, pre_model, cur_name, cur_model)
    print("")
    let name be lower(trim(pre_name))
    when name == ""
        set name to ask_provider(cur_name)
        when name == ""
            print("  (sin cambios)")
            give false
    when not contains(provider.PRESETS, name)
        print("  " + red("no conozco el proveedor " + name) + " · disponibles: " + join(sort_by(keys(provider.PRESETS), (x) => x), ", "))
        give false
    -- la key va antes que el modelo: sin key la API no lista los modelos
    when not ensure_key(name)
        print("  (sin cambios)")
        give false
    let model be trim(pre_model)
    when model == ""
        set model to ask_model(name, cur_name, cur_model)
        when model == ""
            print("  (sin cambios)")
            give false
    -- un "modelo" que empieza con / es un comando tipeado por error (o un stdin que se acabó): no se guarda
    when starts_with(model, "/")
        print("  (sin cambios)")
        give false
    set model to provider.normalize_model(name, model)
    settings.set_default(name, model)
    print("  " + green("✓ " + name + " · " + model + " · guardado") + dim("   (/model para cambiarlo; /model <proveedor> [modelo] va directo)"))
    give true

-- `/model x y` · `/provider x y` · `/setup`: args → (proveedor, modelo). Un solo arg que no es proveedor =
-- modelo del proveedor actual.
task setup_from_args(rest, cur_name, cur_model)
    let args be where(split(trim(rest), " "), (x) => x != "")
    when length(args) == 0
        give setup_wizard("", "", cur_name, cur_model)
    when length(args) == 1 and not contains(provider.PRESETS, lower(args[0]))
        give setup_wizard(cur_name, args[0], cur_name, cur_model)
    give setup_wizard(args[0], when length(args) > 1 then args[1] otherwise "", cur_name, cur_model)

-- ---------- imágenes en el REPL ----------
-- Una terminal no puede pegar una imagen, así que se lee del portapapeles (/paste) o de un archivo
-- (/image ruta) con un script del sistema que devuelve "media_type|w|h|base64". Quedan pendientes
-- hasta el próximo mensaje al agente (mismo formato canónico que la web: m["images"]).
let pending_images be []

task grab_image(mode, path)
    let r be nothing
    when env("OS", "") == "Windows_NT"
        set r to run("powershell", ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "lib/tools/img.ps1", mode, path], 60)
    otherwise
        set r to run("bash", ["lib/tools/img.sh", mode, path], 60)
    let line be trim(replace_text(r["stdout"], "\r", ""))
    when line == "" or starts_with(line, "ERROR|")
        give {"error": when line == "" then trim(r["stderr"]) otherwise slice(line, 6, length(line))}
    let parts be split(line, "|")
    when length(parts) < 4
        give {"error": "salida inesperada del lector de imágenes"}
    give {"media_type": parts[0], "w": floor(number(parts[1])), "h": floor(number(parts[2])), "data": parts[3]}

task attach_image(mode, path)
    when length(pending_images) >= 4
        print("  " + yellow("máximo 4 imágenes por mensaje (/image para quitarlas)"))
        give false
    let im be grab_image(mode, path)
    when contains(im, "error")
        print("  " + red("✗ " + im["error"]))
        give false
    set pending_images to append(pending_images, im)
    let vis be provider.supports_vision(cfg)
    print("  " + green("📎 imagen " + text(length(pending_images)) + " adjunta") + dim(" · " + text(im["w"]) + "x" + text(im["h"]) + " · " + text(floor(length(im["data"]) * 3 / 4 / 1024)) + " KB · se manda con tu próximo mensaje"))
    when not vis
        print("  " + yellow("ojo: " + cfg["provider"] + " · " + cfg["model"] + " no acepta imágenes; el modelo recibirá solo una nota. Cambiá con /provider a uno con visión (anthropic, gpt-4o…)"))
    give true

-- ---------- boot ----------

let cfg be provider.config()
when not provider.configured() and cfg["provider"] != "ollama"
    print("")
    print("  Bienvenido a Lampson. Todavía no hay ninguna API key configurada.")
    when setup_wizard("", "", cfg["provider"], cfg["model"])
        set cfg to provider.config()
let env_info be agents.env_info(cfg)
let profile be lower(env("LAMPSON_AGENT", "build"))
-- `--agent worker` (o cualquier nombre desconocido): worker es interno de delegate, no un perfil de sesión
when not contains(agents.names(), profile)
    print("agente '" + profile + "' no disponible · disponibles: " + join(agents.names(), ", ") + " · uso build")
    set profile to "build"
task system_for(p)
    give {"role": "system", "content": prompt.build(env_info, agents.addendum_for(p))}
task opts_for(p, mode)
    let o be loop.default_opts(agents.registry_for(p), agents.catalog_for(p), ask_user)
    set o to loop.with_steps(o, agents.steps_for(p))
    set o to loop.with_inbox(o, agents.parent_inbox, "")
    give loop.with_mode(o, mode)

-- Subagente en background: `agent Child` (lib/agents.syn) corre en un hilo con intérprete propio y solo
-- puede llamar tasks TOP-LEVEL de este programa — esta es su única puerta de entrada al harness.
task lampson_subagent(spec_json)
    give agents.run_child_json(spec_json)

-- Tareas programadas TAMBIÉN en la terminal: `cron_every` no corre mientras el hilo principal está en el teclado,
-- pero un `agent` sí (hilo real, como el Spinner). Cada 30 s llama al tick (heartbeat + corridas vencidas); una
-- corrida `prompt` transcurre al lado del chat sin tocar su sesión (blackboard lampson:sched:session) y si pide
-- permiso lo dice por consola: /approve <id> yes|no (o link/webhook si están configurados).
task lampson_sched_tick()
    give sched_run.tick()

agent Sched
    require net
    require time
    require exec
    require random
    require env("LAMPSON_*")
    require env("OS")
    require secret("LAMPSON_*")
    require file("workspace")
    require file("workspace/*")
    require file.read("skills")
    require file.read("skills/*")
    require file.read("plugins")
    require file.read("plugins/*")
    require file("memory")
    require file("memory/*")
    require file(".lampson")
    require file(".lampson/*")
    let alive be true
    let waited be 25
    while alive
        observe "lampson:spinner:stop" as st
        when st == true
            set alive to false
        otherwise when waited >= 30
            set waited to 0
            try
                -- bajo el hub el proceso del workspace (LAMPSON_PORT) ya hace tick: no duplicar corridas
                let port be env("LAMPSON_PORT", "")
                let other be false
                when port != ""
                    try
                        let hr be http_get("http://127.0.0.1:" + port + "/w/" + env("LAMPSON_WS", "x") + "/api/health", {"timeout": 2})
                        set other to hr["ok"]
                    recover e2
                        set other to false
                when not other
                    lampson_sched_tick()
            recover err
                print("[lampson] scheduler: " + text(err))
        otherwise
            sleep(1)
            set waited to waited + 1

-- !comando del usuario en un pseudo-terminal: la salida se ve EN VIVO y, si el proceso se queda esperando
-- (prompt y/N, contraseña, REPL, `npm init`…), lo que escribas se le manda como teclas + Enter.
-- Enter vacío = seguir esperando · ^C = cortar. Devuelve la salida (sin ANSI) para el contexto del agente.
task shell_argv(cmd)
    when env("OS", "") == "Windows_NT"
        give ["powershell", ["-NoLogo", "-NoProfile", "-Command", cmd]]
    give ["bash", ["-lc", cmd]]

task run_interactive(cmd)
    let sh be shell_argv(cmd)
    let p be proc_spawn(sh[0], sh[1], {"cwd": env("LAMPSON_WORKSPACE", "workspace"), "pty": true, "cols": 120, "rows": 40})
    let captured be []
    let partial be ""
    let alive be true
    while alive
        let ev be proc_recv(p, 5)
        when ev == nothing
            when proc_status(p) != "running"
                set alive to false
            otherwise
                -- silencio: si quedó una línea a medias es casi seguro un prompt; dejar escribir
                let hint be when trim(partial) == "" then "(sin salida hace 5 s · Enter: seguir esperando · texto: mandárselo · ^C: cortar) " otherwise partial + " "
                let line be read_line(dim(hint))
                set partial to ""
                when line == nothing or trim(line) == "^C"
                    proc_kill(p)
                    set captured to append(captured, "[cortado por el usuario]")
                otherwise when trim(line) != ""
                    proc_send(p, line + "\r")
        otherwise when ev["type"] == "exit"
            when partial != ""
                print("    " + partial)
                set captured to append(captured, partial)
            set captured to append(captured, "[exit " + text(ev["data"]["exit_code"]) + "]")
            set alive to false
        otherwise
            let raw be ev["data"]
            when is_bytes(raw)
                set raw to decode(raw, "utf8_lossy")
            let chunk be strip_ansi(raw)
            let lines be split(partial + chunk, "\n")
            let n be length(lines)
            each e in enumerate(lines)
                when e["index"] < n - 1
                    print("    " + e["item"])
                    set captured to append(captured, e["item"])
            set partial to lines[n - 1]
            flush()
    proc_close(p)
    give join(captured, "\n")

let system_msg be system_for(profile)
-- servers MCP (globales en .lampson/mcp.json, del proyecto en workspace/.lampson/mcp.json): arrancan antes
-- de armar el catálogo de tools; hasta 8 s de espera a que estén listos
let mcp_servers be mcp.start_all(8)
-- mcp / lsp / plugins van resumidos en el banner ("extras"); acá solo se avisa lo que está ROTO
each ms in mcp.summary()
    when ms["status"] != "ready"
        print("  " + red("○ mcp " + ms["name"] + " " + ms["status"]) + dim(when ms["error"] != nothing then " · " + text(ms["error"]) otherwise ""))
each l in plugins.summary()
    when l["error"] != nothing
        print("  " + red("○ plugin " + l["name"] + " roto") + dim(" · " + text(l["error"])))
let opts be opts_for(profile, lower(env("LAMPSON_PERMISSION", "ask")))

-- marca de corrida (blackboard): session.save la estampa en meta.run; reanudar una sesión guardada por
-- OTRA corrida dispara la nota de procesos muertos (proc.resume_note) para que el modelo no los crea vivos
share {"id": text(now())} as "lampson:run"
share {"kind": "terminal"} as "lampson:ui"

let sid be env("LAMPSON_SESSION", "")
let messages be [system_msg]
when sid != ""
    when session.exists(sid)
        let doc be session.load(sid)
        set messages to doc["messages"]
        print("reanudando sesión " + sid + " (" + text(length(messages)) + " mensajes)")
        when session.from_other_run(doc)
            let note be proc.resume_note(sid)
            when note != ""
                set messages to append(messages, {"role": "user", "content": note})
                print("  " + cyan("✉ " + first_line(note, 140)))
    otherwise
        print("sesión " + sid + " no existe; creando una nueva")
        set sid to ""
when sid == ""
    set sid to session.new_id()
-- sesión actual (blackboard): la tool todo guarda su lista por sesión y no recibe contexto (lib/tools/todo.syn)
share {"id": sid} as "lampson:session"

banner(env_info["cwd"], cfg, profile, opts["permission_mode"], sid)
share nothing as "lampson:busy"
share false as "lampson:spinner:stop"
spawn Spinner with esc = ESC, color = COLOR
spawn Sched
flush()

let total_usage be {"input": 0, "output": 0}
let mode be opts["permission_mode"]
let running be true
-- turnos automáticos por avisos de subagentes en background (padre idle): tope 3 seguidos, se
-- reinicia con input humano real (anti bucle auto-excitado, deepseek-harness)
let followups be 0
while running
    let inbox be when followups < 3 then agents.parent_inbox(0, "") otherwise nothing
    let line be nothing
    when inbox != nothing
        set followups to followups + 1
        each m in inbox["messages"]
            print("")
            print("  " + cyan("✉ " + first_line(m, 140)))
            set messages to append(messages, {"role": "user", "content": m})
        trace.user(sid, "(turno automático por aviso de subagente)", profile, mode, cfg["model"])
        set opts to opts_for(profile, mode)
        let result be loop.run_turn(cfg, messages, opts, on_event)
        trace.turn_end(sid, result)
        set messages to result["messages"]
        set total_usage to {"input": total_usage["input"] + result["usage"]["input"], "output": total_usage["output"] + result["usage"]["output"]}
        print(dim("  ─── " + text(result["steps"]) + " pasos · " + fmt_tokens(result["usage"]["input"] + result["usage"]["output"]) + " tokens · turno automático por subagente"))
        session.save(sid, messages, {"title": session.title_of(messages)})
        flush()
    otherwise
        let saved be settings.load()
        let ctx be {"commands": COMMANDS, "recent": (when contains(saved, "recent") then saved["recent"] otherwise []), "history": input_history, "complete": complete_args, "idle": idle, "fallback": read_input}
        set line to ed.read((when length(pending_images) > 0 then dim("📎" + text(length(pending_images)) + " ") otherwise "") + cyan("❯ "), COLOR, ctx)
        when line != nothing and line != ed.INTERRUPT and trim(line) != ""
            set input_history to append(input_history, line)
    when inbox != nothing
        set running to running
    otherwise when line == ed.INTERRUPT
        set running to running
    otherwise when line == nothing
        set running to false
    otherwise
        set followups to 0
        when not starts_with(trim(line), "/")
            set turn_outputs to []
        let input be trim(line)
        when starts_with(input, "/") and length(input) > 1
            remember_command(input)
        when input == ""
            set running to running
        otherwise when input == "/exit" or input == "/quit"
            set running to false
        otherwise when input == "/help" or input == "/"
            help()
        otherwise when input == "/flags"
            flags()
        otherwise when input == "/update"
            let u be update.check()
            when not u["available"]
                print("  ya estás en la última versión (" + u["current"] + ")")
            otherwise
                each n in u["notes"]
                    print("  " + dim("· " + n))
                print("  " + update.apply())
        otherwise when input == "/config"
            show_config(cfg, env_info["cwd"], profile, mode, opts)
        otherwise when input == "/verbose"
            set VERBOSE to not VERBOSE
            let doc be settings.load()
            set doc["verbose"] to VERBOSE
            settings.save(doc)
            print("  " + (when VERBOSE then green("verbose ON") + dim(" · cada tool muestra su output completo") otherwise dim("verbose OFF · outputs colapsados a " + text(OUT_LINES) + " líneas; /out para ver uno completo")))
        otherwise when starts_with(input, "/out")
            let n be trim(slice(input, 4, length(input)))
            let back be when n == "" then 1 otherwise floor(number(n))
            when length(turn_outputs) == 0
                print(dim("  ninguna tool corrió en este turno"))
            otherwise when back < 1 or back > length(turn_outputs)
                print(dim("  hay " + text(length(turn_outputs)) + " resultados en este turno: /out 1 … /out " + text(length(turn_outputs))))
            otherwise
                let o be turn_outputs[length(turn_outputs) - back]
                print("  " + act("▸ " + permission.describe_call(o["name"], o["args"])))
                print_full(o)
        otherwise when starts_with(input, "/trace")
            let n be trim(slice(input, 6, length(input)))
            let lines be when n == "" then 40 otherwise floor(number(n))
            print(dim("  " + trace.file_of(sid)))
            print(trace.tail(sid, lines))
        otherwise when starts_with(input, "/model") or starts_with(input, "/provider") or starts_with(input, "/setup")
            -- un solo flujo (ver setup_wizard): proveedor → modelo (lista de la API) → key si falta; se guarda en config.json
            let rest be trim(replace_re(input, "^/(model|provider|setup)", ""))
            when setup_from_args(rest, cfg["provider"], cfg["model"])
                set cfg to provider.config()
        otherwise when input == "/paste"
            attach_image("clip", "")
        otherwise when starts_with(input, "/image")
            let p be trim(slice(input, 6, length(input)))
            when p == ""
                when length(pending_images) == 0
                    print("  sin imágenes pendientes · uso: /image <ruta>  o  /paste")
                otherwise
                    print("  " + text(length(pending_images)) + " imagen(es) pendiente(s) — se mandan con tu próximo mensaje.")
                    flush()
                    let ipick be ed.choose("  ¿qué hago con ellas?", ["dejarlas", "quitarlas"], COLOR)
                    when ipick == -1
                        print("  ¿Quitarlas? (s/N)")
                        let a be read_line("  ")
                        when a != nothing and lower(trim(a)) == "s"
                            set pending_images to []
                            print("  quitadas")
                    otherwise when ipick == 1
                        set pending_images to []
                        print("  quitadas")
            otherwise
                attach_image("file", p)
        otherwise when starts_with(input, "/delete")
            let id be trim(slice(input, 7, length(input)))
            when id == ""
                print("  uso: /delete <id>   (ver /sessions)")
            otherwise when id == sid
                print("  esa es la sesión actual; hacé /new primero")
            otherwise
                flush()
                let dpick be ed.choose("  ¿borrar la sesión " + id + "?", ["cancelar", "borrar"], COLOR)
                when dpick == 1 or dpick == -1   -- sin TTY el comando ya es explícito: borra
                    print("  " + session.delete(id))
                otherwise
                    print("  (no se borró)")
        otherwise when input == "/new"
            set sid to session.new_id()
            set messages to [system_msg]
            share {"id": sid} as "lampson:session"
            print("nueva sesión " + sid)
        otherwise when input == "/sessions"
            each s in session.list()
                print("  " + s["id"] + "  " + s["title"])
        otherwise when starts_with(input, "/resume ")
            let id be trim(slice(input, 8, length(input)))
            when session.exists(id)
                set sid to id
                let rdoc be session.load(id)
                set messages to rdoc["messages"]
                share {"id": sid} as "lampson:session"
                print("reanudada " + id + " (" + text(length(messages)) + " mensajes)")
                when session.from_other_run(rdoc)
                    let note be proc.resume_note(sid)
                    when note != ""
                        set messages to append(messages, {"role": "user", "content": note})
                        print("  " + cyan("✉ " + first_line(note, 140)))
            otherwise
                print("no existe " + id)
        otherwise when input == "/files"
            print(tree.render(2, 200))
        otherwise when input == "/procs"
            let items be proc.list()
            when length(items) == 0
                print("  (ningún proceso gestionado)")
            each p in items
                print("  " + (when p["running"] then green("● running") otherwise red("○ exited ")) + "  " + p["name"] + "  $ " + p["command"])
            let ports be proc.listeners()
            when length(ports) > 0
                print("")
                print("  " + dim("puertos en escucha en esta máquina (de cualquier programa, no solo de lampson; /kill <pid> para matar uno):"))
                each l in ports
                    print("  " + yellow(":" + text(l["port"])) + "  pid " + text(l["pid"]) + "  " + l["name"] + "  " + dim(first_line(l["command"], 110)))
        otherwise when starts_with(input, "/logs")
            let args be split(trim(slice(input, 5, length(input))), " ")
            when args[0] == ""
                print("  uso: /logs <nombre> [líneas]")
            otherwise
                let n be when length(args) > 1 then number(args[1]) otherwise 60
                print(proc.logs(args[0], n))
        otherwise when starts_with(input, "/kill")
            let pid be trim(slice(input, 5, length(input)))
            print("  " + (when pid == "" then "uso: /kill <pid>  (ver /procs)" otherwise proc.kill_pid(number(pid))))
        otherwise when starts_with(input, "/stop")
            let nm be trim(slice(input, 5, length(input)))
            print("  " + (when nm == "" then "uso: /stop <nombre>" otherwise proc.halt(nm)))
        otherwise when starts_with(input, "/memory")
            let nm be trim(slice(input, 7, length(input)))
            when nm == ""
                let items be memo.list()
                print("  " + dim("memory/" + memo.slug() + "/"))
                when length(items) == 0
                    print("  (sin notas todavía — el agente las crea con la tool memory)")
                each it in items
                    print("  " + yellow(it["name"]) + "  " + it["title"])
            otherwise
                print(memo.note_read(nm))
        otherwise when input == "/todo"
            let items be todo.load(sid)
            print(when length(items) == 0 then "  sin tareas (el agente las crea con la tool todo)" otherwise "  " + replace_text(todo.format(items), "\n", "\n  "))
        otherwise when input == "/lsp" or starts_with(input, "/lsp ")
            let srest be trim(slice(input, 4, length(input)))
            when starts_with(srest, "add ")
                -- /lsp add typescript [--project]   ·   /lsp add mylang cmd args… --ext .x=lang [--ext .y=lang2]
                let sscope be when contains(srest, "--project") then "project" otherwise "global"
                let sline be trim(replace_text(srest, "--project", ""))
                let stoks be where(split(slice(sline, 4, length(sline)), " "), (x) => x != "")
                when length(stoks) == 0
                    print("  uso: /lsp add <" + join(keys(lsp.PRESETS), "|") + "> [--project]   ·   /lsp add <nombre> <comando…> --ext .ext=languageId")
                otherwise
                    let langs be {}
                    let cmdtoks be []
                    let ti be 1
                    while ti < length(stoks)
                        when stoks[ti] == "--ext" and ti + 1 < length(stoks)
                            let kv be split(stoks[ti + 1], "=")
                            when length(kv) == 2
                                set langs[kv[0]] to kv[1]
                            set ti to ti + 2
                        otherwise
                            set cmdtoks to append(cmdtoks, stoks[ti])
                            set ti to ti + 1
                    try
                        print("  " + lsp.add_server(stoks[0], when length(cmdtoks) == 0 then nothing otherwise join(cmdtoks, " "), when length(keys(langs)) == 0 then nothing otherwise langs, sscope))
                    recover err
                        print("  " + red(text(err)))
            otherwise when starts_with(srest, "remove ")
                try
                    print("  " + lsp.remove_server(trim(slice(srest, 7, length(srest)))))
                recover err
                    print("  " + red(text(err)))
            otherwise
                let ss be lsp.summary()
                when length(ss) == 0
                    print("  sin language servers configurados. Agregá uno: " + cyan("/lsp add typescript") + dim("  (presets: " + join(keys(lsp.PRESETS), ", ") + ")"))
                    print("  " + dim("el agente los usa con la tool lsp: symbols (estructura de un archivo sin leerlo), definition, references, hover"))
                each s in ss
                    print("  " + (when s["status"] == "ready" then green("● ") otherwise (when s["status"] == "error" or s["status"] == "exited" then red("○ ") otherwise dim("○ "))) + pad(s["name"], 12) + dim(pad(s["scope"], 8) + pad(s["status"], 8) + join(s["extensions"], " ") + "  $ " + s["command"]) + (when s["error"] != nothing then red("  " + text(s["error"])) otherwise ""))
                print("  " + dim("idle = arranca en la primera consulta del agente"))
        otherwise when input == "/schedule" or starts_with(input, "/schedule ")
            -- tareas programadas (lib/schedule.syn). Crear: JSON, o pedírselo al agente ("todos los días a las 9 corré…").
            -- Las corre el daemon (web.syn con `lampson --daemon start`); `/schedule run` las corre acá mismo, con
            -- el menú de aprobación de la terminal si la tarea es `ask`.
            let srest be trim(slice(input, 9, length(input)))
            let stoks be where(split(srest, " "), (x) => x != "")
            let sact be when length(stoks) > 0 then stoks[0] otherwise ""
            let sid_arg be when length(stoks) > 1 then stoks[1] otherwise ""
            when sact == "add"
                let sjson be trim(slice(srest, 3, length(srest)))
                when sjson == ""
                    print("  uso: /schedule add {\"name\": \"…\", \"when\": \"daily 09:00\", \"action\": {\"type\": \"bash\", \"command\": \"npm test\"}, \"permission\": \"ask\"}")
                    print("  " + dim("when: every 6h · daily 09:00 · mon,wed 08:30 · weekdays 09:00   action.type: plugin {plugin, tool, args} · bash {command} · prompt {prompt, agent}"))
                    print("  " + dim("o pedíselo al agente en lenguaje natural: «todos los días a las 9 revisá los tests y avisame»"))
                otherwise
                    try
                        let st be schedule.add(json_decode(sjson))
                        print("  " + green("⏰ programada «" + st["name"] + "» (" + st["id"] + "): " + schedule.describe_plan(st["plan"]) + " · próxima " + schedule.fmt_local(st["next_run"])))
                    recover err
                        print("  " + red(text(err)))
            otherwise when sact == "run" and sid_arg != ""
                let st be schedule.get(sid_arg)
                when st == nothing
                    print("  " + red("no existe la tarea " + sid_arg))
                otherwise
                    print("  " + yellow("⏰ corriendo «" + st["name"] + "» · " + schedule.describe_action(st["action"])))
                    flush()
                    let sr be sched_run.run(st, ask_user, on_event)
                    print("  " + (when sr["last_status"] == "ok" then green("✓ ") otherwise red("✗ ")) + sr["last_status"] + " · " + first_line(sr["last_summary"], 160))
                    print("  " + dim("log: " + schedule.LOG_DIR + "/" + st["id"] + ".log"))
            otherwise when (sact == "on" or sact == "off") and sid_arg != ""
                try
                    print("  " + schedule.set_enabled(sid_arg, sact == "on"))
                recover err
                    print("  " + red(text(err)))
            otherwise when sact == "remove" and sid_arg != ""
                try
                    print("  " + schedule.remove(sid_arg))
                recover err
                    print("  " + red(text(err)))
            otherwise when sact == "log" and sid_arg != ""
                let tl be schedule.log_tail(sid_arg, 60)
                print(when tl == "" then "  sin corridas todavía" otherwise tl)
            otherwise
                let ss be schedule.summary()
                let age be schedule.daemon_age()
                when length(ss) == 0
                    print("  sin tareas programadas. Pedísela al agente («cada 6 horas corré los tests y avisame») o: " + cyan("/schedule add <json>"))
                each s in ss
                    print("  " + (when s["running"] then yellow("● ") otherwise (when s["enabled"] then green("● ") otherwise dim("○ "))) + pad(s["id"], 22) + dim(pad(s["plan"], 30)) + s["action_text"])
                    print("      " + dim("permisos " + s["permission"] + " · próxima " + s["next_local"] + (when s["last_run"] != nothing then " · última " + s["last_status"] + ": " + first_line(s["last_summary"], 80) otherwise "")))
                let pend be approvals.pending()
                each ap in pend
                    print("  " + yellow("⚠ aprobación pendiente " + ap["id"] + ": " + first_line(ap["message"], 100)) + dim("  → /approve " + ap["id"]))
                print("  " + dim("corren solas mientras lampson esté abierto (tick cada " + text(schedule.TICK_SECONDS) + " s) · con todo cerrado: lampson --daemon start · run/on/off/remove/log <id>"))
        otherwise when starts_with(input, "/approve ")
            let atoks be where(split(trim(slice(input, 9, length(input))), " "), (x) => x != "")
            let yes be false
            let answered be false
            when length(atoks) == 1
                -- «/approve <id>» a secas: menú ↑↓ (sin TTY, el uso de siempre)
                flush()
                let apick be ed.choose("  aprobación " + atoks[0], ["permitir", "denegar"], COLOR)
                when apick == -1
                    print("  uso: /approve <id> yes|no   (pendientes: /schedule)")
                otherwise when apick == nothing
                    print("  (sin responder)")
                otherwise
                    set yes to apick == 0
                    set answered to true
            otherwise when length(atoks) < 2 or not contains(["yes", "no", "si", "sí", "y", "n"], lower(atoks[1]))
                print("  uso: /approve <id> yes|no   (pendientes: /schedule)")
            otherwise
                set yes to contains(["yes", "si", "sí", "y"], lower(atoks[1]))
                set answered to true
            when answered
                when approvals.answer(atoks[0], yes)
                    print("  " + (when yes then green("✓ permitido ") otherwise red("✗ denegado ")) + atoks[0])
                otherwise
                    print("  " + red("no hay una aprobación pendiente con id " + atoks[0]))
        otherwise when input == "/plugins" or starts_with(input, "/plugins ") or input == "/lamps" or starts_with(input, "/lamps ")
            -- /lamps = el nombre viejo (hasta 2026-09): sigue andando, con aviso
            let is_old be starts_with(input, "/lamps")
            when is_old
                print("  " + dim("/lamps ahora es /plugins (las lámparas de lampson pasaron a llamarse plugins)"))
            let lrest be trim(slice(input, when is_old then 6 otherwise 8, length(input)))
            when starts_with(lrest, "run ")
                -- /plugins run <plugin> <tool> [json de args]  → la corre el usuario, sin el modelo
                let rt be where(split(trim(slice(lrest, 4, length(lrest))), " "), (x) => x != "")
                when length(rt) < 2
                    print("  uso: /plugins run <plugin> <tool> [{\"arg\": \"valor\"}]")
                otherwise
                    let rargs be {}
                    when length(rt) > 2
                        try
                            set rargs to json_decode(join(slice(rt, 2, length(rt)), " "))
                        recover err
                            print("  " + red("args: JSON inválido"))
                    try
                        print(plugins.call(plugins.tool_name(rt[0], rt[1]), rargs))
                    recover err
                        print("  " + red(text(err)))
            otherwise when starts_with(lrest, "remove ")
                try
                    print("  " + plugins.remove(trim(slice(lrest, 7, length(lrest)))))
                recover err
                    print("  " + red(text(err)))
                set opts to opts_for(profile, mode)
            otherwise when starts_with(lrest, "on ") or starts_with(lrest, "off ")
                let lon be starts_with(lrest, "on ")
                try
                    print("  " + plugins.set_enabled(trim(slice(lrest, when lon then 3 otherwise 4, length(lrest))), lon))
                recover err
                    print("  " + red(text(err)))
                set opts to opts_for(profile, mode)
            otherwise
                let ls be plugins.summary()
                when length(ls) == 0
                    print("  sin plugins. Un plugin es una carpeta con plugin.json: " + dim("lampson\\plugins\\<nombre>\\ (global) · .lampson\\plugins\\<nombre>\\ del repo (proyecto)"))
                    print("  " + dim("el agente también puede crearlos (write en .lampson/plugins/) y pedirte encenderlos"))
                each l in ls
                    print("  " + (when l["enabled"] then green("● ") otherwise dim("○ ")) + pad(l["name"], 14) + dim(pad(l["scope"], 8) + pad(l["kind"], 5)) + (when l["error"] != nothing then red("roto: " + text(l["error"])) otherwise dim(text(length(l["tools"])) + " tools [" + join(l["tools"], ", ") + "]" + (when l["kind"] == "syn" then "  techo: " + l["caps"] otherwise "  $ " + l["command"]))) + (when l["legacy"] then yellow("  carpeta vieja .lampson/lamps/ → renombrala a .lampson/plugins/") otherwise ""))
                print("  " + dim("encender/apagar: /plugins on <nombre> · /plugins off <nombre> · correr uno vos: /plugins run <plugin> <tool> [json]"))
                print("  " + dim("¿herramientas con techo real, versionadas y para cualquier agente? eso son las lámparas de lamps.sh: lamp add <ref> y entran por /mcp add lamps lamp mcp"))
        otherwise when input == "/mcp" or starts_with(input, "/mcp ")
            let mrest be trim(slice(input, 4, length(input)))
            when starts_with(mrest, "add ")
                -- /mcp add <nombre> <comando…> [--project]  (env/keys: editá el mcp.json a mano, no van por terminal)
                let mscope be when contains(mrest, "--project") then "project" otherwise "global"
                let mline be trim(replace_text(mrest, "--project", ""))
                let mtoks be where(split(slice(mline, 4, length(mline)), " "), (x) => x != "")
                when length(mtoks) < 2
                    print("  uso: /mcp add <nombre> <comando…> [--project]   p.ej.: /mcp add github npx -y @modelcontextprotocol/server-github")
                otherwise
                    try
                        print("  " + mcp.add_server(mtoks[0], join(slice(mtoks, 1, length(mtoks)), " "), {}, mscope))
                    recover err
                        print("  " + red(text(err)))
                    set opts to opts_for(profile, mode)
            otherwise when starts_with(mrest, "remove ")
                try
                    print("  " + mcp.remove_server(trim(slice(mrest, 7, length(mrest)))))
                recover err
                    print("  " + red(text(err)))
                set opts to opts_for(profile, mode)
            otherwise
                let sm be mcp.summary()
                when length(sm) == 0
                    print("  sin servers MCP conectados (no hay ninguno configurado).")
                    print("  conectá uno: " + cyan("/mcp add <nombre> <comando…> [--project]") + dim("   · o editá lampson\\.lampson\\mcp.json (global) / .lampson\\mcp.json del repo (proyecto)"))
                    print("  " + dim("el agente también puede: pedile \"conectá el MCP de github\" y te va a pedir aprobación"))
                each ms in sm
                    print("  " + (when ms["status"] == "ready" then green("● ") otherwise red("○ ")) + pad(ms["name"], 14) + dim(pad(ms["scope"], 8) + ms["status"] + "  $ " + ms["command"]) + (when ms["error"] != nothing then red("  " + text(ms["error"])) otherwise ""))
                    when length(ms["tools"]) > 0
                        print("      " + dim(join(ms["tools"], ", ")))
                -- servers que se pusieron listos después del arranque: recomponer el catálogo
                set opts to opts_for(profile, mode)
        otherwise when input == "/agents"
            agents.prune(10, 1800)
            let kids be agents.list_children()
            when length(kids) == 0
                print("  sin subagentes todavía (el agente los lanza con la tool delegate)")
            each c in kids
                print("  " + (when c["status"] == "running" then green("● running") otherwise dim("○ " + c["status"] + "  ")) + "  " + c["id"] + "  " + text(c["steps"]) + " pasos  " + dim(first_line(c["brief"], 80)) + dim("  log: " + agents.DIR + "/" + c["id"] + ".log"))
        otherwise when input == "/skills"
            print(skills_list())
            print(dim("  instalar una de skills.sh: pedile al agente «instalá la skill X de owner/repo» (global, pide aprobación) · o !npx skills add owner/repo --skill X -g"))
        otherwise when input == "/tokens"
            print("contexto≈" + text(loop.estimate_tokens(messages)) + " tokens · gastado in=" + text(total_usage["input"]) + " out=" + text(total_usage["output"]))
        otherwise when input == "/yolo" or input == "/ask" or input == "/strict"
            set mode to slice(input, 1, length(input))
            set opts to opts_for(profile, mode)
            print("permisos=" + opts["permission_mode"])
        otherwise when starts_with(input, "/agent")
            let want be trim(slice(input, 6, length(input)))
            when want == ""
                print("agente=" + profile + " · disponibles: " + join(agents.names(), ", "))
            otherwise when contains(agents.names(), want)
                set profile to want
                set system_msg to system_for(profile)
                set opts to opts_for(profile, mode)
                -- el system prompt cambia con el perfil; el historial se conserva (cambiar de agente no borra la conversación)
                set messages to [system_msg] + slice(messages, 1, length(messages))
                print("agente=" + profile + " · tools: " + join(agents.profile(profile)["tools"], ", "))
            otherwise
                print("no existe el agente " + want + " · disponibles: " + join(agents.names(), ", "))
        otherwise when starts_with(input, "/")
            print("  " + suggest(input))
        otherwise when starts_with(input, "!")
            -- comando del USUARIO: corre sin política de permisos (lo escribiste vos), salida al contexto
            let cmd be trim(slice(input, 1, length(input)))
            when cmd == ""
                print("  uso: !<comando>   p.ej. !git status · !npm test · !cat .env")
            otherwise
                print("  " + act("$ " + cmd))
                flush()
                let out be run_interactive(cmd)
                set messages to append(messages, {"role": "user", "content": "[The user ran this command in the shell themselves]\n$ " + cmd + "\n" + tools.truncate(out, 6000)})
                session.save(sid, messages, {"title": session.title_of(messages)})
        otherwise
            when length(pending_images) > 0
                set messages to append(messages, {"role": "user", "content": input, "images": pending_images})
                set pending_images to []
            otherwise
                set messages to append(messages, {"role": "user", "content": input})
            trace.user(sid, input, profile, mode, cfg["model"])
            -- catálogo fresco por turno: si el turno anterior conectó/quitó un server MCP, sus tools
            -- entran/salen acá (con los mismos servers el catálogo es idéntico → el prompt cache no se corta)
            set opts to opts_for(profile, mode)
            let t0 be now()
            let result be loop.run_turn(cfg, messages, opts, on_event)
            trace.turn_end(sid, result)
            set messages to result["messages"]
            set total_usage to {"input": total_usage["input"] + result["usage"]["input"], "output": total_usage["output"] + result["usage"]["output"]}
            let summary be text(result["steps"]) + (when result["steps"] == 1 then " paso" otherwise " pasos") + " · " + fmt_tokens(result["usage"]["input"] + result["usage"]["output"]) + " tokens · " + ui.fmt_duration(now() - t0)
            when result["stopped"] == "max_steps"
                set summary to summary + " · " + red("límite de " + text(opts["max_steps"]) + " pasos por turno")
                print(dim("  ─── " + summary))
                print("  " + yellow("El agente paró por el límite de pasos, no porque terminó. Escribí «seguí» para que continúe donde quedó, o subí LAMPSON_MAX_STEPS."))
            otherwise when result["stopped"] != "done"
                -- el detalle del error ya salió en la línea ‼; acá solo la causa corta
                let why be result["stopped"]
                when starts_with(why, "error: network")
                    set why to "error de red (ver ‼ arriba)"
                otherwise when starts_with(why, "error:")
                    set why to first_line(why, 60)
                set summary to summary + " · " + red("detenido: " + why)
                print(dim("  ─── " + summary))
            otherwise
                print(dim("  ─── " + summary))
            session.save(sid, messages, {"title": session.title_of(messages)})
    flush()
-- los procesos gestionados (servidores) y los subagentes en background mueren con lampson
share true as "lampson:spinner:stop"
agents.stop_all()
mcp.stop_all()
lsp.stop_all()
proc.halt_all()
print("bye · sesión " + sid)
