-- tests/unit.test.syn — tests unitarios (sin red, sin LLM)
--   synsema test unit.test.syn
-- MIGA: vive en la raíz porque un módulo no puede importar fuera de su directorio ("../" está prohibido).
-- Los tests e2e (loop + providers + web) usan tests/mock_llm.syn; ver README.

require time
require exec
require file("workspace")
require file("workspace/*")
require file.read("skills")
require file.read("skills/*")
require file.read("plugins")
require file.read("plugins/*")
require file("memory")
require file("memory/*")
require file(".lampson")
require file(".lampson/*")
require env("LAMPSON_*")
require env("OS")
require secret("LAMPSON_*")

use "./lib/permission.syn" as permission
use "./lib/session.syn" as session
use "./lib/provider.syn" as provider
use "./lib/tools.syn" as tools
use "./lib/loop.syn" as loop
use "./lib/agents.syn" as agents
use "./lib/skills.syn" as skills
use "./lib/tools/proc.syn" as proc
use "./lib/tools/memo.syn" as memo
use "./lib/trace.syn" as trace
use "./lib/md.syn" as md
use "./lib/diff.syn" as diff
use "./lib/ui.syn" as ui
use "./lib/mcp.syn" as mcp
use "./lib/plugins.syn" as plugins
use "./lib/tools/todo.syn" as todo
use "./lib/prompt.syn" as prompt
use "./lib/fs.syn" as fs

let REG be tools.registry()

-- Guardia: los tests de tools escriben y borran dentro de workspace/, así que SOLO corren sobre un
-- workspace descartable (tests/run.ps1 y tests/run.sh lo montan y dejan el marcador). Nunca sobre el
-- proyecto real de un usuario que quedó montado por el último `lampson`.
try
    read_file("workspace/.lampson-test-workspace")
recover err
    raise("unit.test.syn needs a throwaway workspace: run tests/run.ps1 (or tests/run.sh) instead of `synsema test` directly — workspace/ currently points to a real project")

-- ---------- permission ----------

test "hardline: rm -rf / se deniega en todos los modos"
    each mode in ["ask", "yolo", "strict"]
        let v be permission.evaluate("bash", {"command": "rm -rf /"}, mode)
        assert_eq(v["decision"], "deny", mode)

test "hardline no da falso positivo con rm -rf /tmp/x (es dangerous)"
    assert_eq(permission.evaluate("bash", {"command": "rm -rf /tmp/x"}, "ask")["decision"], "ask")
    assert_eq(permission.evaluate("bash", {"command": "rm -rf /tmp/x"}, "yolo")["decision"], "allow")
    assert_eq(permission.evaluate("bash", {"command": "rm -rf /tmp/x"}, "strict")["decision"], "deny")

test "comandos normales se permiten; lecturas siempre"
    assert_eq(permission.evaluate("bash", {"command": "git status && ls -la"}, "strict")["decision"], "allow")
    assert_eq(permission.evaluate("read", {"path": "x"}, "strict")["decision"], "allow")
    assert_eq(permission.evaluate("grep", {"pattern": "rm -rf /"}, "ask")["decision"], "allow")

test "escribir .env pide aprobación; .env.example no"
    assert_eq(permission.evaluate("write", {"path": ".env", "content": "x"}, "ask")["decision"], "ask")
    assert_eq(permission.evaluate("write", {"path": "app/.env.local", "content": "x"}, "ask")["decision"], "ask")
    assert_eq(permission.evaluate("write", {"path": "futbol5/.env.example", "content": "x"}, "ask")["decision"], "allow")
    assert_eq(permission.evaluate("write", {"path": "src/env.ts", "content": "x"}, "ask")["decision"], "allow")
    assert_eq(permission.evaluate("write", {"path": "src/a.syn", "content": "x"}, "ask")["decision"], "allow")

test "escribir .env por bash (redirect) pide aprobación; describe_call en una línea"
    assert_eq(permission.evaluate("bash", {"command": "echo X=1 > .env && npx prisma db push"}, "ask")["decision"], "ask")
    assert_eq(permission.evaluate("bash", {"command": "cat .env.example"}, "ask")["decision"], "allow")
    assert_eq(permission.describe_call("bash", {"command": "echo a" + "\n" + "echo b"}), "$ echo a ⏎ echo b")
    -- la traza se lee como shell, sin JSON crudo
    assert_eq(permission.describe_call("memory", {"action": "list"}), "memory list")
    assert_eq(permission.describe_call("memory", {"action": "read", "name": "gotchas"}), "memory read gotchas")
    assert_eq(permission.describe_call("grep", {"pattern": "TODO", "path": "src", "regex": true}), "grep -E \"TODO\"  src")
    assert_eq(permission.describe_call("find", {"pattern": "*.ts"}), "find *.ts")
    assert_eq(permission.describe_call("read", {"path": "a.md", "offset": 10, "limit": 40}), "read a.md  (desde 10 40 líneas)")
    assert_eq(permission.describe_call("ls", {}), "ls .")
    assert_eq(permission.describe_call("todo", {"items": [{"content": "a", "status": "done"}, {"content": "b", "status": "pending"}]}), "todo  1/2 hechas")

test "skill install: human in the loop siempre (ask incluso en yolo, deny en strict); load/list nunca preguntan"
    let ins be {"name": "frontend-design", "action": "install", "source": "anthropics/skills", "scope": "global"}
    assert_eq(permission.evaluate("skill", ins, "ask")["decision"], "ask")
    assert_eq(permission.evaluate("skill", ins, "yolo")["decision"], "ask")
    assert_eq(permission.evaluate("skill", ins, "strict")["decision"], "deny")
    assert_eq(permission.evaluate("skill", {"name": "lampson"}, "strict")["decision"], "allow")
    assert_eq(permission.evaluate("skill", {"name": "", "action": "list"}, "strict")["decision"], "allow")
    assert_eq(permission.describe_call("skill", ins), "skill install anthropics/skills --skill frontend-design (global)")
    assert(contains(call_tool(REG["skill"], {"name": "", "action": "list"}), "lampson (harness)"))
    assert_error(() => call_tool(REG["skill"], {"name": "x", "action": "install", "source": "not a repo!"}))

test "tools MCP: ask por defecto, yolo permite, strict deniega; describe_call legible"
    assert_eq(permission.evaluate("mcp_github_create_issue", {"title": "x"}, "ask")["decision"], "ask")
    assert_eq(permission.evaluate("mcp_github_create_issue", {"title": "x"}, "yolo")["decision"], "allow")
    assert_eq(permission.evaluate("mcp_github_create_issue", {"title": "x"}, "strict")["decision"], "deny")
    assert_eq(permission.describe_call("mcp_github_create_issue", {"title": "x"}), "mcp_github_create_issue {\"title\": \"x\"}")
    assert_eq(length(mcp.servers()), 0)

test "tool mcp (admin): add/remove piden humano siempre (ask incluso en yolo, deny en strict); list nunca"
    let madd be {"action": "add", "name": "github", "command": "npx -y @modelcontextprotocol/server-github", "scope": "global"}
    assert_eq(permission.evaluate("mcp", madd, "ask")["decision"], "ask")
    assert_eq(permission.evaluate("mcp", madd, "yolo")["decision"], "ask")
    assert_eq(permission.evaluate("mcp", madd, "strict")["decision"], "deny")
    assert_eq(permission.evaluate("mcp", {"action": "remove", "name": "github"}, "yolo")["decision"], "ask")
    assert_eq(permission.evaluate("mcp", {"action": "list"}, "strict")["decision"], "allow")
    assert_eq(permission.evaluate("mcp", {}, "strict")["decision"], "allow")
    assert(contains(permission.describe_call("mcp", madd), "mcp add github") and contains(permission.describe_call("mcp", madd), "npx -y"), permission.describe_call("mcp", madd))
    assert(contains(call_tool(REG["mcp"], {"action": "list"}), "no MCP servers connected"))

test "mcp.parse_command: tokens simples y comillas (rutas de Windows con espacios)"
    let p1 be mcp.parse_command("npx -y @modelcontextprotocol/server-github")
    assert_eq(p1["command"], "npx")
    assert_eq(join(p1["args"], "|"), "-y|@modelcontextprotocol/server-github")
    let p2 be mcp.parse_command("\"C:\\Program Files\\node\\node.exe\" server.js --port 3001")
    assert_eq(p2["command"], "C:\\Program Files\\node\\node.exe")
    assert_eq(join(p2["args"], "|"), "server.js|--port|3001")
    assert_eq(mcp.parse_command("   ")["command"], "")

test "spill: bash largo va a disco; el informe de delegate NO (es el entregable)"
    let long be ""
    while length(long) < 20000
        set long to long + "linea de informe bastante larga para pasar el tope\n"
    assert(contains(loop.spill("bash", "spill_t1", long), "chars omitted"))
    assert_eq(loop.spill("delegate", "spill_t2", long), long)
    assert_eq(loop.spill("read", "spill_t3", long), long)

test "describe_call"
    assert_eq(permission.describe_call("bash", {"command": "ls"}), "$ ls")
    assert_eq(permission.describe_call("read", {"path": "a.txt"}), "read a.txt")

-- ---------- provider ----------

test "config: preset deepseek por defecto y override por env"
    let cfg be provider.config()
    assert(contains(provider.PRESETS, cfg["provider"]) or cfg["provider"] != "", "provider name")
    assert(cfg["wire"] == "openai" or cfg["wire"] == "anthropic")
    assert(cfg["max_tokens"] > 0)

test "normalize_model: minúsculas donde la API es case-sensitive (deepseek), MiniMax intacto"
    assert_eq(provider.normalize_model("deepseek", " DeepSeek-V4-Pro "), "deepseek-v4-pro")
    assert_eq(provider.normalize_model("openai", "GPT-4o"), "gpt-4o")
    assert_eq(provider.normalize_model("minimax", "MiniMax-M3"), "MiniMax-M3")
    assert_eq(provider.normalize_model("glm", "GLM-5.3-Flash"), "glm-5.3-flash")
    assert_eq(provider.PRESETS["deepseek"]["model"], "deepseek-v4-flash")
    assert(provider.supports_vision({"provider": "deepseek", "model": "deepseek-v4-flash-vision-exp"}))
    assert(not provider.supports_vision({"provider": "deepseek", "model": "deepseek-v4-flash"}))

test "prompt: método en 5 pasos, límites duros y entorno interpolado"
    let p be prompt.build({"ui": "terminal", "cwd": "C:/x", "os": "Windows_NT", "shell": "bash", "date": "2026-08-28", "model": "m", "provider": "p"}, agents.addendum_for("build"))
    assert(contains(p, "# Method") and contains(p, "1. PLAN.") and contains(p, "5. VERIFY AND REPORT."), "método")
    assert(contains(p, "after 24 read/ls/find/grep are refused") and contains(p, "[exit code: N]") and contains(p, "mcp_<server>_<tool>"), "límites y tools")
    assert(contains(p, "Workspace root") and contains(p, "C:/x") and contains(p, "m via p") and contains(p, "# Mode"), "entorno")
    -- el núcleo pesa ~7k chars (≈1.7k tokens); el resto es el índice de skills (22 globales en esta máquina) + memoria
    assert(length(p) < 40000, "tamaño: " + text(length(p)))

test "usage: tokens de caché al 10% en el costo (DeepSeek y OpenAI)"
    assert_eq(provider.cached_of({"prompt_tokens": 1000, "prompt_cache_hit_tokens": 800}), 800)
    assert_eq(provider.cached_of({"prompt_tokens": 1000, "prompt_tokens_details": {"cached_tokens": 600}}), 600)
    assert_eq(provider.cached_of({"prompt_tokens": 1000}), 0)
    assert_eq(provider.cost_tokens({"input": 1000, "output": 100, "cached": 800}), 380)
    assert_eq(provider.cost_tokens({"input": 1000, "output": 100}), 1100)

test "trace: una línea por evento, con tiempos, y tail"
    let sid be "test-trace"
    trace.user(sid, "hola" + "\n" + "mundo", "build", "ask", "m1")
    trace.event(sid, "usage", {"step": 1, "usage": {"input": 10, "output": 5}, "total": {"input": 10, "output": 5}}, "")
    trace.event(sid, "tool_call", {"name": "read", "args": {"path": "a.txt"}}, "")
    trace.event(sid, "tool_result", {"call": {"name": "read"}, "output": "ERROR: no such file"}, "")
    trace.event(sid, "tool_denied", {"call": {"name": "bash"}, "reason": "user declined"}, "")
    trace.event(sid, "inbox", "[harness] Sub-agent x finished", "")
    trace.turn_end(sid, {"steps": 2, "usage": {"input": 10, "output": 5}, "stopped": "done"})
    let t be trace.tail(sid, 10)
    assert(contains(t, "USER  [build · ask · m1] hola ⏎ mundo"), t)
    assert(contains(t, "STEP 1  modelo respondió · in=10 out=5"), t)
    assert(contains(t, "CALL  read {\"path\": \"a.txt\"}"), t)
    assert(contains(t, "FAIL  read → ERROR: no such file"), t)
    assert(contains(t, "DENY  bash · user declined") and contains(t, "MAIL  [harness]") and contains(t, "END   2 pasos · 15 tokens · done"), t)
    assert_eq(length(split(trace.tail(sid, 3), "\n")), 3)
    run("C:\\Program Files\\Git\\bin\\bash.exe", ["-c", "rm -f .lampson/trace/test-trace.*"], 10)

test "presets: cada uno tiene wire, base_url y model"
    each name in keys(provider.PRESETS)
        let p be provider.PRESETS[name]
        assert(contains(p, "wire") and contains(p, "base_url") and contains(p, "model"), name)
        assert(not ends_with_slash(p["base_url"]), name + " base_url sin barra final")

task ends_with_slash(s)
    give slice(s, length(s) - 1, length(s)) == "/"

-- ---------- tools ----------

-- Los tests de tools escriben en workspace/_lampson_test/ (el workspace montado) y lo limpian.
let T be "_lampson_test"

test "edit exige old_string único y write/read funcionan (vía call_tool = least-privilege)"
    call_tool(REG["write"], {"path": T + "/s.txt", "content": "aaa\nbbb\naaa\n"})
    call_tool(REG["read"], {"path": T + "/s.txt"})
    assert_error(() => call_tool(REG["edit"], {"path": T + "/s.txt", "old_string": "aaa", "new_string": "ccc"}))
    assert_eq(call_tool(REG["edit"], {"path": T + "/s.txt", "old_string": "aaa", "new_string": "ccc", "replace_all": true}), "edited " + T + "/s.txt: 2 replacement(s)")
    assert_eq(call_tool(REG["edit"], {"path": "./" + T + "/s.txt", "old_string": "bbb", "new_string": "ddd"}), "edited " + T + "/s.txt: 1 replacement(s)")
    assert_eq(call_tool(REG["read"], {"path": T + "/s.txt"}), "ccc\nddd\nccc\n")
    assert_error(() => call_tool(REG["edit"], {"path": T + "/s.txt", "old_string": "zzz", "new_string": "y"}))

test "observación: edit/write sobre un archivo existente exigen read previo y detectan cambios en disco"
    call_tool(REG["write"], {"path": T + "/o.txt", "content": "uno\n"})
    -- write lo creó y lo marcó observado; una tool externa (bash) lo cambia → hash distinto
    call_tool(REG["bash"], {"command": "echo dos > " + T + "/o.txt"})
    let e1 be ""
    try
        call_tool(REG["edit"], {"path": T + "/o.txt", "old_string": "dos", "new_string": "tres"})
    recover err
        set e1 to text(err)
    assert(contains(e1, "changed on disk since you read it"), e1)
    call_tool(REG["write"], {"path": T + "/p.txt", "content": "x\n"})
    call_tool(REG["bash"], {"command": "echo y > " + T + "/p.txt"})
    let e2 be ""
    try
        call_tool(REG["write"], {"path": T + "/p.txt", "content": "z"})
    recover err
        set e2 to text(err)
    assert(contains(e2, "write") and contains(e2, "read"), e2)
    call_tool(REG["read"], {"path": T + "/o.txt"})
    assert_eq(call_tool(REG["edit"], {"path": T + "/o.txt", "old_string": "dos", "new_string": "tres"}), "edited " + T + "/o.txt: 1 replacement(s)")
    -- un archivo NUNCA leído en esta sesión
    call_tool(REG["bash"], {"command": "echo n > " + T + "/never.txt"})
    let e3 be ""
    try
        call_tool(REG["edit"], {"path": T + "/never.txt", "old_string": "n", "new_string": "m"})
    recover err
        set e3 to text(err)
    assert(contains(e3, "requires reading"), e3)

test "todo: reemplazo total, un solo in_progress, texto activo para la compaction"
    let out be call_tool(REG["todo"], {"items": [{"content": "a", "status": "completed"}, {"content": "b", "status": "in_progress"}, {"content": "c"}]})
    assert(contains(out, "1. [x] a") and contains(out, "2. [>] b  ← in progress") and contains(out, "3. [ ] c"), out)
    assert_error(() => call_tool(REG["todo"], {"items": [{"content": "a", "status": "in_progress"}, {"content": "b", "status": "in_progress"}]}))
    assert_error(() => call_tool(REG["todo"], {"items": [{"content": "", "status": "pending"}]}))
    let act be todo.active_text()
    assert(contains(act, "preserved across context compression") and contains(act, "b") and contains(act, "c") and not contains(act, "[x] a"), act)
    assert(contains(call_tool(REG["todo"], {}), "[>] b"))
    assert_eq(call_tool(REG["todo"], {"items": []}), "(empty task list)")
    assert_eq(todo.active_text(), "")

test "loop: JSON canónico, spill cabeza+cola, recibos y poda de resultados viejos"
    assert_eq(loop.canon({"b": [1, {"y": 2, "x": 1}], "a": "s"}), "{\"a\":\"s\",\"b\":[1,{\"x\":1,\"y\":2}]}")
    let big be repeat_text("línea de relleno 0123456789\n", 600)
    let sp be loop.spill("bash", "call-7", big)
    assert(length(sp) < length(big) and contains(sp, "chars omitted. Full result saved to .lampson/spill/call-7.txt"), text(length(sp)))
    assert(starts_with(sp, "línea de relleno") and ends_with_text(sp, "0123456789\n"), "cabeza y cola")
    assert_eq(loop.spill("read", "c", big), big)
    let r1 be loop.receipt({"name": "bash", "content": "salida\nmás\n[exit code 3]"})
    assert(contains(r1, "[bash result pruned: exit code 3 · 3 lines/"), r1)
    let r2 be loop.receipt({"name": "edit", "content": "ERROR: old_string not found in x.ts — read the file"})
    assert(starts_with(r2, "[edit result pruned: ERROR: old_string not found"), r2)
    assert_eq(loop.receipt({"name": "x", "content": r1}), r1)
    let old be {"role": "tool", "tool_call_id": "1", "name": "read", "content": big}
    let recent be {"role": "tool", "tool_call_id": "2", "name": "bash", "content": repeat_text("x", 170000)}
    let pruned be loop.prune_results([{"role": "user", "content": "u"}, {"role": "assistant", "content": "", "tool_calls": []}, old, {"role": "assistant", "content": "", "tool_calls": []}, recent])
    assert(contains(pruned[2]["content"], "[read result pruned: ok") and pruned[4]["content"] == recent["content"], pruned[2]["content"])
    let small be loop.prune_results([{"role": "user", "content": "u"}, old])
    assert_eq(small[1]["content"], big)

test "prune: histéresis 2× — bajo el umbral NO reescribe nada (el historial queda byte-estable → prompt cache)"
    -- ~20k tokens de resultados: sobre PROTECT_TOKENS (16k) pero bajo 2× → el prefijo no se toca
    let mid be repeat_text("y", 80000)
    let msgs be [{"role": "user", "content": "u"}, {"role": "assistant", "content": "", "tool_calls": []}, {"role": "tool", "tool_call_id": "1", "name": "read", "content": mid}]
    let out be loop.prune_results(msgs)
    assert_eq(out[2]["content"], mid)
    -- y una vez podado, repodar sin resultados nuevos es un no-op (los recibos son chicos)
    let big2 be repeat_text("z", 170000)
    let two be loop.prune_results(msgs + [{"role": "assistant", "content": "", "tool_calls": []}, {"role": "tool", "tool_call_id": "2", "name": "bash", "content": big2}])
    assert(contains(two[2]["content"], "result pruned"), two[2]["content"])
    let again be loop.prune_results(two)
    assert_eq(again[2]["content"], two[2]["content"])

test "session.from_other_run + proc.resume_note: sesión de otra corrida avisa el estado real de procesos"
    share {"id": "run-A"} as "lampson:run"
    assert_eq(session.from_other_run({"meta": {"run": "run-A"}, "messages": []}), false)
    assert_eq(session.from_other_run({"meta": {"run": "run-B"}, "messages": []}), true)
    assert_eq(session.from_other_run({"meta": {}, "messages": []}), true)
    let note be proc.resume_note()
    when note != ""
        assert(starts_with(note, "[harness]") and contains(note, "do NOT survive a restart"), note)

test "tope de exploración: aviso a la mitad, rechazo al tope, reset con una acción"
    let cap be 16
    let v be loop.explore_verdict(0, "read", cap)
    assert_eq(v["streak"], 1)
    assert(v["note"] == "" and not v["refuse"])
    let v8 be loop.explore_verdict(7, "ls", cap)
    assert(contains(v8["note"], "8 read-only calls in a row") and not v8["refuse"], v8["note"])
    let v16 be loop.explore_verdict(15, "grep", cap)
    assert(v16["refuse"] and v16["streak"] == 16)
    let act be loop.explore_verdict(16, "edit", cap)
    assert(act["streak"] == 0 and not act["refuse"])
    let other be loop.explore_verdict(5, "todo", cap)
    assert(other["streak"] == 5 and not other["refuse"])
    assert(loop.explore_verdict(20, "mcp_github_search", cap)["streak"] == 0)
    assert_eq(loop.explore_cap(), 24)

task repeat_text(s, n)
    let out be ""
    let i be 0
    while i < n
        set out to out + s
        set i to i + 1
    give out

task ends_with_text(s, suffix)
    give slice(s, length(s) - length(suffix), length(s)) == suffix

test "find con glob mínimo, ls y grep (paths relativos al workspace)"
    call_tool(REG["write"], {"path": T + "/deep/a.syn", "content": "export task run_turn()\n    give 1\n"})
    let found be call_tool(REG["find"], {"pattern": "*.syn", "path": T})
    assert(contains(found, T + "/deep/a.syn"), found)
    assert(not contains(found, "workspace/"), found)
    assert(contains(call_tool(REG["ls"], {"path": T}), "deep/"))
    assert_eq(call_tool(REG["find"], {"pattern": "nope_*_nope", "path": T}), "no files matched nope_*_nope")
    let r be call_tool(REG["grep"], {"pattern": "export task run_turn", "path": T, "glob": "*.syn", "regex": false})
    assert(contains(r, T + "/deep/a.syn:1:"), r)

test "bash corre con cwd = workspace"
    let out be call_tool(REG["bash"], {"command": "ls " + T})
    assert(contains(out, "deep"), out)

test "una tool NO puede salir del workspace (least-privilege real): abs, .., hermano"
    assert_error(() => call_tool(REG["read"], {"path": "C:/Windows/win.ini"}))
    assert_error(() => call_tool(REG["read"], {"path": "../lib/loop.syn"}))
    assert_error(() => call_tool(REG["find"], {"pattern": "*", "path": ".."}))
    assert_error(() => call_tool(REG["write"], {"path": "../pwned.txt", "content": "x"}))

test "escape del workspace: mensaje instructivo (no 'Capability not granted' ni 'os error 123')"
    -- abs de Windows, abs con backslash y ..: el modelo debe recibir la regla + qué hacer, no un críptico
    each bad in ["C:/Users/x/nota.md", "C:\\Users\\x\\nota.md", "../memoria-global.md", "a/../../fuera.txt"]
        let msg be ""
        try
            call_tool(REG["write"], {"path": bad, "content": "x"})
        recover err
            set msg to text(err)
        assert(contains(msg, "path escapes the workspace"), bad + " → " + msg)
        assert(contains(msg, "memory tool"), msg)
        assert(not contains(msg, "Capability not granted"), msg)
    -- "foo..bar" NO es un escape (.. solo cuenta como segmento) y "/x" se re-rootea como siempre
    call_tool(REG["write"], {"path": T + "/foo..bar.txt", "content": "ok"})
    assert(contains(call_tool(REG["read"], {"path": T + "/foo..bar.txt"}), "ok"))

test "perfiles: plan no ve write/edit/bash; subagentes no ven delegate"
    let plan be agents.registry_for("plan")
    assert(contains(plan, "read") and contains(plan, "delegate"))
    assert(not contains(plan, "write") and not contains(plan, "bash"))
    let review be agents.registry_for("review")
    assert(contains(review, "bash") and not contains(review, "edit") and not contains(review, "delegate"))
    assert(contains(agents.registry_for("worker"), "edit") and not contains(agents.registry_for("worker"), "delegate"))
    assert(contains(agents.PROFILES, "worker") and length(agents.names()) == 4 and length(keys(agents.PROFILES)) == 5)
    assert_eq(length(agents.catalog_for("build")), length(tools.CATALOG) + 1)

test "skills: índice, sección de prompt, carga por tool y prioridad workspace > harness"
    let idx be skills.index()
    assert(contains(idx, "lampson") and contains(idx, "synsema"), text(keys(idx)))
    assert(idx["lampson"]["source"] == "harness" or idx["lampson"]["source"] == "project")
    assert(contains(skills.prompt_section(idx), "- synsema (harness):"))
    let body be call_tool(REG["skill"], {"name": "lampson"})
    assert(starts_with(body, "# skill: lampson"), body)
    assert(contains(body, "workspace/"))
    assert_error(() => call_tool(REG["skill"], {"name": "nope"}))
    -- una skill del proyecto con el mismo nombre gana a la del harness
    call_tool(REG["write"], {"path": "skills/lampson/SKILL.md", "content": "---\nname: lampson\ndescription: override\n---\ncustom body"})
    let idx2 be skills.index()
    assert_eq(idx2["lampson"]["source"], "project")
    assert(contains(call_tool(REG["skill"], {"name": "lampson"}), "custom body"))
    -- limpiar: no dejar la skill de prueba en el workspace del usuario
    run("C:\Program Files\Git\bin\bash.exe", ["-c", "rm -rf workspace/skills/lampson; rmdir workspace/skills 2>/dev/null; true"], 10)
    assert(not contains(skills.index()["lampson"], "nope"))

-- Los tests de procesos gestionados (proc.start/halt/report) viven en tests/proc_test.syn y corren con
-- `synsema run`: bajo `synsema test` el swarm no está cableado (spawn no arranca agentes, agents() no existe).

test "bash rechaza servidores/watchers y manda al process tool"
    let out be call_tool(REG["bash"], {"command": "cd app && npm run dev 2>&1 | head -50"})
    assert(contains(out, "REFUSED") and contains(out, "process tool"), out)
    assert(contains(call_tool(REG["bash"], {"command": "npx vite"}), "REFUSED"))
    assert(contains(call_tool(REG["bash"], {"command": "python -m http.server 8000"}), "REFUSED"))
    assert(not contains(call_tool(REG["bash"], {"command": "echo npm run build"}), "REFUSED"))
    assert(not contains(call_tool(REG["bash"], {"command": "timeout 5 npm run dev; true"}), "REFUSED"))

test "memoria por proyecto: slug estable, write/append/read/list, índice en el prompt"
    let sl be memo.slug()
    assert(matches(sl, "[a-z0-9-]+-[0-9a-f]{8}"), sl)
    assert_eq(memo.slug(), sl)
    call_tool(REG["memory"], {"action": "write", "name": "t-note", "content": "# Cómo correr\nnpm test"})
    assert(contains(call_tool(REG["memory"], {"action": "append", "name": "t-note", "content": "extra"}), "appended"))
    let body be call_tool(REG["memory"], {"action": "read", "name": "t-note"})
    assert(contains(body, "npm test") and contains(body, "extra"), body)
    assert(contains(call_tool(REG["memory"], {"action": "list"}), "t-note: Cómo correr"))
    assert(contains(memo.prompt_section(), "- t-note: Cómo correr"))
    assert_error(() => call_tool(REG["memory"], {"action": "read", "name": "nope"}))
    assert_error(() => call_tool(REG["memory"], {"action": "write", "name": "../x", "content": "y"}))
    call_tool(REG["memory"], {"action": "delete", "name": "t-note"})
    assert_eq(call_tool(REG["memory"], {"action": "read", "name": "t-note"}), "")

test "delegate rechaza build y agentes desconocidos"
    let reg be agents.registry_for("build")
    assert_error(() => call_tool(reg["delegate"], {"agent": "build", "brief": "x"}))
    assert_error(() => call_tool(reg["delegate"], {"agent": "nope", "brief": "x"}))

test "truncate"
    assert_eq(tools.truncate("abc", 10), "abc")
    assert(starts_with(tools.truncate("abcdefghij", 3), "abc\n\n[... truncated: 7 more chars"))

test "catálogo y registry coinciden"
    let reg be tools.registry()
    each t in tools.CATALOG
        assert(contains(reg, t["name"]), "tool en catálogo sin task: " + t["name"])
        assert(contains(t, "description") and contains(t["parameters"], "properties"), t["name"])
    assert_eq(length(keys(reg)), length(tools.CATALOG))

-- ---------- session ----------

test "session: save/load/list/title round-trip"
    let id be "test-" + session.new_id()
    let msgs be [{"role": "system", "content": "s"}, {"role": "user", "content": "hola\nmundo"}, {"role": "assistant", "content": "ok", "tool_calls": []}]
    session.save(id, msgs, {"title": session.title_of(msgs)})
    assert(session.exists(id))
    let d be session.load(id)
    assert_eq(d["messages"], msgs)
    assert_eq(d["meta"]["title"], "hola mundo")
    let ids be apply((s) => s["id"], session.list())
    assert(contains(ids, id))
    assert_eq(session.exists("no-such-session"), false)

