test "estimate_tokens y with_mode"
    assert(loop.estimate_tokens([{"role": "user", "content": "hola"}]) > 0)
    let opts be loop.default_opts({}, [], nothing)
    assert_eq(loop.with_mode(opts, "yolo")["permission_mode"], "yolo")
    assert_eq(opts["max_steps"], 40)

-- ---------- plugins ----------

test "plugins: descubrir, encender (humano), catálogo plugin_<plugin>_<tool>, correr bajo techo, apagar"
    let ldir be "workspace/.lampson/plugins/hello"
    write_file(ldir + "/plugin.json", json_encode({"name": "hello", "description": "saluda", "kind": "syn", "entry": "plugin.syn", "timeout": 20, "tools": [{"name": "greet", "description": "greets", "parameters": {"type": "object", "properties": {"who": {"type": "string"}}}, "readonly": true}]}))
    write_file(ldir + "/plugin.syn", "require env(\"PLUGIN_*\")\nlet a be json_decode(env(\"PLUGIN_ARGS\", \"{}\"))\nprint(\"hello \" + text(a[\"who\"]) + \" via \" + env(\"PLUGIN_TOOL\", \"\"))\n")
    -- apagada por defecto: existe pero no entra al catálogo
    let found be where(plugins.summary(), (l) => l["name"] == "hello")
    assert_eq(length(found), 1)
    assert(not found[0]["enabled"])
    assert(not contains(plugins.names(false), "plugin_hello_greet"))
    -- encender = permiso humano SIEMPRE para el agente (ask en yolo, deny en strict); list nunca
    assert_eq(permission.evaluate("plugin", {"action": "enable", "name": "hello"}, "yolo")["decision"], "ask")
    assert_eq(permission.evaluate("plugin", {"action": "enable", "name": "hello"}, "strict")["decision"], "deny")
    assert_eq(permission.evaluate("plugin", {"action": "list"}, "strict")["decision"], "allow")
    assert(contains(plugins.set_enabled("hello", true), "ON"))
    assert(contains(plugins.names(false), "plugin_hello_greet"))
    assert(contains(plugins.names(true), "plugin_hello_greet"))
    -- la tool del plugin: ask por defecto, yolo permite, strict deniega
    assert_eq(permission.evaluate("plugin_hello_greet", {"who": "x"}, "ask")["decision"], "ask")
    assert_eq(permission.evaluate("plugin_hello_greet", {"who": "x"}, "yolo")["decision"], "allow")
    assert_eq(permission.evaluate("plugin_hello_greet", {"who": "x"}, "strict")["decision"], "deny")
    -- corre como proceso hijo bajo `synsema run --cap-set …`, args por env
    let out be plugins.call("plugin_hello_greet", {"who": "ana"})
    assert(contains(out, "hello ana via greet"), "salida del plugin: " + out)
    -- un plugin que pide MÁS de lo que su manifiesto autoriza falla contra el techo, no escala
    write_file(ldir + "/plugin.syn", "require file.read(\"workspace/*\")\nprint(read_file(\"workspace/.lampson/plugins/hello/plugin.json\"))\n")
    let denied be plugins.call("plugin_hello_greet", {})
    assert(contains(denied, "ERROR") and contains(lower(denied), "ceiling"), "techo: " + denied)
    -- la tool `plugin` del modelo lista y el registry/catálogo del perfil build los incluye
    assert(contains(call_tool(REG["plugin"], {"action": "list"}), "hello (project, syn, ON)"))
    assert_eq(agents.registry_for("build")["plugin_hello_greet"], "plugin")
    assert(contains(plugins.set_enabled("hello", false), "OFF"))
    assert(not contains(plugins.names(false), "plugin_hello_greet"))
    -- el harness crea el plugin solo (como cordis_define): escribe, valida y chequea, pero NO enciende
    let cr be call_tool(REG["plugin"], {"action": "create", "name": "made-by-agent", "manifest": {"kind": "syn", "entry": "main.syn", "tools": [{"name": "ping", "description": "pong"}]}, "files": {"main.syn": "require env(\"PLUGIN_*\")\nprint(\"pong \" + env(\"PLUGIN_TOOL\", \"\"))\n"}})
    assert(contains(cr, "created") and contains(cr, "synsema check OK") and contains(cr, "OFF"), cr)
    assert_eq(permission.evaluate("plugin", {"action": "create", "name": "made-by-agent"}, "ask")["decision"], "allow")
    assert(not contains(plugins.names(false), "plugin_made-by-agent_ping"))
    assert(contains(plugins.set_enabled("made-by-agent", true), "ON"))
    assert(contains(plugins.call("plugin_made-by-agent_ping", {}), "pong ping"))
    assert(contains(plugins.set_enabled("made-by-agent", false), "OFF"))
    -- código que no compila: creada pero el check falla y lo dice
    let bad be call_tool(REG["plugin"], {"action": "create", "name": "bad-syntax", "manifest": {"entry": "x.syn", "tools": [{"name": "t"}]}, "files": {"x.syn": "let be be be\n"}})
    assert(contains(bad, "FAILED"), bad)
    assert_error(() => call_tool(REG["plugin"], {"action": "create", "name": "bad_name", "manifest": {"tools": []}, "files": {}}))
    -- manifiesto roto: se lista como roto y no se puede encender
    write_file("workspace/.lampson/plugins/broken/plugin.json", "{\"kind\": \"exec\"}")
    let br be where(plugins.summary(), (l) => l["name"] == "broken")
    assert(length(br) == 1 and br[0]["error"] != nothing)
    assert_error(() => plugins.set_enabled("broken", true))

test "lsp: tool de solo lectura (allow en strict), describe_call, worker oculto del selector"
    assert_eq(permission.evaluate("lsp", {"op": "symbols", "path": "a.ts"}, "strict")["decision"], "allow")
    assert_eq(permission.evaluate("lsp", {"op": "add", "server": "typescript"}, "yolo")["decision"], "ask")
    assert_eq(permission.evaluate("lsp", {"op": "add", "server": "typescript"}, "strict")["decision"], "deny")
    assert_eq(permission.describe_call("lsp", {"op": "add", "server": "typescript", "scope": "project"}), "lsp add typescript (project)")
    assert(contains(call_tool(REG["lsp"], {"op": "list"}), "no language servers configured"))
    assert_error(() => call_tool(REG["lsp"], {"op": "add", "server": "nope"}))
    assert_eq(permission.describe_call("lsp", {"op": "definition", "path": "src/a.ts", "line": 2, "character": 12}), "lsp definition src/a.ts:2:12")
    assert(contains(keys(agents.registry_for("plan")), "lsp") and contains(keys(agents.registry_for("explore")), "lsp"))
    assert(not contains(agents.names(), "worker") and contains(agents.names(), "build"))
    assert(length(where(tools.CATALOG, (t) => t["name"] == "lsp")) == 1)

test "spill: el modelo puede releer .lampson/spill/<call>.txt con read y grep (vive en la raíz, no en el workspace)"
    write_file(".lampson/spill/call_test_x.txt", "linea uno\nAGUJA aqui\nlinea tres\n")
    assert(contains(call_tool(REG["read"], {"path": ".lampson/spill/call_test_x.txt", "offset": 2, "limit": 1}), "AGUJA"))
    assert(contains(call_tool(REG["grep"], {"pattern": "AGUJA", "path": ".lampson/spill/call_test_x.txt"}), ":2:"))
    assert_error(() => call_tool(REG["read"], {"path": ".lampson/spill/../config.json"}))

test "plugins exec: el comando corre desde el workspace y un archivo de la carpeta del plugin se resuelve solo"
    let cr be call_tool(REG["plugin"], {"action": "create", "name": "exec-demo", "manifest": {"kind": "exec", "command": "node hi.js", "tools": [{"name": "hi", "description": "hi"}]}, "files": {"hi.js": "console.log('hi ' + process.env.PLUGIN_TOOL + ' cwd=' + require('path').basename(process.cwd()) + ' args=' + process.env.PLUGIN_ARGS)"}})
    assert(contains(cr, "created") and contains(cr, "resolved automatically"), cr)
    plugins.set_enabled("exec-demo", true)
    let out be plugins.call("plugin_exec-demo_hi", {"x": 1})
    assert(contains(out, "hi hi") and contains(out, "args={\"x\": 1}"), out)
    plugins.set_enabled("exec-demo", false)
    -- eliminar: solo plugins del proyecto; borra la carpeta y la saca del estado
    assert(contains(plugins.remove("exec-demo"), "deleted"))
    assert_eq(length(where(plugins.summary(), (l) => l["name"] == "exec-demo")), 0)
    assert_error(() => plugins.remove("example-hello"))
    assert_error(() => plugins.remove("exec-demo"))

test "plugins compat: una carpeta vieja .lampson/lamps/<n>/lamp.json se descubre (legacy), se enciende y recibe LAMP_*"
    let old be "workspace/.lampson/lamps/oldie"
    write_file(old + "/lamp.json", json_encode({"name": "oldie", "kind": "syn", "entry": "lamp.syn", "timeout": 20, "tools": [{"name": "echo", "description": "echo"}]}))
    write_file(old + "/lamp.syn", "require env(\"LAMP_*\")\nprint(\"old \" + env(\"LAMP_TOOL\", \"\") + \" \" + env(\"LAMP_ARGS\", \"\"))\n")
    let found be where(plugins.summary(), (l) => l["name"] == "oldie")
    assert(length(found) == 1 and found[0]["legacy"] == true and found[0]["scope"] == "project", json_encode(found))
    let on be plugins.set_enabled("oldie", true)
    assert(contains(on, "ON") and contains(on, "rename"), on)
    assert(contains(plugins.call("plugin_oldie_echo", {"k": 1}), "old echo {\"k\": 1}"))
    -- la carpeta nueva con el mismo nombre pisa a la vieja, y deja de ser legacy
    write_file("workspace/.lampson/plugins/oldie/plugin.json", json_encode({"name": "oldie", "kind": "syn", "entry": "plugin.syn", "tools": [{"name": "echo", "description": "echo"}]}))
    write_file("workspace/.lampson/plugins/oldie/plugin.syn", "require env(\"PLUGIN_*\")\nprint(\"new \" + env(\"PLUGIN_TOOL\", \"\"))\n")
    assert(contains(plugins.call("plugin_oldie_echo", {}), "new echo"))
    let again be where(plugins.summary(), (l) => l["name"] == "oldie")
    assert(not again[0]["legacy"])
    plugins.set_enabled("oldie", false)
    assert(contains(plugins.remove("oldie"), "deleted"))
    -- una tarea programada guardada con el tipo viejo "lamp" sigue describiéndose y validándose
    assert_eq(schedule.describe_action({"type": "lamp", "lamp": "oldie", "tool": "echo", "args": {}}), "plugin oldie.echo")

test "env_info: la UI (web|terminal) llega al prompt para que el modelo no diga /plugins en la web"
    share {"kind": "web"} as "lampson:ui"
    let p be prompt.build(agents.env_info(provider.config()), "")
    assert(contains(p, "from the web UI") and contains(p, "Never tell a web user to type a slash command"))

test "md: markdown → terminal (plano sin escapes; con color solo cambia por SGR)"
    let doc be "# T\n\nHola **neg** *it* `cod` [l](http://u) 2*3\n- a\n1. b\n> q\n```js\n**raw**\n```\n| a | bb |\n|---|---|\n| **1** | 2 |"
    let plain be md.render(doc, false)
    assert(contains(plain, "T\n  ═") and contains(plain, "Hola neg it cod l http://u 2*3"), plain)
    assert(contains(plain, "• a") and contains(plain, "1. b") and contains(plain, "▎ q"), plain)
    assert(contains(plain, "│ **raw**") and contains(plain, "┌── js"), plain)
    assert(contains(plain, "1 │ 2") and contains(plain, "a │ bb"), plain)
    let esc be decode(bytes("1b", "hex"))
    assert(not contains(plain, esc))
    let col be md.render(doc, true)
    assert(contains(col, esc + "[1mneg" + esc + "[0m") and contains(col, esc + "[36mcod" + esc + "[0m"), col)
    assert_eq(strip_ansi(col), plain)
    -- tabla más ancha que la terminal: se achican columnas y se envuelven celdas; ninguna línea se pasa
    ui.set_cols(60)
    let wide be md.render("| Ruta | Qué hace |\n|---|---|\n| `/api/reservar` | Recibe FormData, llama crearReserva(), redirige 303 a /?reservado=1&token=… o /?error=… |", false)
    each l in split(wide, "\n")
        assert(ui.width(l) <= 60, l)
    assert(length(split(wide, "\n")) >= 4, wide)
    ui.set_cols(100)

test "diff: líneas cambiadas con contexto y números; archivo nuevo = todo +; edit/write publican antes/después"
    let d be diff.diff("a\nb\nc\nd\ne\nf\ng\nh\ni\nj\nk", "a\nb\nC\nd\ne\nf\ng\nh\nX\ni\nj\nk", 2, false)
    assert_eq(d["added"], 2)
    assert_eq(d["removed"], 1)
    -- las filas +/- van rellenadas hasta el ancho (fondo de color): comparar sin espacios finales
    let s be join(apply((l) => replace_re(l, "\s+$", ""), d["lines"]), "\n")
    assert(contains(s, " 3 │ - c\n 3 │ + C") and contains(s, " 9 │ + X") and contains(s, "⋯"), s)
    assert(not contains(s, "│   f"), s)
    let n be diff.diff("", "uno\ndos", 2, false)
    assert_eq(n["removed"], 0)
    assert_eq(join(apply((l) => replace_re(l, "\s+$", ""), n["lines"]), "\n"), "1 │ + uno\n2 │ + dos")
    -- edit → blackboard "lampson:ui:diff" con old/new (la UI lo convierte en diff; el modelo no lo ve)
    call_tool(REG["write"], {"path": "diff_t.txt", "content": "x\ny\n"})
    observe "lampson:ui:diff" as w
    assert_eq(w["old"], "")
    assert_eq(w["new"], "x\ny\n")
    call_tool(REG["read"], {"path": "diff_t.txt"})
    let r be call_tool(REG["edit"], {"path": "diff_t.txt", "old_string": "y", "new_string": "z"})
    assert(contains(r, "1 replacement"), r)
    observe "lampson:ui:diff" as e
    assert_eq(e["path"], "diff_t.txt")
    assert_eq(e["old"], "x\ny\n")
    assert_eq(e["new"], "x\nz\n")
    assert_eq(diff.diff(e["old"], e["new"], 1, false)["removed"], 1)

test "diff: corridas largas de +/- se colapsan a 4 + '⋮ ±N líneas más' + 2 (rewrite de 200 líneas)"
    -- 200 líneas viejas → 200 nuevas, todo distinto: cae en el camino bloque quitado + bloque agregado
    let olds be []
    let news be []
    let i be 0
    while i < 200
        set olds to append(olds, "vieja " + text(i))
        set news to append(news, "nueva " + text(i))
        set i to i + 1
    let big be diff.diff(join(olds, "\n"), join(news, "\n"), 2, false)
    assert_eq(big["added"], 200)
    assert_eq(big["removed"], 200)
    -- 4 + marcador + 2 por corrida, dos corridas (− y +) = 14 filas en vez de 400
    assert_eq(length(big["lines"]), 14)
    let bs be join(apply((l) => replace_re(l, "\s+$", ""), big["lines"]), "\n")
    assert(contains(bs, "⋮ −194 líneas más") and contains(bs, "⋮ +194 líneas más"), bs)
    assert(contains(bs, "- vieja 0") and contains(bs, "- vieja 199"), bs)
    assert(contains(bs, "+ nueva 0") and contains(bs, "+ nueva 199"), bs)
    -- una corrida de exactamente 7 NO se colapsa (el marcador no ahorraría nada)
    let seven be diff.diff("q", join(["q", "1", "2", "3", "4", "5", "6", "7"], "\n"), 2, false)
    assert_eq(seven["added"], 7)
    assert(not contains(join(seven["lines"], "\n"), "⋮"), join(seven["lines"], "\n"))

-- ---------- tareas programadas (lib/schedule.syn) ----------
use "./lib/schedule.syn" as schedule

test "schedule: parseo de horarios (intervalo, diario, semanal, español) y descripción"
    let e be schedule.parse_when("every 6h")
    assert(e["ok"], json_encode(e))
    assert_eq(e["plan"]["seconds"], 21600)
    assert_eq(schedule.describe_plan(e["plan"]), "cada 6 h")
    assert_eq(schedule.parse_when("cada 30 min")["plan"]["seconds"], 1800)
    assert_eq(schedule.parse_when("every 2d")["plan"]["seconds"], 172800)
    let d be schedule.parse_when("daily 09:30")
    assert_eq(d["plan"]["kind"], "daily")
    assert_eq(d["plan"]["hh"], 9)
    assert_eq(d["plan"]["mm"], 30)
    assert_eq(schedule.parse_when("todos los días a las 7")["plan"]["hh"], 7)
    assert_eq(schedule.parse_when("18:45")["plan"]["kind"], "daily")
    let w be schedule.parse_when("lun,mie,vie 08:30")
    assert_eq(w["plan"]["kind"], "weekly")
    assert_eq(w["plan"]["days"], [1, 3, 5])
    assert_eq(schedule.describe_plan(w["plan"]), "lunes, miércoles, viernes a las 08:30")
    assert_eq(schedule.parse_when("weekdays 9:00")["plan"]["days"], [1, 2, 3, 4, 5])
    assert_eq(schedule.parse_when("weekend")["plan"]["days"], [6, 7])
    assert(not schedule.parse_when("every 10s")["ok"], "min 60 s")
    assert(not schedule.parse_when("cuando quieras")["ok"], "texto libre")
    assert(not schedule.parse_when("daily 25:00")["ok"], "hora inválida")
    -- una sola vez
    let o1 be schedule.parse_when("hoy 15:14")["plan"]
    assert_eq(o1["kind"], "once")
    assert_eq(o1["rel"], "today")
    assert_eq(schedule.parse_when("tomorrow 9:00")["plan"]["rel"], "tomorrow")
    assert_eq(schedule.parse_when("once 2026-08-29 15:14")["plan"]["date"], "2026-08-29")
    assert_eq(schedule.parse_when("2026-08-29 15:14")["plan"]["hh"], 15)
    assert_eq(schedule.parse_when("in 2h")["plan"]["delay"], 7200)
    assert_eq(schedule.describe_plan(o1), "una vez, hoy a las 15:14")
    assert(not schedule.parse_when("hoy")["ok"], "hoy sin hora")
    assert_eq(schedule.parse_offset("-0300"), -10800)
    assert_eq(schedule.parse_offset("+02:00"), 7200)
    assert_eq(schedule.parse_offset("-3"), -10800)

test "schedule: próxima corrida en hora local (diario, semanal, intervalo desde el fin de la anterior)"
    -- 2026-08-29 fue sábado. Zona -03:00: las 12:00 UTC son las 09:00 locales
    let off be -10800
    let sat_noon_utc be parse_time("2026-08-29 12:00", "%Y-%m-%d %H:%M")
    let daily be schedule.parse_when("daily 09:00")["plan"]
    -- a las 08:00 locales (11:00 UTC) la próxima es hoy a las 09:00 locales = 12:00 UTC
    assert_eq(schedule.next_run(daily, sat_noon_utc - 3600, nothing, off), sat_noon_utc)
    -- justo a las 09:00 locales ya pasó → mañana
    assert_eq(schedule.next_run(daily, sat_noon_utc, nothing, off), sat_noon_utc + 86400)
    let weekly be schedule.parse_when("mon 09:00")["plan"]
    -- desde el sábado 08:00 local, el próximo lunes 09:00 local = 2 días después del sábado 12:00 UTC
    assert_eq(schedule.next_run(weekly, sat_noon_utc - 3600, nothing, off), sat_noon_utc + 2 * 86400)
    let sat be schedule.parse_when("sab 08:00")["plan"]
    -- sábado 08:00 local desde el sábado 08:00 local exacto → la semana que viene
    assert_eq(schedule.next_run(sat, sat_noon_utc - 3600, nothing, off), sat_noon_utc - 3600 + 7 * 86400)
    -- una sola vez: fecha puntual en hora local; tras correr no hay próxima
    let once be schedule.parse_when("once 2026-08-29 09:00")["plan"]
    assert_eq(schedule.next_run(once, sat_noon_utc - 7200, nothing, off), sat_noon_utc)
    assert_eq(schedule.next_run(once, sat_noon_utc, sat_noon_utc, off), nothing)
    let today be schedule.parse_when("today 09:00")["plan"]
    assert_eq(schedule.next_run(today, sat_noon_utc - 7200, nothing, off), sat_noon_utc)
    assert_eq(schedule.next_run(schedule.parse_when("in 2h")["plan"], 1000, nothing, off), 8200)
    let every be schedule.parse_when("every 2h")["plan"]
    assert_eq(schedule.next_run(every, 1000, 5000, off), 5000 + 7200)
    assert_eq(schedule.next_run(every, 1000, nothing, off), 1000 + 7200)

test "schedule: alta, validación, corrida bash con historial y borrado (.lampson/schedules.json)"
    -- limpiar tareas de tests anteriores
    each t in schedule.all()
        when starts_with(t["id"], "test-")
            schedule.remove(t["id"])
    let t be schedule.add({"name": "test sched", "when": "every 1h", "action": {"type": "bash", "command": "echo hola-cron"}, "permission": "strict"})
    assert(starts_with(t["id"], "test-sched-"), t["id"])
    -- por workspace: la tarea lleva el slug del proyecto y no se ve desde otro
    assert_eq(t["project"], memo.slug())
    assert(schedule.mount_ok(), "la junction apunta al workspace de los tests")
    assert_eq(t["enabled"], true)
    assert(t["next_run"] > now() + 3500, "próxima en ~1 h")
    -- validaciones
    let bad1 be ""
    try
        schedule.add({"when": "daily 09:00", "action": {"type": "bash", "command": "rm -rf / "}})
    recover err
        set bad1 to text(err)
    assert(contains(bad1, "refused"), bad1)
    let bad2 be ""
    try
        schedule.add({"when": "daily 09:00", "action": {"type": "plugin", "plugin": "nope", "tool": "x"}})
    recover err
        set bad2 to text(err)
    assert(contains(bad2, "not available"), bad2)
    let bad3 be ""
    try
        schedule.add({"when": "daily 09:00", "action": {"type": "bash", "command": "npm run dev"}})
    recover err
        set bad3 to text(err)
    assert(contains(bad3, "server"), bad3)
    -- corrida: marca, salida, registro, próxima recalculada
    schedule.mark_started(t)
    assert_eq(schedule.get(t["id"])["running"], true)
    let out be schedule.run_simple(t)
    assert(contains(out, "hola-cron"), out)
    let done be schedule.record(t, now() - 1, "ok", out, {"steps": 0})
    assert_eq(done["running"], false)
    assert_eq(done["last_status"], "ok")
    assert_eq(length(done["history"]), 1)
    assert_eq(done["history"][0]["steps"], 0)
    assert(contains(schedule.log_tail(t["id"], 20), "hola-cron"), "log en disco")
    assert_eq(length(schedule.due(now())), 0)
    -- run_now la hace vencer
    schedule.request_run(t["id"])
    assert_eq(length(where(schedule.due(now()), (x) => x["id"] == t["id"])), 1)
    assert(contains(schedule.set_enabled(t["id"], false), "OFF"), "apagar")
    assert_eq(length(schedule.due(now())), 0)
    assert(contains(schedule.remove(t["id"]), "removed"), "borrar")
    assert_eq(schedule.get(t["id"]), nothing)
    -- una sola vez: corre y se apaga sola; una hora ya pasada se rechaza
    let o be schedule.add({"name": "test once", "when": "in 1h", "action": {"type": "bash", "command": "echo una-vez"}})
    schedule.mark_started(o)
    let od be schedule.record(o, now() - 1, "ok", "una-vez", {})
    assert_eq(od["enabled"], false)
    assert_eq(od["next_run"], nothing)
    schedule.remove(o["id"])
    let past be ""
    try
        schedule.add({"name": "test past", "when": "once 2020-01-01 09:00", "action": {"type": "bash", "command": "echo x"}})
    recover err
        set past to text(err)
    assert(contains(past, "passed"), past)

test "schedule: la tool pide humano al programar (incluso en yolo) y describe la tarea en el preview"
    let v be permission.evaluate("schedule", {"action": "add", "kind": "bash", "at": "daily 09:00", "command": "npm test"}, "yolo")
    assert_eq(v["decision"], "ask")
    assert_eq(permission.evaluate("schedule", {"action": "list"}, "strict")["decision"], "allow")
    assert_eq(permission.evaluate("schedule", {"action": "remove", "id": "x-1"}, "strict")["decision"], "deny")
    let d be permission.describe_call("schedule", {"action": "add", "name": "tests", "at": "daily 09:00", "kind": "prompt", "prompt": "run the tests and report", "agent": "review", "permission": "strict"})
    assert(contains(d, "«tests»") and contains(d, "daily 09:00") and contains(d, "agent review") and contains(d, "permission strict"), d)
    assert(contains(keys(REG), "schedule"), "registrada")
    assert(contains(agents.PROFILES["build"]["tools"], "schedule"), "build la ve")
    assert(not contains(agents.PROFILES["worker"]["tools"], "schedule"), "worker no")

-- ---------- workspaces (lib/workspaces.syn) ----------
use "./lib/workspaces.syn" as wsp

test "workspaces: el slug coincide con memo.slug para la misma ruta y normaliza separadores/mayúsculas"
    let p be "C:\Users\Alguien\Desktop\Mi Proyecto"
    assert_eq(wsp.norm(p), "c:/users/alguien/desktop/mi proyecto")
    assert_eq(wsp.norm("/c/Users/x/proj/"), "c:/users/x/proj")
    assert_eq(wsp.slug_of(p), wsp.slug_of("c:/users/alguien/desktop/mi proyecto/"))
    assert(starts_with(wsp.slug_of(p), "mi-proyecto-"), wsp.slug_of(p))
    assert_eq(length(wsp.slug_of(p)), length("mi-proyecto-") + 8)

test "workspaces: ensure_link crea el destino si falta y rehace un link colgante (el memory/ de un install npm)"
    let base be "workspace/_lampson_test/links"
    write_file(base + "/.keep", "")
    let abs be env("LAMPSON_WORKSPACE", "") + "/_lampson_test/links/target"
    let where_ be base + "/memory"
    assert(not file_exists(base + "/target"))
    wsp.ensure_link(where_, abs)
    assert(file_exists(where_) and file_exists(base + "/target"), "link creado y destino creado antes")
    -- se escribe a través del link, como hace memory(write)
    write_file(where_ + "/proj/nota.md", "hola")
    assert_eq(read_file(base + "/target/proj/nota.md"), "hola")
    -- destino borrado → link colgante (file_exists = false, como en el VPS) → se rehace y el destino vuelve
    let sh be env("LAMPSON_SHELL", when env("OS", "") == "Windows_NT" then "C:\\Program Files\\Git\\bin\\bash.exe" otherwise "bash")
    run(sh, ["-c", "rm -rf '" + base + "/target'"], 30, {"cwd": "."})
    assert(not file_exists(where_), "colgante")
    wsp.ensure_link(where_, abs)
    assert(file_exists(where_) and file_exists(base + "/target"), "link rehecho")
    write_file(where_ + "/proj/otra.md", "de nuevo")
    assert_eq(read_file(base + "/target/proj/otra.md"), "de nuevo")

-- ---------- fs (explorador web): crear, renombrar, mover, copiar, borrar ----------
test "fs: mkdir/create/rename/move/copy/delete dentro del workspace, sin pisar nada"
    let D be T + "/fsx"
    assert_eq(fs.mkdir(T, "fsx")["path"], D)
    assert_eq(fs.create(D, "a.txt", "hola")["path"], D + "/a.txt")
    assert_eq(read_file("workspace/" + D + "/a.txt"), "hola")
    assert_error(() => fs.create(D, "a.txt", "otra"))
    assert_error(() => fs.create(D, "x/y.txt", ""))
    assert_error(() => fs.create(D, "..", ""))
    assert_error(() => fs.mkdir(D, "con:dos"))
    assert_eq(fs.rename(D + "/a.txt", "b.txt")["path"], D + "/b.txt")
    assert(not file_exists("workspace/" + D + "/a.txt") and file_exists("workspace/" + D + "/b.txt"), "renombrado")
    assert_eq(fs.rename(D + "/b.txt", "B.txt")["path"], D + "/B.txt")
    assert(file_exists("workspace/" + D + "/B.txt"), "solo mayúsculas (FS case-insensitive)")
    assert_eq(fs.mkdir(D, "sub")["path"], D + "/sub")
    assert_error(() => fs.rename(D + "/B.txt", "sub"))
    assert_eq(fs.move(D + "/B.txt", D + "/sub")["path"], D + "/sub/B.txt")
    assert(file_exists("workspace/" + D + "/sub/B.txt"), "movido")
    assert_error(() => fs.move(D + "/sub", D + "/sub"))
    assert_error(() => fs.move(D + "/sub/B.txt", D + "/nope"))
    assert_eq(fs.copy(D + "/sub/B.txt", nothing)["path"], D + "/sub/B copy.txt")
    assert_eq(fs.copy(D + "/sub/B.txt", nothing)["path"], D + "/sub/B copy 2.txt")
    assert_eq(fs.copy(D + "/sub", nothing)["path"], D + "/sub copy")
    assert(file_exists("workspace/" + D + "/sub copy/B.txt"), "carpeta copiada con contenido")
    assert_eq(fs.copy(D + "/sub/B.txt", D)["path"], D + "/B.txt")
    assert_eq(fs.copy(D + "/sub/B.txt", D)["path"], D + "/B copy.txt")
    assert_error(() => fs.copy(D + "/sub", D + "/sub"))
    assert_eq(fs.remove(D + "/sub copy")["path"], D + "/sub copy")
    assert(not file_exists("workspace/" + D + "/sub copy"), "borrado")
    assert_error(() => fs.remove("."))
    assert_error(() => fs.rename(".", "x"))
    assert_error(() => fs.remove("../fuera"))
    assert_error(() => fs.remove(D + "/no-existe"))
    assert_error(() => fs.apply({"op": "zap", "path": D}))
    assert_eq(fs.apply({"op": "delete", "path": D})["path"], D)
    assert(not file_exists("workspace/" + D), "limpio")
