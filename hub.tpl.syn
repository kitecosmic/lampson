-- hub.tpl.syn — PLANTILLA del hub. lib/workspaces.syn genera hub.syn (gitignored) reemplazando `-- @workspaces` por una
-- ruta proxy por workspace; el hub corre con `synsema daemon start hub.syn --watch` y se reinicia solo al cambiar.
--
-- El hub es lo único que escucha hacia afuera (:8080; en un VPS, con --domain/--tls-auto):
--   GET  /                    pantalla de workspaces (public/hub.html)
--   GET  /w/<slug>            la UI de ese workspace (public/index.html; los assets /css /js los sirve el hub)
--   *    /w/<slug>/api/…      proxy al proceso del workspace (127.0.0.1:808N) — SSE y WebSocket pasan (Synsema ≥ 0.6.12)
--   GET  /w/<slug>/approve/…  links de aprobación de ese workspace
--   /api/workspaces…          registro, crear (diálogo nativo o explorador), start/stop/quitar, política
-- Supervisor: cada 15 s arranca los workspaces que deben vivir y apaga los inactivos (política en ⚙ → idle_hours).
-- Acceso: esta PC entra sin nada; lo remoto — túnel, LAN, VPS — necesita la sesión de un dispositivo emparejado con
-- passkey (lib/auth.syn), o LAMPSON_WEB_TOKEN para scripts. Qué es «esta PC» y qué origin vale: lib/origin.syn. Las
-- rutas proxy al API de cada workspace también piden auth: el proceso del workspace confía en lo que le llega del hub.

intent: "Lampson hub: workspaces registry, supervisor and reverse proxy to one process per workspace"

require serve(8080)
require net("127.0.0.1")
require time
require exec
require env("LAMPSON_*")
require env("OS")
require env("HOME")
require env("USERPROFILE")
require file(".lampson")
require file(".lampson/*")
require file.read("web.syn")
require file.read(".env")
require file.read("chat.syn")
require file.read("hub.tpl.syn")
require file("hub.syn")
require file.read("public")
require file.read("public/*")
require random

use "./lib/workspaces.syn" as ws
use "./lib/settings.syn" as settings
use "./lib/auth.syn" as auth
use "./lib/origin.syn" as origin

-- local → {local:true}; remoto con sesión de un dispositivo → {local:false, device}; con LAMPSON_WEB_TOKEN → script
task check_client(token, request)
    let h be headers of request
    -- un navegador en otra origin (CSRF, WebSocket abierto desde otra página, DNS rebinding) no pasa, local o remoto
    when origin.cross_site(h)
        give nothing
    when origin.is_local(text(ip of request), h)
        give {"local": true}
    let want be env("LAMPSON_WEB_TOKEN", "")
    when want != "" and token == want
        give {"local": false, "device": nothing}
    let s be auth.session_for(get(request.cookies, auth.COOKIE, nothing))
    when s == nothing
        give nothing
    give {"local": false, "device": s["device"]}

-- las páginas (no el API): un remoto sin sesión va a /login
task page_allowed(request)
    give check_client(nothing, request) != nothing

task with_session(resp, request, sid)
    give set_cookie(resp, auth.COOKIE, sid, {"max_age": auth.SESSION_MAX_DAYS * 86400, "secure": auth.secure_cookie(headers of request), "same_site": "Lax"})

task hub_tick()
    give ws.tick()
cron_every(15, hub_tick)

serve on 8080
    -- @bind
    -- túneles (syn tunnel, cloudflared) y el edge de --domain llegan por loopback: así sus X-Forwarded-* llegan y
    -- ip of request es el cliente real (lib/origin.syn)
    trust proxy ["127.0.0.1", "::1"]
    max_streams 200
    auth with check_client
    static "./public"

    route "GET /"
        when not page_allowed(request)
            give redirect("/login", 302)
        give html(read_file("public/hub.html"))

    -- ---- acceso remoto: páginas públicas de login/emparejar y su API ----
    route "GET /login"
        give html(read_file("public/login.html"))
    route "GET /pair"
        give html(read_file("public/login.html"))

    -- ¿quién soy? (la UI decide si muestra «Dispositivos» o «cerrar sesión»)
    route "GET /api/auth/me"
        let u be check_client(nothing, request)
        give {"authenticated": u != nothing, "local": u != nothing and u["local"], "device": when u == nothing then nothing otherwise get(u, "device", nothing), "has_devices": length(auth.devices()) > 0}

    -- código de emparejamiento para el QR: SOLO desde esta PC
    route "POST /api/auth/pair" requires auth
        when not request.user["local"]
            give fail(403, "el emparejamiento se inicia desde la PC donde corre lampson")
        let p be auth.new_pairing()
        give {"code": p["code"], "expires_in": p["expires_in"], "public_url": auth.public_url()}

    route "GET /api/auth/public-url" requires auth
        give {"public_url": auth.public_url()}
    route "POST /api/auth/public-url" requires auth
        when not request.user["local"]
            give fail(403, "solo desde la PC")
        expect body {url: text}
        try
            give {"public_url": auth.set_public_url(text((json of request)["url"]))}
        recover err
            give fail(400, text(err))

    route "POST /api/auth/register/options"
        rate_limit 20 per minute
        expect body {code: text, name: text}
        let b be json of request
        when not auth.pairing_valid(text(b["code"]))
            give fail(400, "el código de emparejamiento venció o ya se usó — generá otro desde la PC")
        give auth.register_options(headers of request, text(b["name"]))

    route "POST /api/auth/register"
        rate_limit 20 per minute
        let b be json of request
        try
            let r be auth.register(headers of request, get(b, "code", nothing), get(b, "challenge_id", nothing), get(b, "name", ""), get(b, "credential", {}))
            give with_session(ok({"ok": true, "device": r["device"]}), request, r["sid"])
        recover err
            give fail(400, text(err))

    route "POST /api/auth/login/options"
        rate_limit 30 per minute
        give auth.login_options(headers of request)

    route "POST /api/auth/login"
        rate_limit 30 per minute
        let b be json of request
        let r be nothing
        try
            set r to auth.login(headers of request, get(b, "challenge_id", nothing), get(b, "credential", {}))
        recover err
            give fail(400, text(err))
        when r == nothing
            give fail(401, "la passkey no coincide con un dispositivo emparejado de este dominio")
        give with_session(ok({"ok": true, "device": r["device"]}), request, r["sid"])

    route "POST /api/auth/logout"
        when origin.cross_site(headers of request)
            give fail(403, "otra origin")
        let sid be get(request.cookies, auth.COOKIE, nothing)
        when sid != nothing
            auth.drop_session(sid)
        give clear_cookie(ok({"ok": true}), auth.COOKIE)

    route "GET /api/auth/devices" requires auth
        give {"devices": auth.public_devices(get(request.user, "device", nothing)), "local": request.user["local"], "public_url": auth.public_url()}

    route "POST /api/auth/devices/remove" requires auth
        expect body {id: text}
        give {"ok": auth.remove_device(text((json of request)["id"]))}

    route "POST /api/auth/devices/rename" requires auth
        expect body {id: text, name: text}
        let b be json of request
        give {"ok": auth.rename_device(text(b["id"]), text(b["name"]))}

    -- la UI de un workspace: el mismo index.html; el frontend deduce /w/<slug> de la URL (BASE en js/core.js).
    -- Sin barra final: el runtime normaliza "/w/x/" → "/w/x" (301), así que la ruta canónica es esta
    route "GET /w/:slug"
        when not page_allowed(request)
            give redirect("/login", 302)
        -- entrar a un workspace apagado lo enciende (y levanta la pausa manual): si alguien abre la URL es para usarlo
        let w be ws.get(params.slug)
        when w != nothing and ws.health(w) == nothing
            ws.start_ws(w)
            ws.wait_ready(w, 8)
            ws.summary()
        give html(read_file("public/index.html"))

    route "GET /api/hub" requires auth
        give {"ok": true, "port": ws.HUB_PORT, "idle_hours": ws.idle_hours(), "home": ws.home(), "local": request.user["local"]}

    -- ⚙ → Apagar o reiniciar: Lampson entero (hub, workspaces, edge). Lo hace cli.syn desacoplado, porque este proceso
    -- muere en el medio. Apagar, solo desde esta PC: desde el celular no habría cómo volver a encenderlo
    route "POST /api/hub/shutdown" requires auth
        when not request.user["local"]
            give fail(403, "apagar Lampson solo desde la PC donde corre: desde acá no podrías volver a encenderlo")
        ws.cli_later("hub-stop")
        give {"ok": true}

    route "POST /api/hub/restart" requires auth
        ws.cli_later("hub-reboot")
        give {"ok": true}

    route "GET /api/workspaces" requires auth
        -- la caché del blackboard (tick + acciones) salvo ?fresh=1: la UI lo pide tras encender/apagar
        let fresh be contains(query, "fresh")
        give {"workspaces": when fresh then ws.summary() otherwise ws.summary_cached(20), "idle_hours": ws.idle_hours()}

    -- registrar una carpeta como workspace (y arrancarla)
    route "POST /api/workspaces" requires auth
        expect body {path: text}
        let b be json of request
        try
            let w be ws.ensure(text(b["path"]))
            ws.start_ws(w)
            ws.wait_ready(w, 8)
            ws.summary()
            give {"ok": true, "workspace": w, "url": "/w/" + w["slug"] + "/"}
        recover err
            give fail(400, text(err))

    route "POST /api/workspaces/start" requires auth
        expect body {slug: text}
        let b be json of request
        let w be ws.get(text(b["slug"]))
        when w == nothing
            give not_found("no such workspace")
        ws.start_ws(w)
        let ok be ws.wait_ready(w, 8)
        ws.summary()
        give {"ok": ok}

    route "POST /api/workspaces/stop" requires auth
        expect body {slug: text}
        let b be json of request
        let w be ws.get(text(b["slug"]))
        when w == nothing
            give not_found("no such workspace")
        give {"ok": ws.pause_ws(w)}

    route "POST /api/workspaces/remove" requires auth
        expect body {slug: text}
        let b be json of request
        try
            let res be ws.remove(text(b["slug"]))
            ws.summary()
            give {"ok": true, "result": res}
        recover err
            give fail(400, text(err))

    -- política por workspace: auto | always | off
    route "POST /api/workspaces/policy" requires auth
        expect body {slug: text, policy: text}
        let b be json of request
        let w be ws.get(text(b["slug"]))
        when w == nothing
            give not_found("no such workspace")
        when not contains(["auto", "always", "off"], text(b["policy"]))
            give fail(400, "policy must be auto | always | off")
        set w["policy"] to text(b["policy"])
        ws.put(w)
        ws.summary()
        give {"ok": true}

    -- diálogo nativo del SO (PC); nothing → la UI usa el explorador propio
    route "POST /api/workspaces/pick" requires auth
        let p be ws.pick_folder()
        give {"path": p, "native": p != nothing}

    route "GET /api/workspaces/browse" requires auth
        give ws.browse(when contains(query, "path") then text(query.path) otherwise "")

    -- proxies generados (una por workspace registrado):
    -- @workspaces
